{
  "name": "saarthi",
  "version": "0.1.0",
  "private": true,
  "description": "Saarthi — fleet management, logistics marketplace, driver safety and AI intelligence platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @saarthi/api",
    "dev:web": "npm run dev -w @saarthi/web",
    "build": "npm run build -w @saarthi/shared && npm run build -w @saarthi/api && npm run build -w @saarthi/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @saarthi/api",
    "db:migrate": "npm run db:migrate -w @saarthi/api",
    "db:deploy": "npm run db:deploy -w @saarthi/api",
    "db:seed": "npm run db:seed -w @saarthi/api",
    "db:reset": "npm run db:reset -w @saarthi/api",
    "db:studio": "npm run db:studio -w @saarthi/api",
    "setup": "npm install && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
