# ---------------------------------------------------------------------------
# Saarthi — environment configuration
# Copy to `.env` and adjust for your machine. NEVER commit a populated `.env`.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- API server --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------------
# Local native PostgreSQL (default) — matches `docker compose` service too.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/saarthi?schema=public

# --- Security ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters-long
COOKIE_SECURE=false
COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# --- Providers (mock today, real tomorrow) -----------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/documents
STORAGE_MAX_FILE_SIZE=10485760

GPS_PROVIDER=mock
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=local
VERIFICATION_PROVIDER=manual

AI_PROVIDER=development
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_BASE_URL=

# --- Cache / queue / pubsub --------------------------------------------------
# `memory` keeps everything in-process (no Redis needed). `redis` uses REDIS_URL.
CACHE_DRIVER=memory
QUEUE_DRIVER=memory
PUBSUB_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379

# --- Maps (MapLibre GL JS · open data) ----------------------------------------
# The basemap needs NO key, NO account and NO payment method:
#   - vector tiles + styles: OpenFreeMap (commercial use allowed, no limits)
#   - elevation: AWS Open Data terrain tiles
#   - 3D buildings: OpenStreetMap footprints via OpenMapTiles
#
# Turn-by-turn routing and place search use OpenRouteService, which needs a
# free API key — email signup only, no card:
#   https://account.heigit.org/signup
# Free plan: ~2,000 routing requests/day. Without a key the map still renders
# fully; only navigation and search are unavailable.
MAP_PROVIDER=openfreemap
ORS_API_KEY=
# Optional: point at a self-hosted OpenFreeMap instance or your own style JSON.
MAP_STYLE_URL=

# --- Vehicle registration (RC) lookup — Way2API -------------------------------
# https://app.way2api.com/documentation/vehicle-rc-text-pdf
# Server-side only. Leave WAY2API_API_KEY empty to disable the feature entirely;
# Saarthi never substitutes placeholder RC data for a missing key.
WAY2API_BASE_URL=https://app.way2api.com
WAY2API_API_KEY=
WAY2API_TIMEOUT_MS=20000
# Largest RC PDF Saarthi will download and store (bytes).
VEHICLE_RC_PDF_MAX_BYTES=8388608
# Seconds a stored RC record may be reused before a fresh (billable) lookup.
# Doubles as the retention window: expired records and their PDFs are deleted.
VEHICLE_CACHE_TTL=86400
# Hard ceiling on billable provider calls from this environment. 0 = no cap.
# Set this to your remaining trial allowance during development so a mistake
# cannot spend credits. Cache hits do not count toward it.
VEHICLE_LOOKUP_BUDGET=0
# Per-user lookup rate limit, on top of the global API limit.
VEHICLE_LOOKUP_RATE_LIMIT_MAX=10
VEHICLE_LOOKUP_RATE_LIMIT_WINDOW=1 minute

# --- Petrol stations — SSR Innovation Lab -------------------------------------
# https://api.ssrinnovationlab.com/api/test/18/
# The directory currently serves unauthenticated reads; set a key only if you
# have subscribed to one. No key is invented when the service needs none.
SSR_PETROL_API_BASE_URL=https://api.ssrinnovationlab.com
SSR_PETROL_API_KEY=
SSR_PETROL_TIMEOUT_MS=12000
# Seconds a station search is reused before the directory is queried again.
PETROL_STATION_CACHE_TTL=21600

# --- Demo / simulation -------------------------------------------------------
# MUST be false in production.
DEMO_MODE=true
SIMULATOR_TICK_MS=1000

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_MAP_PROVIDER=openfreemap
# OpenRouteService key — enables turn-by-turn navigation and place search.
VITE_ORS_API_KEY=
# ORS host. HeiGIT is moving from api.openrouteservice.org to api.heigit.org;
# set this to https://api.openrouteservice.org if an endpoint 404s on the new host.
VITE_ORS_BASE_URL=https://api.heigit.org
# Default basemap: liberty | bright | positron | dark | fiord
VITE_MAP_STYLE_ID=liberty
VITE_MAP_STYLE_URL=
# Elevation tiles. Defaults to the AWS Open Data terrain tiles (open licence,
# no key). If terrain/hillshade never appears, check DevTools > Network for
# failing elevation-tile requests and try the alternative MapLibre documents:
#   VITE_TERRAIN_TILES_URL=https://tiles.mapterhorn.com/{z}/{x}/{y}.png
# VITE_TERRAIN_ENCODING is `terrarium` or `mapbox`.
VITE_TERRAIN_TILES_URL=
VITE_TERRAIN_ENCODING=terrarium
VITE_DEMO_MODE=true
