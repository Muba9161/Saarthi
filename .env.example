# ---------------------------------------------------------------------------
# Saarthi — environment configuration
# Copy to `.env` and adjust for your machine. NEVER commit a populated `.env`.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- API server --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------------
# Local native PostgreSQL (default) — matches `docker compose` service too.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/saarthi?schema=public

# --- Security ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters-long
COOKIE_SECURE=false
COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# --- Providers (mock today, real tomorrow) -----------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/documents
STORAGE_MAX_FILE_SIZE=10485760

GPS_PROVIDER=mock
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=local
VERIFICATION_PROVIDER=manual

# development | anthropic | gemini
# `development` is a real local analyst, not a stub: it reads the authorised
# context, selects relevant facts and cites them. It never invents a number, so
# the whole AI path — permissions, tools, provenance, cost accounting — is
# exercised locally without an API key.
AI_PROVIDER=development
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_BASE_URL=

# --- Maps (MapLibre GL JS · open data) ----------------------------------------
# The basemap needs NO key, NO account and NO payment method:
#   - vector tiles + styles: OpenFreeMap (commercial use allowed, no limits)
#   - elevation: AWS Open Data terrain tiles
#   - 3D buildings: OpenStreetMap footprints via OpenMapTiles
#
# Turn-by-turn routing and place search use OpenRouteService, which needs a
# free API key — email signup only, no card:
#   https://account.heigit.org/signup
# Free plan: ~2,000 routing requests/day. Without a key the map still renders
# fully; only navigation and search are unavailable.
MAP_PROVIDER=openfreemap
ORS_API_KEY=
# Optional: point at a self-hosted OpenFreeMap instance or your own style JSON.
MAP_STYLE_URL=

# --- Vehicle registration (RC) lookup — Way2API -------------------------------
# https://app.way2api.com/documentation/vehicle-rc-text-pdf
# Server-side only. Leave WAY2API_API_KEY empty to disable the feature entirely;
# Saarthi never substitutes placeholder RC data for a missing key.
WAY2API_BASE_URL=https://app.way2api.com
WAY2API_API_KEY=
WAY2API_TIMEOUT_MS=20000
# Largest RC PDF Saarthi will download and store (bytes).
VEHICLE_RC_PDF_MAX_BYTES=8388608
# Seconds a stored RC record may be reused before a fresh (billable) lookup.
# Doubles as the retention window: expired records and their PDFs are deleted.
VEHICLE_CACHE_TTL=86400
# Hard ceiling on billable provider calls from this environment. 0 = no cap.
# Set this to your remaining trial allowance during development so a mistake
# cannot spend credits. Cache hits do not count toward it.
VEHICLE_LOOKUP_BUDGET=0
# How long a fetched RC record is kept so it does not have to be looked up
# again. Separate from the cache TTL above, which only decides when a fresh
# (billable) provider call is worthwhile.
VEHICLE_LOOKUP_RETENTION_DAYS=365
# Per-user lookup rate limit, on top of the global API limit.
VEHICLE_LOOKUP_RATE_LIMIT_MAX=10
VEHICLE_LOOKUP_RATE_LIMIT_WINDOW=1 minute

# --- Driving licence lookup (Way2API) -----------------------------------------
# https://app.way2api.com/documentation/driving-license
# Shares WAY2API_API_KEY above. Trial credits and billing are per service, so
# this lookup has its own cache window, retention and ceiling.
LICENCE_CACHE_TTL=86400
LICENCE_LOOKUP_RETENTION_DAYS=365
LICENCE_LOOKUP_BUDGET=0
LICENCE_LOOKUP_RATE_LIMIT_MAX=10
LICENCE_LOOKUP_RATE_LIMIT_WINDOW=1 minute

# --- Petrol stations — SSR Innovation Lab -------------------------------------
# https://api.ssrinnovationlab.com/api/test/18/
# The directory currently serves unauthenticated reads; set a key only if you
# have subscribed to one. No key is invented when the service needs none.
SSR_PETROL_API_BASE_URL=https://api.ssrinnovationlab.com
SSR_PETROL_API_KEY=
SSR_PETROL_TIMEOUT_MS=12000
# Seconds a station search is reused before the directory is queried again.
PETROL_STATION_CACHE_TTL=21600

# --- Vehicle resale marketplace ----------------------------------------------
# DEFERRED, and therefore off by default. The feature is fully built and its
# data is untouched; disabling withholds the entitlement, which closes the API
# routes, the navigation and the buttons in one move. Set to true to bring the
# surface back with no migration.
RESALE_ENABLED=false
# A listing is a financial representation about an asset, so review is on.
RESALE_REVIEW_REQUIRED=true
RESALE_LISTING_TTL_DAYS=60
RESALE_OFFER_TTL_DAYS=7

# --- Redis --------------------------------------------------------------------
# Saarthi runs entirely on the memory drivers for single-instance local
# development. Switch a driver to `redis` and set REDIS_URL when you run more
# than one API instance — the memory drivers are not merely slower across
# instances, they are wrong: an in-memory rate limit counts per process, and
# in-process pub/sub never reaches the instance holding the WebSocket.
#
# CACHE_DRIVER=redis also moves rate-limit counters to Redis.
CACHE_DRIVER=memory
QUEUE_DRIVER=memory
PUBSUB_DRIVER=memory
# Distributed locks for scheduled work (EMI reminders, provider sync).
LOCK_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379

# --- Video (multi-camera devices such as the YC06) ----------------------------
# Live video never passes through the API: the provider issues a short-lived,
# camera-scoped ticket and the browser negotiates with a video gateway directly.
# 'none' is the honest default when no camera hardware is fitted. 'mock' issues
# real tickets against a gateway that does not exist, so the whole path can be
# built and tested locally; it is refused in production.
VIDEO_PROVIDER=none
# Seconds a live-view ticket stays valid.
VIDEO_TICKET_TTL=120
# The YC06 has four channels.
VIDEO_MAX_CAMERAS_PER_DEVICE=4

# --- FASTag & toll (NETC) -----------------------------------------------------
# What a NETC lookup provider actually serves is tag *status*: active,
# blacklisted, vehicle class, issuing bank, and recent crossings. The rupee
# balance sits with the issuing bank and is not theirs to give — so Saarthi
# shows the balance you recorded and never invents one. Recharging a tag goes
# through the issuer or a BBPS agent, which a verification API is not; Saarthi
# records a top-up you made and links you to the issuer.
#
#   internal      recorded + statement import only (default, no key needed)
#   mastersindia  live NETC lookup — needs FASTAG_API_KEY and FASTAG_SUB_ID
#   mock          simulated, including a balance so the low-balance and blocked
#                 paths can be exercised locally. Refused in production.
FASTAG_PROVIDER=internal
FASTAG_API_BASE_URL=https://api-platform.mastersindia.co
FASTAG_API_KEY=
FASTAG_SUB_ID=
FASTAG_PRODUCT_ID=arap
FASTAG_MODE=Buyer
# Balance below which the fleet is warned — roughly one more national plaza.
FASTAG_LOW_BALANCE_THRESHOLD=500
# Seconds a tag lookup is reused before the provider is billed again.
FASTAG_CACHE_TTL=900

# --- Service history ----------------------------------------------------------
# 'internal' shows what your team recorded plus anything imported from an
# invoice. 'mock' adds a simulated OEM-network feed for local development, and
# is refused in production: a simulated service record would end up in a vehicle
# history that buyers and insurers rely on.
SERVICE_HISTORY_PROVIDER=internal

# --- Vehicle finance (loans & EMI) --------------------------------------------
# `internal` keeps only what your team records — the honest default, because a
# loan account number is not a lookup key: no financier discloses a repayment
# schedule without an integration and the borrower's consent.
# `mock` generates a simulated statement for local development. It is refused
# in production, and every figure it returns is stored flagged as SIMULATED.
LOAN_PROVIDER=internal
# Days before the due date at which an installment is flagged DUE_SOON.
LOAN_DUE_SOON_DAYS=4
# Reminder offsets in days relative to the due date: T-4, T-1 and a T+1
# overdue check. Negative is before the due date, positive is after.
LOAN_REMINDER_OFFSETS=-4,-1,1
# Installments processed per reminder sweep.
LOAN_REMINDER_BATCH=500

# --- Demo / simulation -------------------------------------------------------
# MUST be false in production.
DEMO_MODE=true
SIMULATOR_TICK_MS=1000

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_MAP_PROVIDER=openfreemap
# OpenRouteService key — enables turn-by-turn navigation and place search.
VITE_ORS_API_KEY=
# ORS host. HeiGIT is moving from api.openrouteservice.org to api.heigit.org;
# set this to https://api.openrouteservice.org if an endpoint 404s on the new host.
VITE_ORS_BASE_URL=https://api.heigit.org
# Default basemap: liberty | bright | positron | dark | fiord
VITE_MAP_STYLE_ID=liberty
VITE_MAP_STYLE_URL=
# Elevation tiles. Defaults to the AWS Open Data terrain tiles (open licence,
# no key). If terrain/hillshade never appears, check DevTools > Network for
# failing elevation-tile requests and try the alternative MapLibre documents:
#   VITE_TERRAIN_TILES_URL=https://tiles.mapterhorn.com/{z}/{x}/{y}.png
# VITE_TERRAIN_ENCODING is `terrarium` or `mapbox`.
VITE_TERRAIN_TILES_URL=
VITE_TERRAIN_ENCODING=terrarium
VITE_DEMO_MODE=true

# --- Tunnelling the dev server (optional) -----------------------------------
# Leave VITE_API_URL blank when tunnelling: the browser then calls a relative
# /api and Vite proxies it to the API, so one tunnel serves both and CORS never
# enters the picture. Set the tunnel hostname here or Vite blocks the request.
DEV_HOST=false
DEV_ALLOWED_HOSTS=
