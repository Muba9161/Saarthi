# ---------------------------------------------------------------------------
# Saarthi — environment configuration
# Copy to `.env` and adjust for your machine. NEVER commit a populated `.env`.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- API server --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------------
# Local native PostgreSQL (default) — matches `docker compose` service too.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/saarthi?schema=public

# --- Security ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters-long
COOKIE_SECURE=false
COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# --- Providers (mock today, real tomorrow) -----------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/documents
STORAGE_MAX_FILE_SIZE=10485760

GPS_PROVIDER=mock
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=local
VERIFICATION_PROVIDER=manual

# development | anthropic | gemini
# `development` is a real local analyst, not a stub: it reads the authorised
# context, selects relevant facts and cites them. It never invents a number, so
# the whole AI path — permissions, tools, provenance, cost accounting — is
# exercised locally without an API key.
AI_PROVIDER=development
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_BASE_URL=

# --- Maps (MapLibre GL JS · open data) ----------------------------------------
# The basemap needs NO key, NO account and NO payment method:
#   - vector tiles + styles: OpenFreeMap (commercial use allowed, no limits)
#   - elevation: AWS Open Data terrain tiles
#   - 3D buildings: OpenStreetMap footprints via OpenMapTiles
#
# Turn-by-turn routing and place search use OpenRouteService, which needs a
# free API key — email signup only, no card:
#   https://account.heigit.org/signup
# Free plan: ~2,000 routing requests/day. Without a key the map still renders
# fully; only navigation and search are unavailable.
MAP_PROVIDER=openfreemap
ORS_API_KEY=
# Optional: point at a self-hosted OpenFreeMap instance or your own style JSON.
MAP_STYLE_URL=

# --- Vehicle registration (RC) lookup — Way2API -------------------------------
# https://app.way2api.com/documentation/vehicle-rc-text-pdf
# Server-side only. Leave WAY2API_API_KEY empty to disable the feature entirely;
# Saarthi never substitutes placeholder RC data for a missing key.
WAY2API_BASE_URL=https://app.way2api.com
WAY2API_API_KEY=
WAY2API_TIMEOUT_MS=20000
# Largest RC PDF Saarthi will download and store (bytes).
VEHICLE_RC_PDF_MAX_BYTES=8388608
# Seconds a stored RC record may be reused before a fresh (billable) lookup.
# Doubles as the retention window: expired records and their PDFs are deleted.
VEHICLE_CACHE_TTL=86400
# Hard ceiling on billable provider calls from this environment. 0 = no cap.
# Set this to your remaining trial allowance during development so a mistake
# cannot spend credits. Cache hits do not count toward it.
VEHICLE_LOOKUP_BUDGET=0
# How long a fetched RC record is kept so it does not have to be looked up
# again. Separate from the cache TTL above, which only decides when a fresh
# (billable) provider call is worthwhile.
VEHICLE_LOOKUP_RETENTION_DAYS=365
# Per-user lookup rate limit, on top of the global API limit.
VEHICLE_LOOKUP_RATE_LIMIT_MAX=10
VEHICLE_LOOKUP_RATE_LIMIT_WINDOW=1 minute

# --- Driving licence lookup (Way2API) -----------------------------------------
# https://app.way2api.com/documentation/driving-license
# Shares WAY2API_API_KEY above. Trial credits and billing are per service, so
# this lookup has its own cache window, retention and ceiling.
LICENCE_CACHE_TTL=86400
LICENCE_LOOKUP_RETENTION_DAYS=365
LICENCE_LOOKUP_BUDGET=0
LICENCE_LOOKUP_RATE_LIMIT_MAX=10
LICENCE_LOOKUP_RATE_LIMIT_WINDOW=1 minute

# --- Petrol stations — SSR Innovation Lab -------------------------------------
# https://api.ssrinnovationlab.com/api/test/18/
# The directory currently serves unauthenticated reads; set a key only if you
# have subscribed to one. No key is invented when the service needs none.
SSR_PETROL_API_BASE_URL=https://api.ssrinnovationlab.com
SSR_PETROL_API_KEY=
SSR_PETROL_TIMEOUT_MS=12000
# Seconds a station search is reused before the directory is queried again.
PETROL_STATION_CACHE_TTL=21600

# --- Nearby places — OpenStreetMap via Overpass -------------------------------
#
# Live points of interest (fuel, dhabas, workshops, tyre shops, hospitals,
# police, weighbridges, truck halts) read from OpenStreetMap. No key, no card:
# the same survey the basemap, routing and elevation already use, so the pins
# agree with the map under them.
#
# Set to `local` to serve only the seeded `nearby_places` table — the right
# choice for an air-gapped install or a demo that must not touch the network.
PLACES_PROVIDER=overpass
# Tried in order until one answers. The public instances are shared and
# individually unreliable, so a list is the realistic configuration.
OVERPASS_API_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
# Overall deadline for a search, across every endpoint tried.
OVERPASS_TIMEOUT_MS=25000
# Past this radius Saarthi's own mirror answers, and it does measure distance.
OVERPASS_MAX_RADIUS_KM=25
# Query cost ceiling, in selector-kilometres. Overpass cost tracks (number of
# tag selectors × radius): measured on the public instance in dense Gurugram,
# ~200 lands around nine seconds and ~350 exceeds its budget entirely. Raise it
# freely for a self-hosted Overpass, which has no such ceiling.
OVERPASS_WORK_BUDGET=200
# Seconds a places search is reused before the directory is queried again.
NEARBY_PLACE_CACHE_TTL=10800

# --- City fuel rates ----------------------------------------------------------
#
# A separate source from the petrol station directory, deliberately. The
# directory's own petrol_price/diesel_price/cng_price fields are a single city
# figure years out of date with no timestamp — measured 2026-08-31, it gave
# Gurugram petrol at 95.44 against a real 102.97 — so Saarthi publishes none of
# them and reads current rates from a retail rate publisher instead.
#
# Set to `none` to show no rate at all, which is always safer than showing one
# Saarthi cannot stand behind.
FUEL_RATE_PROVIDER=cardekho
FUEL_RATE_BASE_URL=https://www.cardekho.com
FUEL_RATE_TIMEOUT_MS=12000
# Retail rates revise once daily at 06:00 IST, so six hours is fresh enough.
FUEL_RATE_CACHE_TTL=21600


# --- Vehicle resale marketplace ----------------------------------------------
# DEFERRED, and therefore off by default. The feature is fully built and its
# data is untouched; disabling withholds the entitlement, which closes the API
# routes, the navigation and the buttons in one move. Set to true to bring the
# surface back with no migration.
RESALE_ENABLED=false
# A listing is a financial representation about an asset, so review is on.
RESALE_REVIEW_REQUIRED=true
RESALE_LISTING_TTL_DAYS=60
RESALE_OFFER_TTL_DAYS=7

# --- Redis --------------------------------------------------------------------
# Saarthi runs entirely on the memory drivers for single-instance local
# development. Switch a driver to `redis` and set REDIS_URL when you run more
# than one API instance — the memory drivers are not merely slower across
# instances, they are wrong: an in-memory rate limit counts per process, and
# in-process pub/sub never reaches the instance holding the WebSocket.
#
# CACHE_DRIVER=redis also moves rate-limit counters to Redis.
CACHE_DRIVER=memory
QUEUE_DRIVER=memory
PUBSUB_DRIVER=memory
# Distributed locks for scheduled work (EMI reminders, provider sync).
LOCK_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379

# --- Video (multi-camera devices such as the YC06) ----------------------------
# Live video never passes through the API: the provider issues a short-lived,
# camera-scoped ticket and the browser negotiates with a video gateway directly.
# 'none' is the honest default when no camera hardware is fitted. 'mock' issues
# real tickets against a gateway that does not exist, so the whole path can be
# built and tested locally; it is refused in production. 'device' routes both
# viewers and publishers through a real WHIP/WHEP gateway, which is what a phone
# or a YC06 pushing a live stream needs — it requires the two settings below and
# falls back to 'none' without them.
VIDEO_PROVIDER=none
# Seconds a live-view ticket stays valid.
VIDEO_TICKET_TTL=120
# The YC06 has four channels.
VIDEO_MAX_CAMERAS_PER_DEVICE=4
# Base URL of the WHIP/WHEP gateway. Never a device address.
#
# Whatever address the *phone and the browser* reach the gateway on — never
# localhost, which on a phone is the phone. For the bundled MediaMTX
# (`docker compose --profile video up -d`):
#
#   LAN     VIDEO_GATEWAY_URL=http://192.168.1.20:8889
#   Tunnel  VIDEO_GATEWAY_URL=https://gw-8889.devtunnels.ms
#
# Match the scheme to the dashboard's. A dashboard on HTTPS cannot open a
# plain-HTTP gateway — the browser blocks it as mixed content before a request
# is made — so a tunnelled dashboard needs a tunnelled gateway.
VIDEO_GATEWAY_URL=
# Shared secret used to sign gateway tickets. Never sent to a client, and the
# gateway does not verify it itself — it hands each ticket back to
# POST /api/v1/video-gateway/authorize so Saarthi stays the authority on who may
# point a camera at a driver. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
VIDEO_GATEWAY_SECRET=
# Seconds a publisher ticket stays valid. Longer than a viewer ticket so a
# device re-establishing a stream after a tunnel need not first call Saarthi.
VIDEO_PUBLISH_TTL=300
# STUN and TURN servers, comma separated. Handed to the phone and the browser.
#
# Empty on a LAN: the phone and the gateway find each other with host candidates
# and nothing is relayed.
#
# Across networks — the gateway behind a tunnel, or the phone on mobile data —
# they cannot see each other and a TURN relay is the only thing that connects
# them. STUN alone is not enough behind carrier-grade NAT.
#
#   VIDEO_ICE_SERVERS=stun:stun.l.google.com:19302,turn:turn.example.com:3478
VIDEO_ICE_SERVERS=
VIDEO_TURN_USERNAME=
VIDEO_TURN_CREDENTIAL=

# The same TURN server, in the form the gateway container reads.
#
# Both ends have to use the same relay or they will gather candidates that
# have no route between them. One value, two places that need it.
VIDEO_TURN_URL=

# Public hostname of the video gateway, when it is behind a tunnel or a NAT.
#
# MediaMTX otherwise advertises the address it sees from inside its container,
# which nothing outside can reach. Hostname only, no scheme or port:
#   VIDEO_GATEWAY_PUBLIC_HOST=gw-8889.devtunnels.ms
VIDEO_GATEWAY_PUBLIC_HOST=

# --- Saarthi Device client (the Android app) ----------------------------------
# A phone running Saarthi Device authenticates as a *device*, not as a person,
# so it gets its own signing key. Sharing JWT_ACCESS_SECRET would mean a leaked
# device token and a leaked user token were forgeable from the same key, and the
# two populations have completely different threat models. Optional in
# development (it falls back to the user secret); required in production.
DEVICE_JWT_SECRET=
# Seconds a device access token lasts before the device secret must refresh it.
DEVICE_TOKEN_TTL=900
# Whether a phone may create its own identity without an administrator. The
# identity it creates holds no tenant and reaches no data until it redeems a
# pairing code issued from the dashboard.
DEVICE_SELF_ENROLMENT=true
# Enrolments per IP per window. An unauthenticated endpoint needs a ceiling.
DEVICE_ENROLMENT_RATE_LIMIT_MAX=5
DEVICE_ENROLMENT_RATE_LIMIT_WINDOW=1 hour
# Hours an unclaimed enrolment is kept before the sweep removes it.
DEVICE_ENROLMENT_TTL_HOURS=24
# Seconds a pairing QR stays scannable. Short: it is a bearer credential.
DEVICE_PAIRING_TOKEN_TTL=300
# Reporting cadence handed to a newly paired device, in seconds.
DEVICE_DEFAULT_REPORTING_INTERVAL=5
# Whether this environment accepts simulated engine data from a phone. Every
# such value is stored and displayed marked as simulated regardless.
DEVICE_SIMULATION_ALLOWED=true

# --- FASTag & toll (NETC) -----------------------------------------------------
# What a NETC lookup provider actually serves is tag *status*: active,
# blacklisted, vehicle class, issuing bank, and recent crossings. The rupee
# balance sits with the issuing bank and is not theirs to give — so Saarthi
# shows the balance you recorded and never invents one. Recharging a tag goes
# through the issuer or a BBPS agent, which a verification API is not; Saarthi
# records a top-up you made and links you to the issuer.
#
#   internal      recorded + statement import only (default, no key needed)
#   mastersindia  live NETC lookup — needs FASTAG_API_KEY and FASTAG_SUB_ID
#   mock          simulated, including a balance so the low-balance and blocked
#                 paths can be exercised locally. Refused in production.
#
# With a provider that supports lookup, adding a vehicle also looks its
# registration number up on NETC in the background and records the tag it finds
# — one billed call per vehicle added, and only for plans holding
# toll.fastag.sync. The same lookup is available on demand from the FASTag tab.
FASTAG_PROVIDER=internal
FASTAG_API_BASE_URL=https://api-platform.mastersindia.co
# Masters India issues a JWT that expires after 24 hours, not a permanent key.
# Give Saarthi the username and password and it mints and renews its own token.
# FASTAG_API_KEY is only for a token you obtained some other way, and it will
# stop working a day later — leave it blank for a normal setup.
FASTAG_API_USERNAME=
FASTAG_API_PASSWORD=
FASTAG_API_KEY=
# Issued with your account. Masters India shares it during onboarding.
FASTAG_SUB_ID=
FASTAG_PRODUCT_ID=arap
FASTAG_MODE=Buyer
# Balance below which the fleet is warned — roughly one more national plaza.
FASTAG_LOW_BALANCE_THRESHOLD=500
# Seconds a tag lookup is reused before the provider is billed again.
FASTAG_CACHE_TTL=900

# --- Service history ----------------------------------------------------------
# 'internal' shows what your team recorded plus anything imported from an
# invoice. 'mock' adds a simulated OEM-network feed for local development, and
# is refused in production: a simulated service record would end up in a vehicle
# history that buyers and insurers rely on.
SERVICE_HISTORY_PROVIDER=internal

# --- Vehicle finance (loans & EMI) --------------------------------------------
# `internal` keeps only what your team records — the honest default, because a
# loan account number is not a lookup key: no financier discloses a repayment
# schedule without an integration and the borrower's consent.
# `mock` generates a simulated statement for local development. It is refused
# in production, and every figure it returns is stored flagged as SIMULATED.
LOAN_PROVIDER=internal
# Days before the due date at which an installment is flagged DUE_SOON.
LOAN_DUE_SOON_DAYS=4
# Reminder offsets in days relative to the due date: T-4, T-1 and a T+1
# overdue check. Negative is before the due date, positive is after.
LOAN_REMINDER_OFFSETS=-4,-1,1
# Installments processed per reminder sweep.
LOAN_REMINDER_BATCH=500

# --- Demo / simulation -------------------------------------------------------
# MUST be false in production.
DEMO_MODE=true
SIMULATOR_TICK_MS=1000

# --- Frontend (Vite) ---------------------------------------------------------
# Leave both blank in development.
#
# Blank means the browser calls the API on its own origin with a relative path,
# and Vite's dev proxy (see apps/web/vite.config.ts) forwards /api and /ws to
# the API. That is the only setting that works from anything other than this
# machine: "localhost" typed here means the *phone's* localhost when a QR code
# is scanned, and an http:// call from an https:// dev-tunnel page is blocked as
# mixed content before it is even sent. Same-origin also sidesteps CORS and
# third-party-cookie rules, so the refresh cookie keeps working through a tunnel.
#
# Set them only when the API really is on a different origin the browser can
# reach — a deployed environment with a split API host.
VITE_API_URL=
VITE_WS_URL=
VITE_MAP_PROVIDER=openfreemap
# OpenRouteService key — enables turn-by-turn navigation and place search.
VITE_ORS_API_KEY=
# ORS host. HeiGIT is migrating to api.heigit.org, but as of 2026-08-31 that
# host answers 404 for every endpoint Saarthi uses — directions, geocoding and
# snapping alike — so the working host stays the default. Switch it over once
# api.heigit.org actually serves /v2/directions.
VITE_ORS_BASE_URL=https://api.openrouteservice.org
# Default basemap: liberty | bright | positron | dark | fiord
VITE_MAP_STYLE_ID=liberty
VITE_MAP_STYLE_URL=
# Elevation tiles. Defaults to the AWS Open Data terrain tiles (open licence,
# no key). If terrain/hillshade never appears, check DevTools > Network for
# failing elevation-tile requests and try the alternative MapLibre documents:
#   VITE_TERRAIN_TILES_URL=https://tiles.mapterhorn.com/{z}/{x}/{y}.png
# VITE_TERRAIN_ENCODING is `terrarium` or `mapbox`.
VITE_TERRAIN_TILES_URL=
VITE_TERRAIN_ENCODING=terrarium
VITE_DEMO_MODE=true

# --- Tunnelling the dev server (optional) -----------------------------------
# Leave VITE_API_URL blank when tunnelling: the browser then calls a relative
# /api and Vite proxies it to the API, so one tunnel serves both and CORS never
# enters the picture. Set the tunnel hostname here or Vite blocks the request.
DEV_HOST=false
DEV_ALLOWED_HOSTS=
