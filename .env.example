# ---------------------------------------------------------------------------
# Saarthi — environment configuration
# Copy to `.env` and adjust for your machine. NEVER commit a populated `.env`.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- API server --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------------
# Local native PostgreSQL (default) — matches `docker compose` service too.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/saarthi?schema=public

# --- Security ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters-long
COOKIE_SECURE=false
COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# --- Providers (mock today, real tomorrow) -----------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/documents
STORAGE_MAX_FILE_SIZE=10485760

GPS_PROVIDER=mock
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=local
VERIFICATION_PROVIDER=manual

AI_PROVIDER=development
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_BASE_URL=

# --- Cache / queue / pubsub --------------------------------------------------
# `memory` keeps everything in-process (no Redis needed). `redis` uses REDIS_URL.
CACHE_DRIVER=memory
QUEUE_DRIVER=memory
PUBSUB_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379

# --- Maps --------------------------------------------------------------------
# `maplibre` works with no API key using open raster tiles.
MAP_PROVIDER=maplibre
MAP_API_KEY=
# Optional vector style (unlocks true 3D terrain/buildings), e.g. MapTiler style URL
MAP_STYLE_URL=

# --- Demo / simulation -------------------------------------------------------
# MUST be false in production.
DEMO_MODE=true
SIMULATOR_TICK_MS=1000

# --- Frontend (Vite) ---------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_MAP_PROVIDER=maplibre
VITE_MAP_API_KEY=
VITE_MAP_STYLE_URL=
VITE_DEMO_MODE=true
