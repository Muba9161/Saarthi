// ===========================================================================
// Truck associations
// ===========================================================================

/// District/area truck association. One per organization of type
/// TRUCK_ASSOCIATION; the organization holds the account and members, this
/// holds the association-specific detail and its verification state.
model AssociationProfile {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  district String
  state    String

  officialEmail  String
  officialPhone  String
  /// Manned out-of-hours line. Separate from the office number on purpose.
  emergencyPhone String

  representativeName        String
  representativeDesignation String?
  representativePhone       String
  representativeEmail       String?

  memberTruckCount Int?
  about            String?

  /// Lets an association stop receiving alerts without being suspended.
  acceptingAlerts Boolean @default(true)

  /// Aggregates maintained on acknowledge/resolve so the dashboard and the
  /// platform's association league table do not scan the alert table.
  alertsReceived     Int    @default(0)
  alertsAcknowledged Int    @default(0)
  alertsResolved     Int    @default(0)
  /// Mean minutes from alert creation to acknowledgement.
  avgResponseMinutes Float?

  verifiedAt   DateTime?
  verifiedById String?   @db.Uuid
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coverageAreas AssociationCoverageArea[]
  alerts        AssociationAlert[]

  @@index([state, district])
  @@index([acceptingAlerts])
  @@map("association_profiles")
}

/// One area an association covers. Matching is geographic (distance from the
/// centre) rather than by district name, because an incident on a highway has
/// coordinates but no reliable district label without a geocoder.
model AssociationCoverageArea {
  id            String @id @default(uuid()) @db.Uuid
  associationId String @db.Uuid

  district  String
  state     String
  label     String?
  latitude  Float
  longitude Float
  radiusKm  Float   @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  association AssociationProfile @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@index([state, district])
  @@index([latitude, longitude])
  @@map("association_coverage_areas")
}

/// An SOS incident as projected to one association.
///
/// This is the privacy boundary: the association reads the incident *through*
/// this row, never from `sos_incidents` directly, so a field added to the
/// incident cannot become visible to associations by accident. Only what an
/// association needs to send help is copied here.
model AssociationAlert {
  id            String @id @default(uuid()) @db.Uuid
  associationId String @db.Uuid
  incidentId    String @db.Uuid
  /// Association-facing reference, distinct from the SOS reference.
  reference     String @unique

  severity AlertSeverity
  status   AssociationAlertStatus @default(NOTIFIED)

  /// Snapshot of the incident at routing time — deliberately denormalised so
  /// the association view never has to join into fleet-owned tables.
  incidentType        SosType
  vehicleRegistration String?
  vehicleType         VehicleType?
  fleetName           String?
  latitude            Float
  longitude           Float
  address             String?
  district            String?
  state               String?
  description         String?
  driverName          String?
  driverPhone         String?
  contactPhone        String?
  /// Distance from the nearest covered area centre, in km.
  distanceKm          Float?

  acknowledgedAt     DateTime?
  acknowledgedById   String?   @db.Uuid
  respondingAt       DateTime?
  escalatedAt        DateTime?
  escalationReason   String?
  resolvedAt         DateTime?
  resolvedById       String?   @db.Uuid
  outcome            String?
  assistanceProvided Boolean?
  closedAt           DateTime?

  notifiedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  association AssociationProfile      @relation(fields: [associationId], references: [id], onDelete: Cascade)
  incident    SosIncident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  events      AssociationAlertEvent[]
  responders  AssociationResponder[]

  /// One projection per association per incident.
  @@unique([associationId, incidentId])
  @@index([associationId, status, notifiedAt])
  @@index([incidentId])
  @@index([status, severity, notifiedAt])
  @@map("association_alerts")
}

/// Append-only audit trail of everything the association did about an alert.
model AssociationAlertEvent {
  id          String                    @id @default(uuid()) @db.Uuid
  alertId     String                    @db.Uuid
  eventType   AssociationAlertEventType
  description String?
  actorUserId String?                   @db.Uuid
  metadata    Json?
  createdAt   DateTime                  @default(now())

  alert AssociationAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
  @@map("association_alert_events")
}

/// Whoever the association sent to the scene — a member, or an outside service
/// such as a crane operator or workshop.
model AssociationResponder {
  id      String                     @id @default(uuid()) @db.Uuid
  alertId String                     @db.Uuid
  kind    AssociationResponderKind
  status  AssociationResponderStatus @default(ASSIGNED)

  /// Set when the responder is an association member.
  userId       String? @db.Uuid
  /// Set when the responder is external.
  name         String?
  phone        String?
  organisation String?

  etaMinutes   Int?
  note         String?
  assignedById String?   @db.Uuid
  assignedAt   DateTime  @default(now())
  enRouteAt    DateTime?
  onSceneAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  updatedAt    DateTime  @updatedAt

  alert AssociationAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, status])
  @@index([userId])
  @@map("association_responders")
}

// ===========================================================================
// Service provider profiles (taxi / travel / tour capability)
// ===========================================================================

/// The mobility capability of an organization.
///
/// Deliberately a profile rather than an organization type: a fleet owner who
/// starts running tours adds TRAVEL to `serviceTypes` and keeps one account,
/// one vehicle list and one login. Section 2 of the expansion spec — one
/// platform, one identity — is what makes this the right shape.
model ServiceProviderProfile {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  displayName  String
  serviceTypes ServiceType[]
  about        String?

  contactPhone  String
  contactEmail  String?
  whatsappPhone String?
  logoUrl       String?
  bannerUrl     String?

  businessRegistrationNumber String?
  yearsInBusiness            Int?
  languages                  String[]

  status ProviderStatus @default(ACTIVE)

  /// Rolling aggregates from completed bookings.
  ratingAverage     Float @default(0)
  ratingCount       Int   @default(0)
  bookingsTotal     Int   @default(0)
  bookingsCompleted Int   @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceAreas ProviderServiceArea[]
  packages     TravelPackage[]

  @@index([status])
  @@index([ratingAverage])
  @@map("service_provider_profiles")
}

model ProviderServiceArea {
  id         String @id @default(uuid()) @db.Uuid
  providerId String @db.Uuid

  city      String
  state     String
  latitude  Float
  longitude Float
  radiusKm  Float  @default(150)

  createdAt DateTime @default(now())

  provider ServiceProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([city, state])
  @@index([latitude, longitude])
  @@map("provider_service_areas")
}

// ===========================================================================
// Travel & tour packages
// ===========================================================================

model TravelPackage {
  id             String @id @default(uuid()) @db.Uuid
  providerId     String @db.Uuid
  /// Provider's tenant, duplicated so tenant scoping needs no join.
  organizationId String @db.Uuid

  title       String
  summary     String
  description String?
  serviceKind TravelServiceKind
  imageUrls   String[]

  destinations   String[]
  startLocation  String
  startLatitude  Float
  startLongitude Float
  endLocation    String

  durationDays     Int
  durationNights   Int?
  approxDistanceKm Float?

  vehicleType   VehicleType
  /// A specific vehicle, when the provider sells one particular car.
  vehicleId     String?     @db.Uuid
  minPassengers Int         @default(1)
  maxPassengers Int

  pricingModel PricingModel
  basePrice    Decimal      @db.Decimal(12, 2)

  inclusions         String[]
  exclusions         String[]
  /// [{ hoursBefore, refundPercent }] — empty means the platform default.
  cancellationPolicy Json?

  advanceBookingDays Int       @default(1)
  availableFrom      DateTime?
  availableTo        DateTime?
  /// 0 = Sunday. Empty means the package runs any day.
  availableWeekdays  Int[]

  driverIncluded Boolean @default(true)
  fuelIncluded   Boolean @default(true)

  status TravelPackageStatus @default(DRAFT)

  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)
  bookingCount  Int   @default(0)
  viewCount     Int   @default(0)

  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  provider  ServiceProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  vehicle   Truck?                 @relation("PackageVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  itinerary TravelItineraryDay[]
  bookings  TravelBooking[]

  @@index([status, serviceKind])
  @@index([organizationId, status])
  @@index([providerId, status])
  @@index([vehicleType, maxPassengers])
  @@index([basePrice])
  @@index([ratingAverage])
  @@map("travel_packages")
}

model TravelItineraryDay {
  id        String @id @default(uuid()) @db.Uuid
  packageId String @db.Uuid

  dayNumber        Int
  title            String
  description      String?
  highlights       String[]
  overnightAt      String?
  approxDistanceKm Float?

  createdAt DateTime @default(now())

  package TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, dayNumber])
  @@index([packageId])
  @@map("travel_itinerary_days")
}

// ===========================================================================
// Travel bookings
// ===========================================================================

model TravelBooking {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique

  packageId              String  @db.Uuid
  /// Provider's tenant.
  providerOrganizationId String  @db.Uuid
  /// Customer's tenant — the same customer account used for freight orders.
  customerOrganizationId String  @db.Uuid
  customerId             String? @db.Uuid
  bookedByUserId         String  @db.Uuid

  status BookingStatus @default(DRAFT)

  startDate  DateTime
  endDate    DateTime
  passengers Int

  pickupAddress   String?
  pickupLatitude  Float?
  pickupLongitude Float?

  contactName     String
  contactPhone    String
  contactEmail    String?
  specialRequests String?

  /// Snapshot of the price at booking time. A later package price change must
  /// not silently alter what the customer agreed to pay.
  pricingModel   PricingModel
  subtotal       Decimal      @db.Decimal(12, 2)
  platformFee    Decimal      @db.Decimal(12, 2)
  totalAmount    Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  priceBreakdown String?

  /// Assigned by the provider on confirmation.
  vehicleId String? @db.Uuid
  driverId  String? @db.Uuid
  /// The trip that carries this booking, so travel reuses live tracking.
  tripId    String? @unique @db.Uuid

  confirmedAt   DateTime?
  confirmedById String?   @db.Uuid
  declinedAt    DateTime?
  declineReason String?
  startedAt     DateTime?
  completedAt   DateTime?

  cancelledAt        DateTime?
  cancelledBy        CancelledBy?
  cancellationReason String?
  refundAmount       Decimal?     @db.Decimal(12, 2)
  refundedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package  TravelPackage        @relation(fields: [packageId], references: [id])
  vehicle  Truck?               @relation("BookingVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  trip     Trip?                @relation("BookingTrip", fields: [tripId], references: [id])
  events   TravelBookingEvent[]
  payments Payment[]
  review   TravelReview?

  @@index([customerOrganizationId, status, startDate])
  @@index([providerOrganizationId, status, startDate])
  @@index([packageId, startDate])
  @@index([status, startDate])
  @@index([driverId])
  @@map("travel_bookings")
}

model TravelBookingEvent {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @db.Uuid
  eventType   BookingEventType
  description String?
  actorUserId String?          @db.Uuid
  metadata    Json?
  createdAt   DateTime         @default(now())

  booking TravelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("travel_booking_events")
}

model TravelReview {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @unique @db.Uuid

  providerOrganizationId String @db.Uuid
  packageId              String @db.Uuid

  rating        Int
  vehicleRating Int?
  driverRating  Int?
  comment       String?

  ratedByUserId String   @db.Uuid
  createdAt     DateTime @default(now())

  booking TravelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([providerOrganizationId, createdAt])
  @@index([packageId])
  @@map("travel_reviews")
}

// ===========================================================================
// Payments
// ===========================================================================

/// A payment attempt against a Saarthi entity.
///
/// The gateway is abstracted behind `PaymentProvider`; locally the mock
/// provider settles instantly. No card or UPI credential is ever stored — only
/// the provider's own reference — so swapping in a real gateway does not turn
/// this table into cardholder data.
model Payment {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique

  purpose PaymentPurpose
  status  PaymentStatus  @default(PENDING)
  method  PaymentMethod  @default(MOCK)

  /// Payer's tenant.
  organizationId    String @db.Uuid
  initiatedByUserId String @db.Uuid

  bookingId String? @db.Uuid
  orderId   String? @db.Uuid

  amount         Decimal @db.Decimal(12, 2)
  currency       String  @default("INR")
  /// Amount returned so far; may be partial.
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)

  /// Which implementation handled this, e.g. `mock`.
  provider          String
  providerReference String?
  /// Provider-supplied failure code and message, kept verbatim for support.
  failureCode       String?
  failureMessage    String?

  processedAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking TravelBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([bookingId])
  @@index([status, createdAt])
  @@map("payments")
}

// ===========================================================================
// Hardware devices
// ===========================================================================

/// A physical telematics unit.
///
/// The device is not the vehicle. It is owned by an organization, may move
/// between vehicles over its life, and authenticates as itself — see
/// `device_assignments` for the vehicle relationship and its history.
model HardwareDevice {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  /// Identifier printed on the unit; what the device sends to the gateway.
  deviceIdentifier String         @unique
  provider         DeviceProvider
  deviceType       DeviceType     @default(OBD_TELEMATICS)

  serialNumber    String
  /// Sensitive. Never returned in a list response.
  imei            String? @unique
  manufacturer    String?
  model           String?
  firmwareVersion String?

  /// SIM identifiers are sensitive: an ICCID is enough to social-engineer a
  /// SIM swap. Stored for support, returned masked, and only to callers with
  /// the device-management permission.
  simIccid    String?
  simMsisdn   String?
  simOperator String?

  /// bcrypt hash of the device secret. The plaintext is shown exactly once, at
  /// registration and rotation, and is not recoverable afterwards.
  secretHash      String
  secretRotatedAt DateTime?
  /// Highest sequence number accepted, for replay rejection.
  lastSequence    Int?

  status DeviceStatus @default(REGISTERED)

  /// Metrics this unit is expected to report. The union actually observed is
  /// tracked separately, because what a device *can* do and what a given
  /// vehicle exposes are different questions.
  supportedMetrics String[]
  observedMetrics  String[]

  lastSeenAt      DateTime?
  lastTelemetryAt DateTime?
  readingCount    Int       @default(0)
  rejectedCount   Int       @default(0)

  notes         String?
  installedAt   DateTime?
  activatedAt   DateTime?
  deactivatedAt DateTime?
  archivedAt    DateTime?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments DeviceAssignment[]
  events      DeviceEvent[]
  readings    TelemetryReading[]
  alerts      TelemetryAlert[]
  mockRuns    MockDeviceRun[]

  @@index([organizationId, status])
  @@index([provider, status])
  @@index([lastSeenAt])
  @@index([organizationId, archivedAt])
  @@map("hardware_devices")
}

/// Device-to-vehicle assignment history.
///
/// A device is never hard-wired into a vehicle row. Swapping a failed unit
/// closes one assignment and opens another, and the vehicle keeps both — so
/// telemetry recorded last January still resolves to the device that produced
/// it, not to whatever is fitted today.
model DeviceAssignment {
  id             String @id @default(uuid()) @db.Uuid
  deviceId       String @db.Uuid
  vehicleId      String @db.Uuid
  organizationId String @db.Uuid

  status DeviceAssignmentStatus @default(ACTIVE)

  assignedById   String?   @db.Uuid
  assignedAt     DateTime  @default(now())
  installedAt    DateTime?
  unassignedAt   DateTime?
  unassignedById String?   @db.Uuid
  note           String?
  removalReason  String?

  device  HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicle Truck          @relation("VehicleDeviceAssignments", fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@index([vehicleId, status])
  @@index([organizationId, assignedAt])
  @@map("device_assignments")
}

model DeviceEvent {
  id             String          @id @default(uuid()) @db.Uuid
  deviceId       String          @db.Uuid
  organizationId String          @db.Uuid
  eventType      DeviceEventType
  description    String?
  metadata       Json?
  actorUserId    String?         @db.Uuid
  createdAt      DateTime        @default(now())

  device HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@index([organizationId, createdAt])
  @@map("device_events")
}

// ===========================================================================
// Telemetry
// ===========================================================================

/// A normalised telemetry reading. High-volume, append-only.
///
/// `metrics` lists which columns this reading genuinely carries. A consumer
/// must check it before rendering a value: "0 rpm" and "this vehicle does not
/// report rpm" mean different things, and only this column can tell them apart.
model TelemetryReading {
  id             String  @id @default(uuid()) @db.Uuid
  deviceId       String  @db.Uuid
  vehicleId      String  @db.Uuid
  organizationId String  @db.Uuid
  /// Denormalised from the vehicle at ingest, so driver-behaviour queries and
  /// score attribution do not need a point-in-time assignment lookup.
  driverId       String? @db.Uuid
  tripId         String? @db.Uuid

  /// Which of the columns below are present. Values from `TelemetryMetric`.
  metrics String[]

  /// Location
  latitude   Float?
  longitude  Float?
  speedKph   Float?
  heading    Float?
  altitude   Float?
  accuracy   Float?
  satellites Int?

  /// Vehicle
  rpm                Float?
  engineLoad         Float?
  coolantTemperature Float?
  intakeTemperature  Float?
  fuelLevel          Float?
  fuelRate           Float?
  throttlePosition   Float?
  batteryVoltage     Float?
  odometerKm         Float?
  vin                String?

  /// Motion
  accelerationX     Float?
  accelerationY     Float?
  accelerationZ     Float?
  harshBraking      Boolean @default(false)
  harshAcceleration Boolean @default(false)
  suddenMovement    Boolean @default(false)

  /// Device health
  deviceTemperature Float?
  signalStrength    Float?

  /// True when produced by the simulator. Never conflated with real hardware.
  simulated  Boolean @default(false)
  sequence   Int?
  /// Untouched vendor payload, retained for adapter debugging.
  rawPayload Json?

  /// When the device observed it.
  recordedAt DateTime
  /// When Saarthi accepted it. The gap is the ingestion delay.
  receivedAt DateTime @default(now())

  device      HardwareDevice            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicle     Truck                     @relation("VehicleTelemetry", fields: [vehicleId], references: [id], onDelete: Cascade)
  diagnostics TelemetryDiagnosticCode[]

  @@index([vehicleId, recordedAt])
  @@index([deviceId, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([tripId, recordedAt])
  @@index([driverId, recordedAt])
  @@map("telemetry_readings")
}

/// A diagnostic trouble code reported with a reading.
model TelemetryDiagnosticCode {
  id             String @id @default(uuid()) @db.Uuid
  readingId      String @db.Uuid
  vehicleId      String @db.Uuid
  organizationId String @db.Uuid

  code        String
  description String?
  confirmed   Boolean   @default(false)
  /// Set when an operator marks the fault dealt with.
  clearedAt   DateTime?
  createdAt   DateTime  @default(now())

  reading TelemetryReading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@index([organizationId, code])
  @@map("telemetry_diagnostic_codes")
}

/// A fired telemetry rule.
model TelemetryAlert {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String  @db.Uuid
  deviceId       String? @db.Uuid
  driverId       String? @db.Uuid
  tripId         String? @db.Uuid
  readingId      String? @db.Uuid

  type     TelemetryAlertType
  severity AlertSeverity
  status   TelemetryAlertStatus @default(OPEN)

  /// Human-readable, and phrased so a driver can see why it fired.
  message       String
  observedValue Float?
  threshold     Float?
  unit          String?
  latitude      Float?
  longitude     Float?

  acknowledgedAt   DateTime?
  acknowledgedById String?   @db.Uuid
  resolvedAt       DateTime?
  resolvedById     String?   @db.Uuid
  note             String?

  /// Set when this alert produced a driver-score event, so the score screen can
  /// link the deduction back to the evidence.
  scoreEventId String? @db.Uuid

  occurredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  device  HardwareDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  vehicle Truck           @relation("VehicleTelemetryAlerts", fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([driverId, type, occurredAt])
  @@index([type, severity, occurredAt])
  @@map("telemetry_alerts")
}

/// Per-organization (optionally per-vehicle) tuning of an alert rule. A missing
/// row means the shared default from `domain/telemetry.ts` applies.
model TelemetryAlertRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  /// Null = applies to every vehicle in the organization.
  vehicleId      String? @db.Uuid

  type            TelemetryAlertType
  enabled         Boolean            @default(true)
  threshold       Float?
  severity        AlertSeverity?
  cooldownSeconds Int?

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, vehicleId, type])
  @@index([organizationId, enabled])
  @@map("telemetry_alert_rules")
}

/// A monitored area. Breaching one raises a GEOFENCE_BREACH alert.
model Geofence {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String? @db.Uuid

  name         String
  kind         GeofenceKind @default(INCLUSION)
  latitude     Float
  longitude    Float
  radiusMeters Int
  enabled      Boolean      @default(true)
  notes        String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId, enabled])
  @@index([vehicleId])
  @@map("geofences")
}

/// State of a mock-device run.
///
/// Persisted rather than held in memory so a restart cannot leave a simulator
/// apparently running with nothing behind it, which is exactly the kind of
/// phantom state that makes a demo unexplainable.
model MockDeviceRun {
  id             String @id @default(uuid()) @db.Uuid
  deviceId       String @db.Uuid
  organizationId String @db.Uuid

  status          SimulationStatus   @default(IDLE)
  scenario        MockDeviceScenario @default(NORMAL)
  intervalSeconds Int                @default(5)
  maxReadings     Int?
  readingsSent    Int                @default(0)

  /// Simulated vehicle state, carried between ticks.
  lastLatitude   Float?
  lastLongitude  Float?
  lastHeading    Float?
  lastSpeedKph   Float?
  lastFuelLevel  Float?
  lastOdometerKm Float?

  startedById String?   @db.Uuid
  startedAt   DateTime?
  stoppedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  device HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@index([status])
  @@map("mock_device_runs")
}

