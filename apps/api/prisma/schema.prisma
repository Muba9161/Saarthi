// ===========================================================================
// Suppliers, materials & customers
// ===========================================================================

model Supplier {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @unique @db.Uuid
  businessDescription String?
  /// Primary yard/depot the materials are dispatched from.
  addressLine         String?
  city                String?
  state               String?
  postalCode          String?
  latitude            Float?
  longitude           Float?
  contactName         String?
  contactPhone        String?
  verificationStatus  VerificationStatus @default(PENDING)
  rating              Float?
  ratingCount         Int                @default(0)
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  materials          Material[]
  inventoryLocations InventoryLocation[]

  @@index([verificationStatus])
  @@map("suppliers")
}

model Material {
  id                String         @id @default(uuid()) @db.Uuid
  supplierId        String         @db.Uuid
  organizationId    String         @db.Uuid
  name              String
  category          String?
  description       String?
  unit              MaterialUnit   @default(TON)
  pricePerUnit      Decimal        @db.Decimal(12, 2)
  availableQuantity Float          @default(0)
  minimumOrderQty   Float          @default(1)
  status            MaterialStatus @default(ACTIVE)
  imageUrl          String?
  /// Pickup point for this material, defaults to the supplier yard.
  pickupAddress     String?
  pickupLatitude    Float?
  pickupLongitude   Float?

  // --- Inventory ----------------------------------------------------------
  //
  // `stockTracked` defaults to false, which reproduces the pre-inventory
  // behaviour exactly: `availableQuantity` is hand-edited and no ledger is
  // written. Turning it on opens a stock record from the current figure.
  sku                String?
  hsnCode            String?
  brand              String?
  stockTracked       Boolean                  @default(false)
  availabilityMode   MaterialAvailabilityMode @default(IN_STOCK)
  /// Denormalised for list filters; recomputed on every movement.
  availabilityStatus StockAvailabilityStatus  @default(IN_STOCK)
  lowStockThreshold  Float                    @default(0)
  leadTimeDays       Int?
  maximumOrderQty    Float?
  allowBackorder     Boolean                  @default(false)
  nextRestockAt      DateTime?
  /// Aggregates across every location, kept in step inside the same
  /// transaction as the ledger write so they can never drift.
  onHandQuantity     Float                    @default(0)
  reservedQuantity   Float                    @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orders       Order[]
  stockItems   StockItem[]
  priceTiers   MaterialPriceTier[]
  requirements Requirement[]       @relation("RequirementMaterial")
  bids         RequirementBid[]    @relation("BidMaterial")

  @@index([supplierId, status])
  @@index([organizationId, status])
  @@index([category])
  @@index([name])
  @@index([availabilityStatus])
  @@index([sku])
  @@map("materials")
}

model Customer {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @db.Uuid
  primaryUserId      String?            @db.Uuid
  businessType       String?
  addressLine        String?
  city               String?
  state              String?
  postalCode         String?
  latitude           Float?
  longitude          Float?
  verificationStatus VerificationStatus @default(PENDING)
  totalOrders        Int                @default(0)
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  orders       Order[]
  requirements Requirement[]

  @@index([verificationStatus])
  @@map("customers")
}

// ===========================================================================
// Orders
// ===========================================================================

model Order {
  id                     String @id @default(uuid()) @db.Uuid
  /// Human-friendly reference shown in the UI, e.g. SO-2026-000123.
  reference              String @unique
  customerId             String @db.Uuid
  /// Tenant of the customer who raised the requirement.
  customerOrganizationId String @db.Uuid

  /// Material sourcing is optional: a customer may already own the goods and
  /// need transport only.
  materialId             String? @db.Uuid
  supplierOrganizationId String? @db.Uuid

  /// Fleet that won the order. Null until a quote is accepted.
  fleetOrganizationId String? @db.Uuid

  materialName String
  quantity     Float
  unit         MaterialUnit @default(TON)

  materialPrice  Decimal? @db.Decimal(12, 2)
  transportPrice Decimal? @db.Decimal(12, 2)
  totalPrice     Decimal? @db.Decimal(12, 2)
  /// Optional customer budget used for matching and quote ranking.
  budget         Decimal? @db.Decimal(12, 2)

  originAddress        String
  originLatitude       Float
  originLongitude      Float
  destinationAddress   String
  destinationLatitude  Float
  destinationLongitude Float
  distanceKm           Float?

  requiredCapacityTons Float
  requiredTruckType    TruckType?
  pickupAt             DateTime?
  deliverBy            DateTime?

  status           OrderStatus @default(REQUESTED)
  assignedTruckId  String?     @db.Uuid
  assignedDriverId String?     @db.Uuid
  tripId           String?     @unique @db.Uuid

  // --- Return loads -------------------------------------------------------
  /// This order was filled as a backhaul rather than a fresh outbound run.
  isReturnLoad        Boolean @default(false)
  returnLoadRequestId String? @db.Uuid
  /// Round-trip pairing, when the customer booked both directions.
  parentOrderId       String? @db.Uuid

  // --- City access & last-mile relay --------------------------------------
  /// Set by the access check when the drop sits inside a restricted zone.
  requiresLastMile Boolean      @default(false)
  /// Denormalised leg status so order lists do not need a join.
  lastMileStatus   RelayStatus?

  notes              String?
  cancellationReason String?
  createdById        String    @db.Uuid
  confirmedAt        DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id])
  material          Material?          @relation(fields: [materialId], references: [id])
  trip              Trip?              @relation("OrderTrip", fields: [tripId], references: [id])
  returnLoadRequest ReturnLoadRequest? @relation("OrderReturnLoad", fields: [returnLoadRequestId], references: [id], onDelete: SetNull)
  quotes            OrderQuote[]
  events            OrderEvent[]
  rating            OrderRating?
  stockReservations StockReservation[]
  returnLoadMatches ReturnLoadMatch[]
  relayDeliveries   RelayDelivery[]
  /// Set when the order was produced by awarding a requirement bid rather
  /// than by posting a freight order directly.
  requirement       Requirement?       @relation("RequirementOrder")

  @@index([customerOrganizationId, status, createdAt])
  @@index([supplierOrganizationId, status])
  @@index([fleetOrganizationId, status])
  @@index([status, createdAt])
  @@index([assignedTruckId])
  @@index([isReturnLoad, status])
  @@index([requiresLastMile, status])
  @@map("orders")
}

model OrderQuote {
  id                  String      @id @default(uuid()) @db.Uuid
  orderId             String      @db.Uuid
  /// Fleet organization offering transport for this requirement.
  fleetOrganizationId String      @db.Uuid
  truckId             String?     @db.Uuid
  driverId            String?     @db.Uuid
  price               Decimal     @db.Decimal(12, 2)
  estimatedPickupAt   DateTime?
  estimatedArrivalAt  DateTime?
  /// Distance from the truck's current position to the pickup point.
  distanceToPickupKm  Float?
  message             String?
  status              QuoteStatus @default(OFFERED)
  expiresAt           DateTime?
  createdById         String      @db.Uuid
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, fleetOrganizationId, truckId])
  @@index([orderId, status])
  @@index([fleetOrganizationId, status])
  @@map("order_quotes")
}

model OrderEvent {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @db.Uuid
  type        OrderEventType
  description String
  metadata    Json?
  actorUserId String?        @db.Uuid
  createdAt   DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderRating {
  id                     String   @id @default(uuid()) @db.Uuid
  orderId                String   @unique @db.Uuid
  driverId               String?  @db.Uuid
  fleetOrganizationId    String?  @db.Uuid
  supplierOrganizationId String?  @db.Uuid
  /// 1-5 stars.
  rating                 Int
  punctuality            Int?
  communication          Int?
  cargoCondition         Int?
  comment                String?
  ratedByUserId          String   @db.Uuid
  createdAt              DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([fleetOrganizationId])
  @@map("order_ratings")
}

// ===========================================================================
// Requirements & bidding
//
// The customer's single front door. Before this existed a customer could only
// post a freight load, so demand for materials, cabs and tours was invisible
// to the businesses that could serve it. A requirement inverts that for every
// category at once: the customer states a need, the qualifying businesses bid,
// and an awarded bid becomes an Order or a TravelBooking on the fulfilment
// pipelines that already exist — nothing downstream had to change.
// ===========================================================================

model Requirement {
  id        String @id @default(uuid()) @db.Uuid
  /// Human-friendly reference shown in the UI, e.g. RQ-2026-00123.
  reference String @unique

  kind                   RequirementKind
  customerId             String          @db.Uuid
  /// Tenant of the customer who raised it.
  customerOrganizationId String          @db.Uuid

  title       String
  description String?

  originAddress   String
  originLatitude  Float
  originLongitude Float
  originCity      String?
  originState     String?

  /// Null only for a tour, where the itinerary is the route.
  destinationAddress   String?
  destinationLatitude  Float?
  destinationLongitude Float?
  destinationCity      String?
  destinationState     String?

  /// Straight-line origin to destination, for board ranking.
  distanceKm Float?

  startAt       DateTime
  endAt         DateTime?
  scheduleNotes String?

  budgetAmount   Decimal? @db.Decimal(12, 2)
  /// Whether bidders may see the budget. Off by default: a visible budget
  /// tends to become the price, which is not what an auction is for.
  budgetIsPublic Boolean  @default(false)

  /// Bidding closes here. Enforced on write, and swept by the expiry job.
  bidsCloseAt DateTime

  contactName  String?
  contactPhone String?

  // --- Kind-specific detail ------------------------------------------------
  //
  // Typed columns rather than a JSON blob: these are filtered, sorted and
  // shown on the provider board, and a board that cannot query tonnage or
  // passenger count is not a board.

  /// MATERIAL_SUPPLY. An existing listing, when the customer picked one.
  materialId       String?       @db.Uuid
  materialName     String?
  materialCategory String?
  specification    String?
  quantity         Float?
  unit             MaterialUnit?
  /// Whether Saarthi should also find the lorry.
  needsTransport   Boolean       @default(false)

  /// FREIGHT_TRANSPORT.
  goodsDescription     String?
  requiredCapacityTons Float?
  requiredTruckType    TruckType?
  handlingNotes        String?

  /// CAB_HIRE and TOUR_PACKAGE.
  hireBasis            HireBasis?
  passengers           Int?
  preferredVehicleType VehicleType?
  durationHours        Int?
  durationDays         Int?
  durationNights       Int?
  luggageCount         Int?
  acRequired           Boolean?
  destinations         String[]
  requiredInclusions   String[]
  accommodationNeeded  Boolean?
  mealsNeeded          Boolean?

  // --- Lifecycle -----------------------------------------------------------
  status RequirementStatus @default(OPEN)

  /// Denormalised so the customer's list needs no aggregate query.
  bidCount  Int      @default(0)
  lowestBid Decimal? @db.Decimal(12, 2)

  /// The winning bids. A material requirement that asked for delivery settles
  /// two: one for the goods, one for the lorry.
  awardedMaterialBidId  String? @unique @db.Uuid
  awardedTransportBidId String? @unique @db.Uuid
  awardedTravelBidId    String? @unique @db.Uuid

  /// What the award produced. Exactly one is set once fully awarded.
  orderId   String? @unique @db.Uuid
  bookingId String? @unique @db.Uuid

  cancellationReason String?
  createdById        String    @db.Uuid
  awardedAt          DateTime?
  fulfilledAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer Customer           @relation(fields: [customerId], references: [id])
  material Material?          @relation("RequirementMaterial", fields: [materialId], references: [id], onDelete: SetNull)
  order    Order?             @relation("RequirementOrder", fields: [orderId], references: [id], onDelete: SetNull)
  booking  TravelBooking?     @relation("RequirementBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  bids     RequirementBid[]
  events   RequirementEvent[]
  packages TravelPackage[]    @relation("RequirementPackage")

  @@index([customerOrganizationId, status, createdAt])
  // The provider board's primary query: open requirements of a kind I can
  // serve, soonest first.
  @@index([status, kind, startAt])
  @@index([kind, status, createdAt])
  @@index([bidsCloseAt, status])
  @@index([originLatitude, originLongitude])
  @@map("requirements")
}

model RequirementBid {
  id            String @id @default(uuid()) @db.Uuid
  requirementId String @db.Uuid

  scope                RequirementBidScope
  /// The business making the offer.
  bidderOrganizationId String              @db.Uuid

  price          Decimal   @db.Decimal(12, 2)
  priceBreakdown String?
  message        String?
  validUntil     DateTime?

  // --- Transport -----------------------------------------------------------
  vehicleId          String?   @db.Uuid
  driverId           String?   @db.Uuid
  estimatedPickupAt  DateTime?
  estimatedArrivalAt DateTime?
  /// Distance from the offered vehicle to the pickup point at bid time.
  distanceToPickupKm Float?

  // --- Material ------------------------------------------------------------
  materialId        String? @db.Uuid
  includesDelivery  Boolean @default(false)
  availableQuantity Float?
  leadTimeDays      Int?

  // --- Travel --------------------------------------------------------------
  offeredVehicleType VehicleType?
  inclusions         String[]
  exclusions         String[]
  itinerarySummary   String?
  driverIncluded     Boolean      @default(true)
  fuelIncluded       Boolean      @default(true)

  status RequirementBidStatus @default(OFFERED)

  rejectionReason String?
  createdById     String    @db.Uuid
  shortlistedAt   DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  withdrawnAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  vehicle     Truck?      @relation("BidVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  material    Material?   @relation("BidMaterial", fields: [materialId], references: [id], onDelete: SetNull)

  /// One live offer per business per scope. A bidder revises its price by
  /// updating the bid rather than stacking a second one beside it.
  @@unique([requirementId, bidderOrganizationId, scope])
  @@index([requirementId, status, price])
  @@index([bidderOrganizationId, status, createdAt])
  @@index([vehicleId])
  @@map("requirement_bids")
}

model RequirementEvent {
  id            String               @id @default(uuid()) @db.Uuid
  requirementId String               @db.Uuid
  type          RequirementEventType
  description   String
  metadata      Json?
  actorUserId   String?              @db.Uuid
  createdAt     DateTime             @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId, createdAt])
  @@map("requirement_events")
}

// ===========================================================================
// Trips
// ===========================================================================

model Trip {
  id             String  @id @default(uuid()) @db.Uuid
  reference      String  @unique
  /// Fleet tenant that operates this trip.
  organizationId String  @db.Uuid
  truckId        String  @db.Uuid
  driverId       String? @db.Uuid

  originAddress        String
  originLatitude       Float
  originLongitude      Float
  destinationAddress   String
  destinationLatitude  Float
  destinationLongitude Float

  /// Planned route polyline as [{ latitude, longitude }, ...].
  plannedRoute       Json?
  plannedDistanceKm  Float?
  actualDistanceKm   Float  @default(0)
  /// Litres burned, integrated from the engine's own consumption reading.
  ///
  /// Null when the vehicle never reported a fuel rate, which is most of the
  /// fleet: absent means "not measured", never zero. A trip showing 0 L would
  /// make every average built on it wrong in the flattering direction.
  fuelLitres         Float?
  /// Kilometres per litre for this trip, from the two figures above.
  ///
  /// Stored rather than derived on read, because the readings it came from are
  /// pruned long before the trip record is.
  fuelEconomyKmpl    Float?
  plannedDurationMin Int?
  actualDurationMin  Int?

  plannedStartAt   DateTime?
  actualStartAt    DateTime?
  plannedArrivalAt DateTime?
  actualArrivalAt  DateTime?
  /// Continuously updated by the tracking pipeline while the trip is moving.
  etaAt            DateTime?
  delayMinutes     Int       @default(0)

  status   TripStatus @default(DRAFT)
  price    Decimal?   @db.Decimal(12, 2)
  expenses Decimal?   @db.Decimal(12, 2)
  notes    String?

  // --- Leg type -----------------------------------------------------------
  //
  // A movement can now be several trips: the outbound run, the backhaul that
  // stops it coming home empty, and the city relay leg a pickup completes.
  legType             TripLegType @default(PRIMARY)
  parentTripId        String?     @db.Uuid
  returnLoadRequestId String?     @db.Uuid

  // --- Ad-hoc service runs ------------------------------------------------
  //
  // A driver with no dispatched trip who drives to a petrol pump, a workshop or
  // a weighbridge is still making a journey the fleet pays for. The terminal
  // opens one of these when the driver starts navigating to a nearby service
  // and closes it on arrival, so the run lands in the trip history with real
  // figures instead of disappearing. The flag is what lets the fleet tell a
  // dispatched movement from one the vehicle made on its own account, and what
  // lets `createTrip` close a service run rather than refuse a real trip
  // because the truck was still "busy" fetching diesel.
  adHoc Boolean @default(false)

  // --- Driving summary ----------------------------------------------------
  //
  // Written when the trip closes, from the figures the terminal accumulated
  // while it was open. Stored on the trip rather than recomputed from the
  // reading series because the series is pruned and the summary is not.
  topSpeedKph            Float?
  averageSpeedKph        Float?
  harshBrakingCount      Int    @default(0)
  harshAccelerationCount Int    @default(0)

  /// Vehicle odometer at each end of the movement.
  startOdometerKm Float?
  endOdometerKm   Float?

  cancellationReason String?
  createdById        String   @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order             Order?             @relation("OrderTrip")
  travelBooking     TravelBooking?     @relation("BookingTrip")
  returnLoadRequest ReturnLoadRequest? @relation("TripReturnLoad", fields: [returnLoadRequestId], references: [id], onDelete: SetNull)
  events            TripEvent[]
  stops             TripStop[]
  hazardAlerts      TripHazardAlert[]

  @@index([organizationId, status, createdAt])
  @@index([truckId, status])
  @@index([truckId, adHoc, status])
  @@index([driverId, status])
  @@index([status])
  @@index([legType, status])
  @@index([parentTripId])
  @@map("trips")
}

model TripEvent {
  id          String        @id @default(uuid()) @db.Uuid
  tripId      String        @db.Uuid
  type        TripEventType
  description String?
  latitude    Float?
  longitude   Float?
  metadata    Json?
  actorUserId String?       @db.Uuid
  createdAt   DateTime      @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([type])
  @@map("trip_events")
}

model TripStop {
  id              String         @id @default(uuid()) @db.Uuid
  tripId          String         @db.Uuid
  type            TripStopType
  name            String
  address         String?
  latitude        Float
  longitude       Float
  sequence        Int
  plannedArrival  DateTime?
  actualArrival   DateTime?
  actualDeparture DateTime?
  status          TripStopStatus @default(PENDING)
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, sequence])
  @@index([tripId, status])
  @@map("trip_stops")
}

