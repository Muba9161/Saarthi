  amount              Decimal            @db.Decimal(12, 2)
  message             String?
  status              VehicleOfferStatus @default(OFFERED)
  counterAmount       Decimal?           @db.Decimal(12, 2)
  counterMessage      String?
  counteredAt         DateTime?
  wantsInspection     Boolean            @default(false)
  expiresAt           DateTime?
  respondedAt         DateTime?
  rejectionReason     String?
  withdrawnAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([buyerOrganizationId, status])
  @@map("vehicle_listing_offers")
}

model VehicleInspectionRequest {
  id                      String                  @id @default(uuid()) @db.Uuid
  listingId               String                  @db.Uuid
  requesterOrganizationId String                  @db.Uuid
  requesterUserId         String                  @db.Uuid
  status                  VehicleInspectionStatus @default(REQUESTED)
  preferredAt             DateTime
  alternateAt             DateTime?
  scheduledAt             DateTime?
  location                String?
  contactPhone            String?
  note                    String?
  reportSummary           String?
  inspectorUserId         String?                 @db.Uuid
  completedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([requesterOrganizationId, status])
  @@map("vehicle_inspection_requests")
}

model VehicleListingEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  listingId   String                  @db.Uuid
  type        VehicleListingEventType
  description String
  metadata    Json?
  actorUserId String?                 @db.Uuid
  createdAt   DateTime                @default(now())

  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@map("vehicle_listing_events")
}

/// A listing saved by a buyer organization.
model VehicleListingWatch {
  id             String   @id @default(uuid()) @db.Uuid
  listingId      String   @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now())

  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
