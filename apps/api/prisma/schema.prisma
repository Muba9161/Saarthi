// ===========================================================================
// Media library
// ===========================================================================

/// An image (or supporting file) attached to any Saarthi record.
///
/// Deliberately separate from `documents`: a document is a compliance artefact
/// that is versioned, verified and expires, while this is a photograph. Owners
/// are polymorphic and carry no foreign key, the same choice `documents` makes,
/// because the alternative is twenty nullable columns.
///
/// There is no variants table. Renditions are produced in the browser before
/// upload, so a row holds the full-size object and its thumbnail.
model MediaAsset {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String?         @db.Uuid
  ownerType      MediaOwnerType
  ownerId        String          @db.Uuid
  purpose        MediaPurpose    @default(GALLERY)
  visibility     MediaVisibility @default(ORGANIZATION)

  storageKey String
  fileName   String
  mimeType   String
  fileSize   Int
  width      Int?
  height     Int?
  checksum   String?

  thumbnailStorageKey String?
  thumbnailWidth      Int?
  thumbnailHeight     Int?
  thumbnailFileSize   Int?

  altText   String?
  caption   String?
  sortOrder Int     @default(0)
  /// Enforced by the service inside a transaction rather than a partial unique
  /// index, so a soft-deleted row can never block a re-upload.
  isPrimary Boolean @default(false)

  /// Where the photo was taken, when the device offered it.
  latitude   Float?
  longitude  Float?
  capturedAt DateTime?

  moderationStatus MediaModerationStatus @default(APPROVED)
  moderationNote   String?
  uploadedById     String                @db.Uuid
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([ownerType, ownerId, deletedAt, sortOrder])
  @@index([organizationId, purpose])
  @@index([uploadedById])
  @@index([moderationStatus])
  @@map("media_assets")
}

