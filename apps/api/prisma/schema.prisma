  START_CAMERA
  STOP_CAMERA
  CHANGE_REPORTING_INTERVAL
  REQUEST_LOCATION
  PING
  UPDATE_CONFIGURATION
}

enum DeviceCommandStatus {
  PENDING
  DELIVERED
  ACKNOWLEDGED
  FAILED
  /// Never collected before its deadline.
  EXPIRED
}

/// Connectivity a device reports about itself.
enum DeviceNetworkType {
  WIFI
  CELLULAR
  ETHERNET
  OFFLINE
  UNKNOWN
}

/// A subsystem's own verdict on itself.
///
/// Reported rather than inferred, because only the device knows the difference
/// between "the user refused the permission" and "the hardware is not there" —
/// and a dashboard that conflates them sends an engineer to look at a phone
/// whose owner simply tapped Deny.
enum DeviceSubsystemStatus {
  OK
  DEGRADED
  PERMISSION_DENIED
  UNAVAILABLE
  UNKNOWN
}

enum TelemetryAlertType {
  OVERSPEED
  HARSH_BRAKING
  HARSH_ACCELERATION
  EXCESSIVE_IDLING
  ENGINE_TEMPERATURE
  LOW_VOLTAGE
  DEVICE_OFFLINE
  ROUTE_DEVIATION
  GEOFENCE_BREACH
  DIAGNOSTIC_FAULT
  FUEL_DROP
  UNUSUAL_BEHAVIOUR
}

enum TelemetryAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum GeofenceKind {
  INCLUSION
  EXCLUSION
}

enum MockDeviceScenario {
  NORMAL
  OVERSPEED
  HARSH_DRIVING
  OVERHEATING
  LOW_VOLTAGE
  FAULT_CODE
}

// ===========================================================================
// Truck associations
// ===========================================================================

/// District/area truck association. One per organization of type
/// TRUCK_ASSOCIATION; the organization holds the account and members, this
/// holds the association-specific detail and its verification state.
model AssociationProfile {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  district String
  state    String

  officialEmail  String
  officialPhone  String
  /// Manned out-of-hours line. Separate from the office number on purpose.
  emergencyPhone String

  representativeName        String
  representativeDesignation String?
  representativePhone       String
  representativeEmail       String?

  memberTruckCount Int?
  about            String?

  /// Lets an association stop receiving alerts without being suspended.
  acceptingAlerts Boolean @default(true)

  /// Aggregates maintained on acknowledge/resolve so the dashboard and the
  /// platform's association league table do not scan the alert table.
  alertsReceived     Int    @default(0)
  alertsAcknowledged Int    @default(0)
  alertsResolved     Int    @default(0)
  /// Mean minutes from alert creation to acknowledgement.
  avgResponseMinutes Float?

  verifiedAt   DateTime?
  verifiedById String?   @db.Uuid
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coverageAreas AssociationCoverageArea[]
  alerts        AssociationAlert[]

  @@index([state, district])
  @@index([acceptingAlerts])
  @@map("association_profiles")
}

/// One area an association covers. Matching is geographic (distance from the
/// centre) rather than by district name, because an incident on a highway has
/// coordinates but no reliable district label without a geocoder.
model AssociationCoverageArea {
  id            String @id @default(uuid()) @db.Uuid
  associationId String @db.Uuid

  district  String
  state     String
  label     String?
  latitude  Float
  longitude Float
  radiusKm  Float   @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  association AssociationProfile @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([associationId])
  @@index([state, district])
  @@index([latitude, longitude])
  @@map("association_coverage_areas")
}

/// An SOS incident as projected to one association.
///
/// This is the privacy boundary: the association reads the incident *through*
/// this row, never from `sos_incidents` directly, so a field added to the
/// incident cannot become visible to associations by accident. Only what an
/// association needs to send help is copied here.
model AssociationAlert {
  id            String @id @default(uuid()) @db.Uuid
  associationId String @db.Uuid
  incidentId    String @db.Uuid
  /// Association-facing reference, distinct from the SOS reference.
  reference     String @unique

  severity AlertSeverity
  status   AssociationAlertStatus @default(NOTIFIED)

  /// Snapshot of the incident at routing time — deliberately denormalised so
  /// the association view never has to join into fleet-owned tables.
  incidentType        SosType
  vehicleRegistration String?
  vehicleType         VehicleType?
  fleetName           String?
  latitude            Float
  longitude           Float
  address             String?
  district            String?
  state               String?
  description         String?
  driverName          String?
  driverPhone         String?
  contactPhone        String?
  /// Distance from the nearest covered area centre, in km.
  distanceKm          Float?

  acknowledgedAt     DateTime?
  acknowledgedById   String?   @db.Uuid
  respondingAt       DateTime?
  escalatedAt        DateTime?
  escalationReason   String?
  resolvedAt         DateTime?
  resolvedById       String?   @db.Uuid
  outcome            String?
  assistanceProvided Boolean?
  closedAt           DateTime?

  notifiedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  association AssociationProfile      @relation(fields: [associationId], references: [id], onDelete: Cascade)
  incident    SosIncident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  events      AssociationAlertEvent[]
  responders  AssociationResponder[]

  /// One projection per association per incident.
  @@unique([associationId, incidentId])
  @@index([associationId, status, notifiedAt])
  @@index([incidentId])
  @@index([status, severity, notifiedAt])
  @@map("association_alerts")
}

/// Append-only audit trail of everything the association did about an alert.
model AssociationAlertEvent {
  id          String                    @id @default(uuid()) @db.Uuid
  alertId     String                    @db.Uuid
  eventType   AssociationAlertEventType
  description String?
  actorUserId String?                   @db.Uuid
  metadata    Json?
  createdAt   DateTime                  @default(now())

  alert AssociationAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
  @@map("association_alert_events")
}

/// Whoever the association sent to the scene — a member, or an outside service
/// such as a crane operator or workshop.
model AssociationResponder {
  id      String                     @id @default(uuid()) @db.Uuid
  alertId String                     @db.Uuid
  kind    AssociationResponderKind
  status  AssociationResponderStatus @default(ASSIGNED)

  /// Set when the responder is an association member.
  userId       String? @db.Uuid
  /// Set when the responder is external.
  name         String?
  phone        String?
  organisation String?

  etaMinutes   Int?
  note         String?
  assignedById String?   @db.Uuid
  assignedAt   DateTime  @default(now())
  enRouteAt    DateTime?
  onSceneAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  updatedAt    DateTime  @updatedAt

  alert AssociationAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, status])
  @@index([userId])
  @@map("association_responders")
}

// ===========================================================================
// Service provider profiles (taxi / travel / tour capability)
// ===========================================================================

/// The mobility capability of an organization.
///
/// Deliberately a profile rather than an organization type: a fleet owner who
/// starts running tours adds TRAVEL to `serviceTypes` and keeps one account,
/// one vehicle list and one login. Section 2 of the expansion spec — one
/// platform, one identity — is what makes this the right shape.
model ServiceProviderProfile {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  displayName  String
  serviceTypes ServiceType[]
  about        String?

  contactPhone  String
  contactEmail  String?
  whatsappPhone String?
  logoUrl       String?
  bannerUrl     String?

  businessRegistrationNumber String?
  yearsInBusiness            Int?
  languages                  String[]

  status ProviderStatus @default(ACTIVE)

  /// Rolling aggregates from completed bookings.
  ratingAverage     Float @default(0)
  ratingCount       Int   @default(0)
  bookingsTotal     Int   @default(0)
  bookingsCompleted Int   @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceAreas ProviderServiceArea[]
  packages     TravelPackage[]

  @@index([status])
  @@index([ratingAverage])
  @@map("service_provider_profiles")
}

model ProviderServiceArea {
  id         String @id @default(uuid()) @db.Uuid
  providerId String @db.Uuid

  city      String
  state     String
  latitude  Float
  longitude Float
  radiusKm  Float  @default(150)

  createdAt DateTime @default(now())

  provider ServiceProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([city, state])
  @@index([latitude, longitude])
  @@map("provider_service_areas")
}

// ===========================================================================
// Travel & tour packages
// ===========================================================================

model TravelPackage {
  id             String @id @default(uuid()) @db.Uuid
  providerId     String @db.Uuid
  /// Provider's tenant, duplicated so tenant scoping needs no join.
  organizationId String @db.Uuid

  title       String
  summary     String
  description String?
  serviceKind TravelServiceKind
  imageUrls   String[]

  destinations   String[]
  startLocation  String
  startLatitude  Float
  startLongitude Float
  endLocation    String

  durationDays     Int
  durationNights   Int?
  approxDistanceKm Float?

  vehicleType   VehicleType
  /// A specific vehicle, when the provider sells one particular car.
  vehicleId     String?     @db.Uuid
  minPassengers Int         @default(1)
  maxPassengers Int

  pricingModel PricingModel
  basePrice    Decimal      @db.Decimal(12, 2)

  inclusions         String[]
  exclusions         String[]
  /// [{ hoursBefore, refundPercent }] — empty means the platform default.
  cancellationPolicy Json?

  advanceBookingDays Int       @default(1)
  availableFrom      DateTime?
  availableTo        DateTime?
  /// 0 = Sunday. Empty means the package runs any day.
  availableWeekdays  Int[]

  driverIncluded Boolean @default(true)
  fuelIncluded   Boolean @default(true)

  status TravelPackageStatus @default(DRAFT)

  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)
  bookingCount  Int   @default(0)
  viewCount     Int   @default(0)

  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Set when the operator minted this package by winning a customer
  /// requirement. Such a package is never PUBLISHED, so it stays out of
  /// customer search and out of the operator's own catalogue listing.
  sourceRequirementId String? @db.Uuid

  provider          ServiceProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  vehicle           Truck?                 @relation("PackageVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  sourceRequirement Requirement?           @relation("RequirementPackage", fields: [sourceRequirementId], references: [id], onDelete: SetNull)
  itinerary         TravelItineraryDay[]
  bookings          TravelBooking[]

  @@index([sourceRequirementId])
  @@index([status, serviceKind])
  @@index([organizationId, status])
  @@index([providerId, status])
  @@index([vehicleType, maxPassengers])
  @@index([basePrice])
  @@index([ratingAverage])
  @@map("travel_packages")
}

model TravelItineraryDay {
  id        String @id @default(uuid()) @db.Uuid
  packageId String @db.Uuid

  dayNumber        Int
  title            String
  description      String?
  highlights       String[]
  overnightAt      String?
  approxDistanceKm Float?

  createdAt DateTime @default(now())

  package TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, dayNumber])
  @@index([packageId])
  @@map("travel_itinerary_days")
}

// ===========================================================================
// Travel bookings
// ===========================================================================

model TravelBooking {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique

  packageId              String  @db.Uuid
  /// Provider's tenant.
  providerOrganizationId String  @db.Uuid
  /// Customer's tenant — the same customer account used for freight orders.
  customerOrganizationId String  @db.Uuid
  customerId             String? @db.Uuid
  bookedByUserId         String  @db.Uuid

  status BookingStatus @default(DRAFT)

  startDate  DateTime
  endDate    DateTime
  passengers Int

  pickupAddress   String?
  pickupLatitude  Float?
  pickupLongitude Float?

  /// Where the party is going, when the customer names it rather than riding
  /// the package's own fixed route. This is what makes a per-kilometre taxi
  /// bookable: the package prices the kilometre, the booking says how many.
  dropoffAddress   String?
  dropoffLatitude  Float?
  dropoffLongitude Float?
  /// Pickup to drop-off, measured when the booking was taken. Stored rather
  /// than recomputed because it is what the fare was quoted on, and a later
  /// change to either point must not silently restate the agreed price.
  distanceKm       Float?

  contactName     String
  contactPhone    String
  contactEmail    String?
  specialRequests String?

  /// Snapshot of the price at booking time. A later package price change must
  /// not silently alter what the customer agreed to pay.
  pricingModel   PricingModel
  subtotal       Decimal      @db.Decimal(12, 2)
  platformFee    Decimal      @db.Decimal(12, 2)
  totalAmount    Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  priceBreakdown String?

  /// Assigned by the provider on confirmation.
  vehicleId String? @db.Uuid
  driverId  String? @db.Uuid
  /// The trip that carries this booking, so travel reuses live tracking.
  tripId    String? @unique @db.Uuid

  confirmedAt   DateTime?
  confirmedById String?   @db.Uuid
  declinedAt    DateTime?
  declineReason String?
  startedAt     DateTime?
  completedAt   DateTime?

  cancelledAt        DateTime?
  cancelledBy        CancelledBy?
  cancellationReason String?
  refundAmount       Decimal?     @db.Decimal(12, 2)
  refundedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package     TravelPackage        @relation(fields: [packageId], references: [id])
  vehicle     Truck?               @relation("BookingVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  trip        Trip?                @relation("BookingTrip", fields: [tripId], references: [id])
  events      TravelBookingEvent[]
  payments    Payment[]
  review      TravelReview?
  /// Set when the booking came from awarding a travel bid rather than from
  /// the customer booking a published package.
  requirement Requirement?         @relation("RequirementBooking")

  @@index([customerOrganizationId, status, startDate])
  @@index([providerOrganizationId, status, startDate])
  @@index([packageId, startDate])
  @@index([status, startDate])
  @@index([driverId])
  @@map("travel_bookings")
}

model TravelBookingEvent {
  id          String           @id @default(uuid()) @db.Uuid
  bookingId   String           @db.Uuid
  eventType   BookingEventType
  description String?
  actorUserId String?          @db.Uuid
  metadata    Json?
  createdAt   DateTime         @default(now())

  booking TravelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("travel_booking_events")
}

model TravelReview {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @unique @db.Uuid

  providerOrganizationId String @db.Uuid
  packageId              String @db.Uuid

  rating        Int
  vehicleRating Int?
  driverRating  Int?
  comment       String?

  ratedByUserId String   @db.Uuid
  createdAt     DateTime @default(now())

  booking TravelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([providerOrganizationId, createdAt])
  @@index([packageId])
  @@map("travel_reviews")
}

// ===========================================================================
// Payments
// ===========================================================================

/// A payment attempt against a Saarthi entity.
///
/// The gateway is abstracted behind `PaymentProvider`; locally the mock
/// provider settles instantly. No card or UPI credential is ever stored — only
/// the provider's own reference — so swapping in a real gateway does not turn
/// this table into cardholder data.
model Payment {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique

  purpose PaymentPurpose
  status  PaymentStatus  @default(PENDING)
  method  PaymentMethod  @default(MOCK)

  /// Payer's tenant.
  organizationId    String @db.Uuid
  initiatedByUserId String @db.Uuid

  bookingId String? @db.Uuid
  orderId   String? @db.Uuid

  amount         Decimal @db.Decimal(12, 2)
  currency       String  @default("INR")
  /// Amount returned so far; may be partial.
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)

  /// Which implementation handled this, e.g. `mock`.
  provider          String
  providerReference String?
  /// Provider-supplied failure code and message, kept verbatim for support.
  failureCode       String?
  failureMessage    String?

  processedAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking TravelBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([bookingId])
  @@index([status, createdAt])
  @@map("payments")
}

// ===========================================================================
// Hardware devices
// ===========================================================================

/// A physical telematics unit.
///
/// The device is not the vehicle. It is owned by an organization, may move
/// between vehicles over its life, and authenticates as itself — see
/// `device_assignments` for the vehicle relationship and its history.
model HardwareDevice {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  /// Identifier printed on the unit; what the device sends to the gateway.
  deviceIdentifier String         @unique
  provider         DeviceProvider
  deviceType       DeviceType     @default(OBD_TELEMATICS)

  serialNumber    String
  /// Sensitive. Never returned in a list response.
  imei            String? @unique
  manufacturer    String?
  model           String?
  firmwareVersion String?

  /// SIM identifiers are sensitive: an ICCID is enough to social-engineer a
  /// SIM swap. Stored for support, returned masked, and only to callers with
  /// the device-management permission.
  simIccid    String?
  simMsisdn   String?
  simOperator String?

  /// bcrypt hash of the device secret. The plaintext is shown exactly once, at
  /// registration and rotation, and is not recoverable afterwards.
  secretHash      String
  secretRotatedAt DateTime?
  /// Highest sequence number accepted, for replay rejection.
  lastSequence    Int?

  status DeviceStatus @default(REGISTERED)

  /// What this unit does on a vehicle. Only one TELEMETRY device may be fitted
  /// to a vehicle at a time; CAMERA and AUXILIARY units are unrestricted.
  role DeviceRole @default(TELEMETRY)

  /// Incremented on every credential change — rotation, suspension, retirement,
  /// unpairing. Device access tokens carry the version they were issued under,
  /// so raising this revokes every outstanding token immediately.
  credentialVersion Int @default(1)

  /// True when the unit registered itself through the enrolment endpoint rather
  /// than being provisioned by a platform administrator.
  selfEnrolled Boolean @default(false)

  // --- Client-reported identity -------------------------------------------
  //
  // Populated by app-based devices. A Freematics reports none of this, so every
  // column is nullable and the UI treats absence as "not applicable" rather
  // than as data that went missing.
  platform    String?
  deviceModel String?
  osVersion   String?
  appVersion  String?

  // --- Client-reported health (device specification section 29) ------------
  lastHeartbeatAt DateTime?
  batteryPercent  Int?
  batteryCharging Boolean?
  networkType     DeviceNetworkType?
  gpsStatus       DeviceSubsystemStatus?
  cameraStatus    DeviceSubsystemStatus?
  /// Events the device said it was still holding locally at its last heartbeat.
  bufferedEvents  Int?

  /// Reporting cadence Saarthi has asked this unit to use, in seconds.
  reportingIntervalSeconds Int?

  /// Metrics this unit is expected to report. The union actually observed is
  /// tracked separately, because what a device *can* do and what a given
  /// vehicle exposes are different questions.
  supportedMetrics String[]
  observedMetrics  String[]

  lastSeenAt      DateTime?
  lastTelemetryAt DateTime?
  readingCount    Int       @default(0)
  rejectedCount   Int       @default(0)

  notes         String?
  installedAt   DateTime?
  activatedAt   DateTime?
  deactivatedAt DateTime?
  archivedAt    DateTime?
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments      DeviceAssignment[]
  events           DeviceEvent[]
  readings         TelemetryReading[]
  alerts           TelemetryAlert[]
  mockRuns         MockDeviceRun[]
  cameras          DeviceCamera[]
  commands         DeviceCommand[]
  pairingTokens    DevicePairingToken[]
  enrolment        DeviceEnrolment?
  sosIncidents     SosIncident[]
  terminalSessions TerminalSession[]     @relation("TerminalDeviceSessions")
  terminalIssues   TerminalIssueReport[] @relation("TerminalDeviceIssues")

  @@index([organizationId, status])
  @@index([provider, status])
  @@index([lastSeenAt])
  @@index([organizationId, archivedAt])
  @@map("hardware_devices")
}

/// A device identity that exists before it belongs to anyone.
///
/// Self-enrolment has to produce a usable credential — the app shows its device
/// id on first launch, and it needs to authenticate the pairing call — but it
/// must not create a row inside somebody's fleet before an authorised person
/// has approved it. So enrolment lands here: a real identifier and a real
/// secret, with no organization, no vehicle and nothing reachable. Redeeming a
/// pairing token promotes it into a HardwareDevice; never redeeming it means
/// the sweep removes it, so an anonymous endpoint cannot grow the database
/// without bound.
model DeviceEnrolment {
  id String @id @default(uuid()) @db.Uuid

  /// Random per-installation identity the app generates and keeps in secure
  /// storage. Deliberately not derived from ANDROID_ID or an IMEI: those are
  /// spoofable and survive a factory reset.
  installationId String @unique

  /// The identifier Saarthi issues, carried unchanged onto the device row.
  deviceIdentifier String @unique

  /// bcrypt hash. The plaintext is returned once, at enrolment.
  secretHash String

  deviceType  DeviceType @default(MOBILE_TEST_DEVICE)
  platform    String
  deviceModel String?
  osVersion   String?
  appVersion  String?

  status    DeviceEnrolmentStatus @default(PENDING)
  claimedAt DateTime?

  /// Set when the enrolment is promoted; kept afterwards for provenance.
  deviceId String? @unique @db.Uuid

  /// Retained only for abuse investigation on an unauthenticated endpoint.
  ipAddress String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device HardwareDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@map("device_enrolments")
}

/// A short-lived capability to join one vehicle.
///
/// Issued by an authorised person in the web dashboard and rendered as a QR. The
/// printed artefact carries only the opaque token — never the vehicle, the
/// driver or anything commercial — because a QR on a screen is photographed by
/// whoever walks past, and everything the pairing discloses is decided
/// server-side at redemption time.
model DevicePairingToken {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  vehicleId      String @db.Uuid

  /// SHA-256 of the token. A pairing credential stored in plaintext is a
  /// credential in every backup of that database.
  tokenHash String @unique

  /// What kind of unit this token expects, so a phone cannot take a slot
  /// reserved for a fitted recorder.
  deviceType DeviceType @default(MOBILE_TEST_DEVICE)

  /// Human-typeable form of this credential, e.g. `STH-4K2P-9XQ7`.
  ///
  /// Populated only for Saarthi Terminal codes. A terminal is a tablet bolted
  /// to a truck, sometimes with a cracked digitiser and always in bad light, so
  /// it has to be pairable without a working camera — and reading a
  /// 43-character base64url token aloud over a phone is not a plan.
  ///
  /// It is the same single-use credential as `tokenHash`, in a shorter
  /// alphabet: eight Crockford base32 characters, which is a smaller space than
  /// the raw token but is protected by the same five-minute life, the same
  /// single-use consumption, the same tenant check at redemption and a hard
  /// per-device rate limit on the redeem endpoint. Null for every other kind of
  /// device, which is why it is nullable rather than defaulted.
  pairingCode String? @unique

  createdById String   @db.Uuid
  note        String?
  expiresAt   DateTime

  /// Single-use. Both columns are written in the same transaction as the
  /// assignment they create.
  consumedAt         DateTime?
  consumedByDeviceId String?   @db.Uuid

  revokedAt   DateTime?
  revokedById String?   @db.Uuid

  createdAt DateTime @default(now())

  vehicle          Truck           @relation("VehiclePairingTokens", fields: [vehicleId], references: [id], onDelete: Cascade)
  consumedByDevice HardwareDevice? @relation(fields: [consumedByDeviceId], references: [id], onDelete: SetNull)

  @@index([vehicleId, expiresAt])
  @@index([organizationId, createdAt])
  @@map("device_pairing_tokens")
}

/// An instruction addressed to one device.
///
/// Redis carries the command to a connected unit within milliseconds; this row
/// is the durable record of what was asked, by whom, and whether it was ever
/// acknowledged. A camera that was told to start and never confirmed is a
/// different situation from one that was never told, and only a stored record
/// can tell them apart afterwards.
model DeviceCommand {
  id             String @id @default(uuid()) @db.Uuid
  deviceId       String @db.Uuid
  organizationId String @db.Uuid

  type    DeviceCommandType
  payload Json?

  status DeviceCommandStatus @default(PENDING)

  issuedById  String    @db.Uuid
  issuedAt    DateTime  @default(now())
  deliveredAt DateTime?
  ackedAt     DateTime?
  expiresAt   DateTime

  /// Whatever the device reported back, and why it failed if it did.
  result Json?
  error  String?

  device HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status, issuedAt])
  @@index([organizationId, issuedAt])
  @@index([status, expiresAt])
  @@map("device_commands")
}

/// Device-to-vehicle assignment history.
///
/// A device is never hard-wired into a vehicle row. Swapping a failed unit
/// closes one assignment and opens another, and the vehicle keeps both — so
/// telemetry recorded last January still resolves to the device that produced
/// it, not to whatever is fitted today.
model DeviceAssignment {
  id             String @id @default(uuid()) @db.Uuid
  deviceId       String @db.Uuid
  vehicleId      String @db.Uuid
  organizationId String @db.Uuid

  status DeviceAssignmentStatus @default(ACTIVE)

  assignedById   String?   @db.Uuid
  assignedAt     DateTime  @default(now())
  installedAt    DateTime?
  unassignedAt   DateTime?
  unassignedById String?   @db.Uuid
  note           String?
  removalReason  String?

  device  HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicle Truck          @relation("VehicleDeviceAssignments", fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@index([vehicleId, status])
  @@index([organizationId, assignedAt])
  @@map("device_assignments")
}

model DeviceEvent {
  id             String          @id @default(uuid()) @db.Uuid
  deviceId       String          @db.Uuid
  organizationId String          @db.Uuid
  eventType      DeviceEventType
  description    String?
  metadata       Json?
  actorUserId    String?         @db.Uuid
  createdAt      DateTime        @default(now())

  device HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@index([organizationId, createdAt])
  @@map("device_events")
}

// ===========================================================================
// Telemetry
// ===========================================================================

/// A normalised telemetry reading. High-volume, append-only.
///
/// `metrics` lists which columns this reading genuinely carries. A consumer
/// must check it before rendering a value: "0 rpm" and "this vehicle does not
/// report rpm" mean different things, and only this column can tell them apart.
model TelemetryReading {
  id             String  @id @default(uuid()) @db.Uuid
  deviceId       String  @db.Uuid
  vehicleId      String  @db.Uuid
  organizationId String  @db.Uuid
  /// Denormalised from the vehicle at ingest, so driver-behaviour queries and
  /// score attribution do not need a point-in-time assignment lookup.
  driverId       String? @db.Uuid
  tripId         String? @db.Uuid

  /// Which of the columns below are present. Values from `TelemetryMetric`.
  metrics String[]

  /// Location
  latitude   Float?
  longitude  Float?
  speedKph   Float?
  heading    Float?
  altitude   Float?
  accuracy   Float?
  satellites Int?

  /// Vehicle
  rpm                Float?
  engineLoad         Float?
  coolantTemperature Float?
  intakeTemperature  Float?
  fuelLevel          Float?
  fuelRate           Float?
  throttlePosition   Float?
  batteryVoltage     Float?
  odometerKm         Float?
  vin                String?

  /// Motion
  accelerationX     Float?
  accelerationY     Float?
  accelerationZ     Float?
  harshBraking      Boolean @default(false)
  harshAcceleration Boolean @default(false)
  suddenMovement    Boolean @default(false)

  /// Device health
  deviceTemperature Float?
  signalStrength    Float?

  /// True when produced by the simulator. Never conflated with real hardware.
  simulated  Boolean @default(false)
  sequence   Int?
  /// Untouched vendor payload, retained for adapter debugging.
  rawPayload Json?

  /// Metrics in this reading that were produced by a simulator, not measured.
  ///
  /// Always a subset of `metrics`. A phone is not uniformly real or uniformly
  /// fake: its GPS fix and its accelerometer are genuine measurements of a
  /// genuine vehicle, while its RPM and coolant temperature come from an
  /// on-device simulator because a phone has no access to the engine. The
  /// `simulated` boolean below cannot express that — setting it would brand a
  /// real position as fabricated, and leaving it clear would present an invented
  /// temperature as a measurement — so the honesty is recorded per metric.
  simulatedMetrics String[]

  /// Idempotency key generated by the device before the event was buffered.
  ///
  /// A phone that uploads a batch, times out and retries must not double-write
  /// its own history. The sequence counter cannot express that on its own — an
  /// offline buffer is retried as a whole — so an app-based device stamps every
  /// event once and the unique index below makes the retry harmless. Null for
  /// firmware that has no such concept, which is why it is not part of the
  /// primary key.
  clientEventId String?

  /// When the device observed it.
  recordedAt DateTime
  /// When Saarthi accepted it. The gap is the ingestion delay.
  receivedAt DateTime @default(now())

  device      HardwareDevice            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicle     Truck                     @relation("VehicleTelemetry", fields: [vehicleId], references: [id], onDelete: Cascade)
  diagnostics TelemetryDiagnosticCode[]

  @@unique([deviceId, clientEventId])
  @@index([vehicleId, recordedAt])
  @@index([deviceId, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([tripId, recordedAt])
  @@index([driverId, recordedAt])
  @@map("telemetry_readings")
}

/// A diagnostic trouble code reported with a reading.
model TelemetryDiagnosticCode {
  id             String @id @default(uuid()) @db.Uuid
  readingId      String @db.Uuid
  vehicleId      String @db.Uuid
  organizationId String @db.Uuid

  code        String
  description String?
  confirmed   Boolean   @default(false)
  /// Set when an operator marks the fault dealt with.
  clearedAt   DateTime?
  createdAt   DateTime  @default(now())

  reading TelemetryReading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@index([organizationId, code])
  @@map("telemetry_diagnostic_codes")
}

/// A fired telemetry rule.
model TelemetryAlert {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String  @db.Uuid
  deviceId       String? @db.Uuid
  driverId       String? @db.Uuid
  tripId         String? @db.Uuid
  readingId      String? @db.Uuid

  type     TelemetryAlertType
  severity AlertSeverity
  status   TelemetryAlertStatus @default(OPEN)

  /// Human-readable, and phrased so a driver can see why it fired.
  message       String
  observedValue Float?
  threshold     Float?
  unit          String?
  latitude      Float?
  longitude     Float?

  acknowledgedAt   DateTime?
  acknowledgedById String?   @db.Uuid
  resolvedAt       DateTime?
  resolvedById     String?   @db.Uuid
  note             String?

  /// Set when this alert produced a driver-score event, so the score screen can
  /// link the deduction back to the evidence.
  scoreEventId String? @db.Uuid

  occurredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  device  HardwareDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  vehicle Truck           @relation("VehicleTelemetryAlerts", fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, occurredAt])
  @@index([vehicleId, occurredAt])
  @@index([driverId, type, occurredAt])
  @@index([type, severity, occurredAt])
  @@map("telemetry_alerts")
}

/// Per-organization (optionally per-vehicle) tuning of an alert rule. A missing
/// row means the shared default from `domain/telemetry.ts` applies.
model TelemetryAlertRule {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  /// Null = applies to every vehicle in the organization.
  vehicleId      String? @db.Uuid

  type            TelemetryAlertType
  enabled         Boolean            @default(true)
  threshold       Float?
  severity        AlertSeverity?
  cooldownSeconds Int?

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, vehicleId, type])
  @@index([organizationId, enabled])
  @@map("telemetry_alert_rules")
}

/// A monitored area. Breaching one raises a GEOFENCE_BREACH alert.
model Geofence {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String? @db.Uuid

  name         String
  kind         GeofenceKind @default(INCLUSION)
  latitude     Float
  longitude    Float
  radiusMeters Int
  enabled      Boolean      @default(true)
  notes        String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId, enabled])
  @@index([vehicleId])
  @@map("geofences")
}

/// State of a mock-device run.
///
/// Persisted rather than held in memory so a restart cannot leave a simulator
/// apparently running with nothing behind it, which is exactly the kind of
/// phantom state that makes a demo unexplainable.
model MockDeviceRun {
  id             String @id @default(uuid()) @db.Uuid
  deviceId       String @db.Uuid
  organizationId String @db.Uuid

  status          SimulationStatus   @default(IDLE)
  scenario        MockDeviceScenario @default(NORMAL)
  intervalSeconds Int                @default(5)
  maxReadings     Int?
  readingsSent    Int                @default(0)

  /// Simulated vehicle state, carried between ticks.
  lastLatitude   Float?
  lastLongitude  Float?
  lastHeading    Float?
  lastSpeedKph   Float?
  lastFuelLevel  Float?
  lastOdometerKm Float?

  startedById String?   @db.Uuid
  startedAt   DateTime?
  stoppedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  device HardwareDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@index([status])
  @@map("mock_device_runs")
}

