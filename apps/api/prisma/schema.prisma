enum SosType {
  MEDICAL
  ACCIDENT
  BREAKDOWN
  TYRE
  FUEL
  SECURITY
  OTHER
}

enum SosStatus {
  TRIGGERED
  BROADCASTING
  ACKNOWLEDGED
  HELP_ASSIGNED
  ASSISTANCE_ARRIVED
  RESOLVED
  CANCELLED
}

enum SosResponderStatus {
  NOTIFIED
  ACKNOWLEDGED
  ASSIGNED
  DECLINED
  ARRIVED
  COMPLETED
}

enum SosEventType {
  TRIGGERED
  BROADCAST_STARTED
  RESPONDER_NOTIFIED
  RESPONDER_ACKNOWLEDGED
  RESPONDER_DECLINED
  HELP_ASSIGNED
  ASSISTANCE_ARRIVED
  RADIUS_EXPANDED
  RESOLVED
  CANCELLED
  NOTE
}

enum NearbyCategory {
  FUEL
  FOOD
  PARKING
  WORKSHOP
  TYRE_SHOP
  HOSPITAL
  PHARMACY
  POLICE
  REST_AREA
  CHARGING
  WEIGHBRIDGE
  OTHER
