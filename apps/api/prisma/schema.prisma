model SosIncident {
  id             String  @id @default(uuid()) @db.Uuid
  reference      String  @unique
  organizationId String  @db.Uuid
  driverId       String? @db.Uuid
  truckId        String? @db.Uuid
  tripId         String? @db.Uuid

  /// The person who raised it.
  ///
  /// Nullable because a device can raise one. When a phone bolted to a
  /// windscreen presses SOS there may be no signed-in human on the other end,
  /// and recording the driver's user as the trigger would be a claim about who
  /// acted that nobody verified.
  triggeredByUserId String? @db.Uuid

  /// The device that raised it, when it was not a person.
  triggeredByDeviceId String? @db.Uuid

  type               SosType
  status             SosStatus @default(TRIGGERED)
  latitude           Float
  longitude          Float
  address            String?
  description        String?
  /// Current broadcast radius in metres; expands when nobody responds.
  searchRadiusMeters Int       @default(5000)
  contactPhone       String?

  acknowledgedAt   DateTime?
  assignedAt       DateTime?
  arrivedAt        DateTime?
  resolvedAt       DateTime?
  resolvedByUserId String?   @db.Uuid
  resolutionNote   String?

  triggeredAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responders        SosResponder[]
  events            SosEvent[]
  associationAlerts AssociationAlert[]

  triggeredByDevice HardwareDevice? @relation(fields: [triggeredByDeviceId], references: [id], onDelete: SetNull)

  @@index([triggeredByDeviceId])
  @@index([organizationId, status, triggeredAt])
  @@index([status, triggeredAt])
  @@index([driverId])
  @@index([tripId])
  @@map("sos_incidents")
}

