model SosIncident {
  id                String  @id @default(uuid()) @db.Uuid
  reference         String  @unique
  organizationId    String  @db.Uuid
  driverId          String? @db.Uuid
  truckId           String? @db.Uuid
  tripId            String? @db.Uuid
  triggeredByUserId String  @db.Uuid

  type               SosType
  status             SosStatus @default(TRIGGERED)
  latitude           Float
  longitude          Float
  address            String?
  description        String?
  /// Current broadcast radius in metres; expands when nobody responds.
  searchRadiusMeters Int       @default(5000)
  contactPhone       String?

  acknowledgedAt   DateTime?
  assignedAt       DateTime?
  arrivedAt        DateTime?
  resolvedAt       DateTime?
  resolvedByUserId String?   @db.Uuid
  resolutionNote   String?

  triggeredAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responders        SosResponder[]
  events            SosEvent[]
  associationAlerts AssociationAlert[]

  @@index([organizationId, status, triggeredAt])
  @@index([status, triggeredAt])
  @@index([driverId])
  @@index([tripId])
  @@map("sos_incidents")
}

model SosResponder {
  id             String             @id @default(uuid()) @db.Uuid
  incidentId     String             @db.Uuid
  truckId        String             @db.Uuid
  driverId       String             @db.Uuid
  organizationId String             @db.Uuid
  distanceKm     Float
  status         SosResponderStatus @default(NOTIFIED)
  notifiedAt     DateTime           @default(now())
  acknowledgedAt DateTime?
  declinedAt     DateTime?
  arrivedAt      DateTime?
  completedAt    DateTime?
  note           String?

  incident SosIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, truckId])
  @@index([incidentId, status])
  @@index([driverId, status])
  @@map("sos_responders")
}

model SosEvent {
  id          String       @id @default(uuid()) @db.Uuid
  incidentId  String       @db.Uuid
  eventType   SosEventType
  description String?
  actorUserId String?      @db.Uuid
  metadata    Json?
  createdAt   DateTime     @default(now())

  incident SosIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("sos_events")
}

// ===========================================================================
// Nearby services (local POI dataset; replaced by a map provider in production)
// ===========================================================================

model NearbyPlace {
  id          String         @id @default(uuid()) @db.Uuid
  /// Stable id from the source provider, used for idempotent imports.
  externalId  String?
  category    NearbyCategory
  name        String
  address     String?
  city        String?
  state       String?
  latitude    Float
  longitude   Float
  phone       String?
  /// Free-form provider attributes: opening hours, amenities, fuel brands.
  attributes  Json?
  rating      Float?
  open24Hours Boolean        @default(false)
  source      String         @default("local")
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([source, externalId])
  @@index([category, active])
  @@index([latitude, longitude])
  @@map("nearby_places")
}

/// Petrol / CNG station directory mirrored from the external provider.
///
/// The provider remains the source of truth. This table is a cache that keeps
/// the map responsive, survives a provider outage, and lets a mapping fix be
/// replayed from `rawData` without re-billing the directory.
model PetrolStation {
  id            String   @id @default(uuid()) @db.Uuid
  /// Directory the record came from, e.g. `ssr`.
  source        String   @default("ssr")
  /// The provider's own station id — with `source` it makes imports idempotent.
  externalId    String
  name          String?
  company       String?
  latitude      Float
  longitude     Float
  address       String?
  city          String?
  district      String?
  state         String?
  /// The directory lists this fuel as sold here — NOT live availability.
  hasPetrol     Boolean?
  hasDiesel     Boolean?
  hasCng        Boolean?
  /// Published rate, INR per litre (CNG: per kg). Null when not listed.
  petrolPrice   Float?
  dieselPrice   Float?
  cngPrice      Float?
  timings       String?
  directionsUrl String?
  /// Untouched provider payload, kept for replay and debugging.
  rawData       Json?
  refreshedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([source, externalId])
  @@index([latitude, longitude])
  @@index([city])
  @@index([company])
  @@map("petrol_stations")
}

// ===========================================================================
// Vehicle registration (RC) lookups
// ===========================================================================

/// Cached vehicle RC lookups.
///
/// Rows hold personal data from the RTO record, so every one carries an
/// explicit `expiresAt` and is deleted by the retention sweep. Nothing here is
/// kept indefinitely and nothing here is the only copy of a fact.
model VehicleLookup {
  id                 String   @id @default(uuid()) @db.Uuid
  /// Normalised plate, e.g. UP32AB1234 — the cache key.
  registrationNumber String
  /// Tenant the lookup was performed for; scopes every subsequent read.
  organizationId     String?  @db.Uuid
  requestedById      String?  @db.Uuid
  provider           String   @default("way2api")
  /// The provider's order id, for support tickets and billing queries.
  providerReference  String?
  /// Saarthi's normalised RC record, before per-caller redaction.
  responseData       Json
  /// Storage key of the RC PDF Saarthi downloaded and stored itself.
  pdfStorageKey      String?
  pdfFileName        String?
  pdfMimeType        String?
  pdfSize            Int?
  fetchedAt          DateTime @default(now())
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([registrationNumber, expiresAt])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
  @@map("vehicle_lookups")
}

