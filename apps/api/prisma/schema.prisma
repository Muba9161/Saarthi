/// Petrol / CNG station directory mirrored from the external provider.
///
/// The provider remains the source of truth. This table is a cache that keeps
/// the map responsive, survives a provider outage, and lets a mapping fix be
/// replayed from `rawData` without re-billing the directory.
model PetrolStation {
  id            String   @id @default(uuid()) @db.Uuid
  /// Directory the record came from, e.g. `ssr`.
  source        String   @default("ssr")
  /// The provider's own station id — with `source` it makes imports idempotent.
  externalId    String
  name          String?
  company       String?
  latitude      Float
  longitude     Float
  address       String?
  city          String?
  district      String?
  state         String?
  /// The directory lists this fuel as sold here — NOT live availability.
  hasPetrol     Boolean?
  hasDiesel     Boolean?
  hasCng        Boolean?
  /// Published rate, INR per litre (CNG: per kg). Null when not listed.
  petrolPrice   Float?
  dieselPrice   Float?
  cngPrice      Float?
  timings       String?
  directionsUrl String?
  /// Untouched provider payload, kept for replay and debugging.
  rawData       Json?
  refreshedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([source, externalId])
  @@index([latitude, longitude])
  @@index([city])
  @@index([company])
  @@map("petrol_stations")
}

// ===========================================================================
// Vehicle registration (RC) lookups
// ===========================================================================

/// Cached vehicle RC lookups.
///
/// Rows hold personal data from the RTO record, so every one carries an
/// explicit `expiresAt` and is deleted by the retention sweep. Nothing here is
/// kept indefinitely and nothing here is the only copy of a fact.
model VehicleLookup {
  id                 String   @id @default(uuid()) @db.Uuid
  /// Normalised plate, e.g. UP32AB1234 — the cache key.
  registrationNumber String
  /// Tenant the lookup was performed for; scopes every subsequent read.
  organizationId     String?  @db.Uuid
  requestedById      String?  @db.Uuid
  provider           String   @default("way2api")
  /// The provider's order id, for support tickets and billing queries.
  providerReference  String?
  /// Saarthi's normalised RC record, before per-caller redaction.
  responseData       Json
  /// Storage key of the RC PDF Saarthi downloaded and stored itself.
  pdfStorageKey      String?
  pdfFileName        String?
  pdfMimeType        String?
  pdfSize            Int?
  fetchedAt          DateTime @default(now())
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([registrationNumber, expiresAt])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
  @@map("vehicle_lookups")
}

/// Cached driving licence lookups.
///
/// Holds the licence holder's name, parentage and addresses, so like
/// `vehicle_lookups` every row carries an explicit retention boundary and is
/// deleted by the sweep rather than kept indefinitely.
model LicenceLookup {
  id                String   @id @default(uuid()) @db.Uuid
  /// Normalised licence number, e.g. MH0320140001234 — the cache key.
  licenceNumber     String
  /// The driver this licence belongs to, when it matches one on the platform.
  driverId          String?  @db.Uuid
  organizationId    String?  @db.Uuid
  requestedById     String?  @db.Uuid
  provider          String   @default("way2api")
  providerReference String?
  /// Saarthi's normalised licence record, before per-caller redaction.
  responseData      Json
  fetchedAt         DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([licenceNumber, expiresAt])
  @@index([organizationId, createdAt])
  @@index([driverId])
  @@index([fetchedAt])
  @@map("licence_lookups")
}

