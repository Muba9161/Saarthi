}

model OrganizationProfile {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @unique @db.Uuid
  tagline        String?
  about          String?
  foundedYear    Int?
  employeeCount  Int?
  website        String?
  socialLinks    Json?

  /// Cities and districts served. Read by discovery and last-mile matching.
  serviceAreas   String[]
  specialities   String[]
  certifications String[]
  operatingHours Json?

  supportEmail        String?
  supportPhone        String?
  billingContactName  String?
  billingContactPhone String?
  billingEmail        String?

  visibility      ProfileVisibility @default(PLATFORM)
  fieldVisibility Json?
  publicSlug      String?           @unique

  completionPercent Int       @default(0)
  completedSections String[]
  lastBuiltAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([completionPercent])
  @@map("organization_profiles")
}

// ===========================================================================
// QR identity
// ===========================================================================

/// A printable capability token for a driver, vehicle or other subject.
///
/// The token is 32 random bytes, deliberately not derived from the subject id,
/// so holding one code tells a scanner nothing about any other.
model QrCode {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String?       @db.Uuid
  subjectType        QrSubjectType
  subjectId          String        @db.Uuid
  token              String        @unique
  version            Int           @default(1)
  status             QrCodeStatus  @default(ACTIVE)
  scopes             QrScope[]
  label              String?
  /// Whether the code resolves without a session.
  ///
  /// The column default stays false because the right answer depends on the
  /// subject and only the service knows it: DRIVER and VEHICLE codes get
  /// printed and fixed to something out in the world, so they are issued
  /// public; a TRIP, ORDER or INVENTORY code is an internal handle and stays
  /// private. See publicResolveDefaultFor() in packages/shared/domain/qr.ts.
  ///
  /// A fleet can close anonymous scanning across every code it has issued,
  /// printed ones included, with allowPublicScans on its QrPrivacyPolicy.
  allowPublicResolve Boolean       @default(false)
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedById        String?       @db.Uuid
  revokeReason       String?
  lastScannedAt      DateTime?
  scanCount          Int           @default(0)
  createdById        String        @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  scans QrScan[]

  @@index([subjectType, subjectId, status])
  @@index([organizationId, status])
  @@map("qr_codes")
}

/// Every resolution attempt, including the failures.
///
/// NOT_FOUND rows are the point: an unguessable token still deserves a record
/// of anyone trying to guess it.
model QrScan {
  id                      String        @id @default(uuid()) @db.Uuid
  qrCodeId                String        @db.Uuid
  scannedByUserId         String?       @db.Uuid
  scannedByOrganizationId String?       @db.Uuid
  purpose                 QrScanPurpose @default(IDENTITY_CHECK)
  result                  QrScanResult
  scopesGranted           QrScope[]
  latitude                Float?
  longitude               Float?
  ipAddress               String?
  userAgent               String?
  note                    String?
  createdAt               DateTime      @default(now())

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
  @@index([scannedByUserId, createdAt])
  @@map("qr_scans")
}

// ===========================================================================
// Return loads (backhaul)
// ===========================================================================

/// A truck declaring where it will be free and where it wants to end up.
model ReturnLoadRequest {
  id             String           @id @default(uuid()) @db.Uuid
  reference      String           @unique
  organizationId String           @db.Uuid
  truckId        String           @db.Uuid
  driverId       String?          @db.Uuid
  outboundTripId String?          @db.Uuid
  status         ReturnLoadStatus @default(OPEN)

  /// Where the truck becomes free — usually the outbound destination.
  originAddress   String
  originLatitude  Float
  originLongitude Float

  /// Where it wants to end up — usually the fleet base.
  destinationAddress   String
  destinationLatitude  Float
  destinationLongitude Float

  availableFrom  DateTime
  availableUntil DateTime

  capacityTons       Float
  truckType          TruckType?
  /// How far off the straight line home the driver will divert, in km.
  detourToleranceKm  Float      @default(50)
  acceptsPartialLoad Boolean    @default(true)
  minimumPrice       Decimal?   @db.Decimal(12, 2)
  autoMatch          Boolean    @default(true)
  notes              String?

  matchedOrderId     String?   @db.Uuid
  createdById        String    @db.Uuid
  cancelledAt        DateTime?
  cancellationReason String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  truck   Truck             @relation(fields: [truckId], references: [id], onDelete: Cascade)
  matches ReturnLoadMatch[]
  orders  Order[]           @relation("OrderReturnLoad")
  trips   Trip[]            @relation("TripReturnLoad")

  @@index([status, availableFrom])
  @@index([organizationId, status])
  @@index([truckId, status])
  @@index([originLatitude, originLongitude])
  @@map("return_load_requests")
}

/// One scored pairing of a return-load request with an open order.
///
/// The component values are stored, not just the total, so the UI can explain
/// the ranking. A dispatcher who cannot see why a match scored 78 will not
/// trust it, and an untrusted match is never used.
model ReturnLoadMatch {
  id                  String                @id @default(uuid()) @db.Uuid
  returnLoadRequestId String                @db.Uuid
  orderId             String                @db.Uuid
  status              ReturnLoadMatchStatus @default(SUGGESTED)
  score               Float
  distanceToPickupKm  Float
  detourKm            Float
  /// Cosine of the bearing agreement with the way home, -1..1.
  directionAlignment  Float
  capacityFitPercent  Float
  timingFitHours      Float
  estimatedRevenue    Decimal?              @db.Decimal(12, 2)
  /// Human-readable reasons, rendered verbatim by the UI.
  reasons             String[]
  quoteId             String?               @db.Uuid
  notifiedAt          DateTime?
  respondedAt         DateTime?
  rejectionReason     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  request ReturnLoadRequest @relation(fields: [returnLoadRequestId], references: [id], onDelete: Cascade)
  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([returnLoadRequestId, orderId])
  @@index([orderId, status])
  @@index([status, score])
  @@map("return_load_matches")
}

// ===========================================================================
// City access restrictions
// ===========================================================================

/// A rule that stops some vehicles reaching some places at some times.
///
/// A null organizationId is a platform-maintained national rule; a set one is a
/// fleet's own private rule.
model CityAccessRestriction {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String?             @db.Uuid
  name           String
  description    String?
  kind           CityRestrictionKind
  city           String
  district       String?
  state          String

  /// Zone as a centre plus radius, or an explicit ring when one is known.
  centerLatitude  Float
  centerLongitude Float
  radiusKm        Float?
  polygon         Json?

  /// Which vehicles the rule bites. Empty = every goods vehicle.
  vehicleTypes    VehicleType[]
  truckTypes      TruckType[]
  minCapacityTons Float?
  maxHeightMetres Float?
  maxAxles        Int?

  /// 0 = Sunday .. 6 = Saturday. Empty = every day.
  daysOfWeek       Int[]
  /// Minutes from local midnight. A window may cross midnight (start > end).
  startTimeMinutes Int?
  endTimeMinutes   Int?

  permitAuthority String?
  permitUrl       String?
  penaltyNote     String?
  source          String?
  sourceUrl       String?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  active          Boolean   @default(true)
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  relays RelayDelivery[]

  @@index([city, state, active])
  @@index([centerLatitude, centerLongitude])
  @@index([organizationId, active])
  @@map("city_access_restrictions")
}

// ===========================================================================
// Last-mile relay
// ===========================================================================

/// A yard outside a restricted zone where a big truck hands over to a pickup.
model TransferHub {
  id             String  @id @default(uuid()) @db.Uuid
  /// Null = platform-operated hub, available to every fleet.
  organizationId String? @db.Uuid
  name           String
  code           String  @unique
  addressLine    String
  city           String
  state          String
  postalCode     String?
  latitude       Float
  longitude      Float

  /// forklift, crane, covered, weighbridge, security, overnightParking.
  facilities             Json?
  maxVehicleLengthMetres Float?
  parkingSlots           Int?
  openFromMinutes        Int?
  openToMinutes          Int?
  contactName            String?
  contactPhone           String?
  handlingChargePerTon   Decimal? @db.Decimal(10, 2)
  verified               Boolean  @default(false)
  active                 Boolean  @default(true)
  notes                  String?
  createdById            String?  @db.Uuid
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  relays RelayDelivery[]

  @@index([city, state, active])
  @@index([latitude, longitude])
  @@map("transfer_hubs")
}

/// An operator that delivers inside a city with small vehicles.
model LastMilePartner {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  serviceCities  String[]
  maxWeightTons  Float    @default(1.5)
  vehicleCount   Int      @default(0)
  minimumCharge  Decimal  @db.Decimal(10, 2)
  perKmRate      Decimal  @db.Decimal(10, 2)
  perTonRate     Decimal? @db.Decimal(10, 2)

  handlesFragile      Boolean @default(false)
  handlesRefrigerated Boolean @default(false)
  openFromMinutes     Int?
  openToMinutes       Int?

  averageResponseMinutes Int?
  completedRelays        Int                @default(0)
  rating                 Float?
  ratingCount            Int                @default(0)
  active                 Boolean            @default(true)
  verificationStatus     VerificationStatus @default(PENDING)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([active, verificationStatus])
  @@map("last_mile_partners")
}

/// The city leg of a delivery a heavy vehicle cannot complete itself.
model RelayDelivery {
  id               String      @id @default(uuid()) @db.Uuid
  reference        String      @unique
  orderId          String      @db.Uuid
  /// Fleet tenant that owns the parent movement.
  organizationId   String      @db.Uuid
  parentTripId     String?     @db.Uuid
  transferHubId    String?     @db.Uuid
  /// Set when the handover happens at a supplier yard rather than a hub.
  originLocationId String?     @db.Uuid
  status           RelayStatus @default(DRAFT)
  reason           RelayReason
  restrictionId    String?     @db.Uuid

  partnerOrganizationId String? @db.Uuid
  pickupVehicleId       String? @db.Uuid
  pickupDriverId        String? @db.Uuid
  relayTripId           String? @db.Uuid

  quantity     Float
  unit         MaterialUnit
  weightTons   Float?
  packageCount Int?
  fragile      Boolean      @default(false)

  dropAddress    String
  dropLatitude   Float
  dropLongitude  Float
  distanceKm     Float?
  price          Decimal? @db.Decimal(12, 2)
  handlingCharge Decimal? @db.Decimal(10, 2)

  requestedAt          DateTime?
  scheduledAt          DateTime?
  hubArrivalAt         DateTime?
  handoverAt           DateTime?
  /// The scan that proved custody actually changed hands.
  handoverQrScanId     String?   @db.Uuid
  handoverPackageCount Int?
  handoverWeightTons   Float?
  discrepancyNote      String?
  departedAt           DateTime?
  deliveredAt          DateTime?
  failureReason        String?
  cancelledAt          DateTime?
  notes                String?
  createdById          String    @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  hub            TransferHub?           @relation(fields: [transferHubId], references: [id], onDelete: SetNull)
  originLocation InventoryLocation?     @relation("RelayOriginLocation", fields: [originLocationId], references: [id], onDelete: SetNull)
  restriction    CityAccessRestriction? @relation(fields: [restrictionId], references: [id], onDelete: SetNull)
  offers         RelayOffer[]
  events         RelayEvent[]

  @@index([orderId])
  @@index([organizationId, status])
  @@index([partnerOrganizationId, status])
  @@index([status, scheduledAt])
  @@map("relay_deliveries")
}

model RelayOffer {
  id             String           @id @default(uuid()) @db.Uuid
  relayId        String           @db.Uuid
  organizationId String           @db.Uuid
  vehicleId      String?          @db.Uuid
  createdById    String           @db.Uuid
  price          Decimal          @db.Decimal(12, 2)
  etaMinutes     Int
  message        String?
  status         RelayOfferStatus @default(OFFERED)
  expiresAt      DateTime?
  respondedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  relay RelayDelivery @relation(fields: [relayId], references: [id], onDelete: Cascade)

  @@unique([relayId, organizationId])
  @@index([relayId, status])
  @@index([organizationId, status])
  @@map("relay_offers")
}

model RelayEvent {
  id          String         @id @default(uuid()) @db.Uuid
  relayId     String         @db.Uuid
  type        RelayEventType
  description String
  latitude    Float?
  longitude   Float?
  metadata    Json?
  actorUserId String?        @db.Uuid
  createdAt   DateTime       @default(now())

  relay RelayDelivery @relation(fields: [relayId], references: [id], onDelete: Cascade)

  @@index([relayId, createdAt])
  @@map("relay_events")
}

// ===========================================================================
// Route intelligence
// ===========================================================================

/// A signal, camera, checkpoint or road condition on the network.
model RouteHazard {
  id             String            @id @default(uuid()) @db.Uuid
  /// Null = platform-wide. Set = private to one tenant.
  organizationId String?           @db.Uuid
  kind           RouteHazardKind
  tier           RouteHazardTier   @default(STATIC)
  source         RouteHazardSource @default(PLATFORM)
  status         RouteHazardStatus @default(ACTIVE)
  severity       AlertSeverity     @default(INFO)

  name                    String
  description             String?
  latitude                Float
  longitude               Float
  /// Alert radius, and the dedupe radius for incoming reports.
  radiusMeters            Int     @default(150)
  /// Direction of travel the hazard applies to; null = both ways.
  headingDegrees          Int?
  headingToleranceDegrees Int     @default(60)

  speedLimitKph Int?
  city          String?
  district      String?
  state         String?
  highway       String?
  landmark      String?

  /// Signal cycle, for a predicted phase. All null = phase not modelled, and
  /// the API returns UNKNOWN rather than a guessed colour.
  signalCycleSeconds  Int?
  signalGreenSeconds  Int?
  signalOffsetSeconds Int?
  signalReferenceAt   DateTime?

  /// Recurring pattern, e.g. a checkpoint manned on weekday mornings.
  daysOfWeek       Int[]
  startTimeMinutes Int?
  endTimeMinutes   Int?

  validFrom  DateTime?
  validUntil DateTime?

  confirmCount    Int       @default(0)
  rejectCount     Int       @default(0)
  /// 0-1, decays with age for LIVE hazards.
  confidence      Float     @default(1)
  lastConfirmedAt DateTime?
  lastReportedAt  DateTime?
  reportCount     Int       @default(0)

  reportedByUserId String?   @db.Uuid
  verifiedById     String?   @db.Uuid
  verifiedAt       DateTime?
  reviewNote       String?
  sourceUrl        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reports RouteHazardReport[]
  alerts  TripHazardAlert[]

  @@index([latitude, longitude, status])
  @@index([kind, status])
  @@index([status, tier, validUntil])
  @@index([city, state])
  @@index([organizationId, status])
  @@map("route_hazards")
}

/// A driver report or a vote on an existing hazard.
///
/// Reports keep their own row even after being folded into a hazard, because
/// confidence counts distinct *organizations* and that needs the raw history.
model RouteHazardReport {
  id                      String          @id @default(uuid()) @db.Uuid
  hazardId                String?         @db.Uuid
  organizationId          String?         @db.Uuid
  kind                    RouteHazardKind
  vote                    HazardVote      @default(CONFIRM)
  latitude                Float
  longitude               Float
  headingDegrees          Int?
  note                    String?
  mediaId                 String?         @db.Uuid
  tripId                  String?         @db.Uuid
  vehicleId               String?         @db.Uuid
  driverId                String?         @db.Uuid
  expectedDurationMinutes Int?
  reportedByUserId        String          @db.Uuid
  createdAt               DateTime        @default(now())

  hazard RouteHazard? @relation(fields: [hazardId], references: [id], onDelete: SetNull)

  @@index([hazardId, createdAt])
  @@index([reportedByUserId, createdAt])
  @@index([latitude, longitude])
  @@index([organizationId, createdAt])
  @@map("route_hazard_reports")
}

/// A hazard actually surfaced to a driver on a trip.
///
/// The unique pair is the dedupe: a truck stuck in traffic beside a camera must
/// not be told about it forty times.
model TripHazardAlert {
  id              String        @id @default(uuid()) @db.Uuid
  tripId          String        @db.Uuid
  hazardId        String        @db.Uuid
  organizationId  String        @db.Uuid
  vehicleId       String        @db.Uuid
  driverId        String?       @db.Uuid
  distanceMeters  Int
  speedAtAlertKph Float?
  severity        AlertSeverity
  /// True when the vehicle passed a speed-limited hazard above its limit.
  violated        Boolean       @default(false)
  acknowledgedAt  DateTime?
  createdAt       DateTime      @default(now())

  hazard RouteHazard @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  trip   Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, hazardId])
  @@index([tripId, createdAt])
  @@index([organizationId, createdAt])
  @@index([driverId, violated])
  @@map("trip_hazard_alerts")
}

// ===========================================================================
// Enums — vehicle finance
// ===========================================================================

enum LoanType {
  TERM_LOAN
  HYPOTHECATION
  LEASE
  HIRE_PURCHASE
  REFINANCE
  TOP_UP
  WORKING_CAPITAL
  OTHER
}

enum InterestType {
  FLAT
  REDUCING_BALANCE
  FLOATING
}

enum EmiFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum LoanStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
  FORECLOSED
  DEFAULTED
  CANCELLED
}

enum InstallmentStatus {
  UPCOMING
  DUE_SOON
  DUE_TODAY
  PAID
  OVERDUE
  PARTIALLY_PAID
  WAIVED
  UNKNOWN
}

enum FinanceDataSource {
  MANUAL
  IMPORT
  PROVIDER_SYNC
  DOCUMENT_EXTRACTION
  CALCULATED
  SIMULATED
}

enum FinanceVerificationStatus {
  UNVERIFIED
  PROVIDER_REPORTED
  PENDING_REVIEW
  VERIFIED
  CONFLICT
  REJECTED
}

enum LoanPaymentMethod {
  AUTO_DEBIT
  NACH
  UPI
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
  OTHER
}

enum LoanPaymentKind {
  INSTALLMENT
  PART_PREPAYMENT
  FORECLOSURE
  PENALTY
  CHARGES
}

enum LoanEventType {
  CREATED
  UPDATED
  SCHEDULE_GENERATED
  SCHEDULE_REGENERATED
  PAYMENT_RECORDED
  PAYMENT_REVERSED
  INSTALLMENT_WAIVED
  REMINDER_SENT
  MARKED_OVERDUE
  PROVIDER_SYNCED
  PROVIDER_SYNC_FAILED
  CONFLICT_RAISED
  CONFLICT_RESOLVED
  STATUS_CHANGED
  CLOSED
}

enum LoanReminderKind {
  ADVANCE
  IMMINENT
  OVERDUE
}

// ===========================================================================
// Vehicle finance — loans, EMI schedules and repayments
// ===========================================================================

/// A finance facility secured against one vehicle.
///
/// Saarthi is a record-keeper here, not a lender: nothing in this table moves
/// money. `loanNumber` is the lender's own reference and is unique per tenant,
/// not globally — two fleets can hold the same reference from different
/// financiers, and a global unique constraint would leak that between them.
model VehicleLoan {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  vehicleId      String @db.Uuid

  loanNumber   String
  lenderName   String
  lenderBranch String?
  borrowerName String?
  loanType     LoanType   @default(TERM_LOAN)
  status       LoanStatus @default(ACTIVE)

  /// Sanctioned amount the schedule is computed from.
  principal         Decimal      @db.Decimal(14, 2)
  /// What actually reached the borrower, when it differed.
  disbursedAmount   Decimal?     @db.Decimal(14, 2)
  /// Nominal annual rate, e.g. 10.500 for 10.5% p.a.
  annualRatePercent Decimal      @db.Decimal(6, 3)
  interestType      InterestType @default(REDUCING_BALANCE)

  tenureMonths Int
  frequency    EmiFrequency @default(MONTHLY)
  startDate    DateTime     @db.Date
  /// Derived from the tenure unless the lender specified otherwise.
  endDate      DateTime?    @db.Date
  firstDueDate DateTime     @db.Date

  /// The installment amount actually billed. Saarthi computes one from the
  /// terms, but the lender's figure wins when supplied — their rounding is what
  /// the bank account will show.
  emiAmount     Decimal @db.Decimal(14, 2)
  /// True when emiAmount came from the lender rather than our amortisation.
  emiFromLender Boolean @default(false)

  autoDebitDay     Int?
  /// Sensitive: enough to trace or dispute a debit. Returned masked.
  mandateReference String?
  /// Sensitive. Stored for reconciliation, never returned below owner level.
  accountNumber    String?

  /// Days relative to a due date at which reminders fire. Empty = defaults.
  reminderOffsets  Int[]
  remindersEnabled Boolean @default(true)

  source             FinanceDataSource         @default(MANUAL)
  verificationStatus FinanceVerificationStatus @default(UNVERIFIED)
  /// Which external provider supplied or last confirmed this record.
  providerName       String?
  providerReference  String?
  lastSyncedAt       DateTime?
  lastSyncError      String?

  notes       String?
  closedAt    DateTime?
  closeReason String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle      Truck             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  installments LoanInstallment[]
  payments     LoanPayment[]
  events       LoanEvent[]
  reminders    LoanReminder[]

  @@unique([organizationId, loanNumber])
  @@index([organizationId, status])
  @@index([vehicleId, status])
  @@index([organizationId, lenderName])
  @@map("vehicle_loans")
}

/// One row of the repayment schedule.
///
/// `status` is stored rather than derived on read because reminders, overdue
/// escalation and provider reconciliation all need a stable value to compare
/// against. A sweep keeps it aligned with the due date, and the API recomputes
/// the transient part (UPCOMING to DUE_SOON to DUE_TODAY) on the way out.
model LoanInstallment {
  id             String @id @default(uuid()) @db.Uuid
  loanId         String @db.Uuid
  organizationId String @db.Uuid

  number  Int
  dueDate DateTime @db.Date

  principal      Decimal  @db.Decimal(14, 2)
  interest       Decimal  @db.Decimal(14, 2)
  totalDue       Decimal  @db.Decimal(14, 2)
  /// Balance outstanding before this installment is applied.
  openingBalance Decimal? @db.Decimal(14, 2)
  closingBalance Decimal? @db.Decimal(14, 2)

  status           InstallmentStatus @default(UPCOMING)
  amountPaid       Decimal           @default(0) @db.Decimal(14, 2)
  penaltyPaid      Decimal           @default(0) @db.Decimal(14, 2)
  paidAt           DateTime?
  paymentReference String?

  waivedAt    DateTime?
  waivedById  String?   @db.Uuid
  waiveReason String?

  source             FinanceDataSource         @default(CALCULATED)
  verificationStatus FinanceVerificationStatus @default(UNVERIFIED)
  /// Set when a provider reported a figure that disagrees with ours.
  conflictNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loan     VehicleLoan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@unique([loanId, number])
  @@index([organizationId, status, dueDate])
  @@index([loanId, dueDate])
  @@index([dueDate, status])
  @@map("loan_installments")
}

/// A repayment recorded against a loan, and usually against one installment.
///
/// Append-only in practice: a mistake is corrected with a reversing entry
/// (`reversedAt`) rather than an edit, so the ledger still explains itself.
model LoanPayment {
  id             String  @id @default(uuid()) @db.Uuid
  loanId         String  @db.Uuid
  installmentId  String? @db.Uuid
  organizationId String  @db.Uuid

  amount  Decimal           @db.Decimal(14, 2)
  penalty Decimal           @default(0) @db.Decimal(14, 2)
  kind    LoanPaymentKind   @default(INSTALLMENT)
  method  LoanPaymentMethod @default(BANK_TRANSFER)
  paidAt  DateTime

  reference String?
  notes     String?

  source             FinanceDataSource         @default(MANUAL)
  verificationStatus FinanceVerificationStatus @default(UNVERIFIED)

  reversedAt    DateTime?
  reversedById  String?   @db.Uuid
  reverseReason String?

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  loan        VehicleLoan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installment LoanInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([loanId, paidAt])
  @@index([organizationId, paidAt])
  @@index([installmentId])
  @@map("loan_payments")
}

/// Audit trail for a loan. A money record has to explain its own history.
model LoanEvent {
  id             String        @id @default(uuid()) @db.Uuid
  loanId         String        @db.Uuid
  organizationId String        @db.Uuid
  eventType      LoanEventType
  description    String?
  metadata       Json?
  actorUserId    String?       @db.Uuid
  createdAt      DateTime      @default(now())

  loan VehicleLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, createdAt])
  @@index([organizationId, createdAt])
  @@map("loan_events")
}

/// One reminder actually sent for one installment.
///
/// The unique key is the whole point: a sweep that runs every few hours must
/// not send the T-4 notice four times, and a restarted worker must not resend
/// what the previous run already delivered.
model LoanReminder {
  id             String           @id @default(uuid()) @db.Uuid
  loanId         String           @db.Uuid
  installmentId  String           @db.Uuid
  organizationId String           @db.Uuid
  kind           LoanReminderKind
  dueDate        DateTime         @db.Date
  sentAt         DateTime         @default(now())

  loan VehicleLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([installmentId, kind])
  @@index([organizationId, sentAt])
  @@map("loan_reminders")
}

/// Per-tenant QR field disclosure policy.
///
/// One row per organization. `overrides` holds only the fields whose rule the
/// owner changed from the shared default catalogue, so a later release that
/// adds a field gets that field's safe default everywhere rather than an
/// implicit "allow" inherited from an old saved policy.
///
/// A policy can only narrow: the scan pipeline intersects it with the code's
/// scopes and the scanner's relationship ceiling, and the narrowest wins.
model QrPrivacyPolicy {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  /// Field overrides, validated against the shared catalogue before storage.
  /// Non-configurable fields (home address, chassis number, loan amounts) are
  /// stripped on write and can never appear here.
  overrides Json @default("{}")

  /// Tenant-level kill switch for anonymous resolution. A code may opt into
  /// public resolve, but if the fleet has turned this off, no code of theirs
  /// answers to a scanner without a session.
  allowPublicScans Boolean @default(true)

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("qr_privacy_policies")
}

enum TopUpStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
}

/// A `+1 vehicle` top-up on an organization's subscription.
///
/// One row per extra vehicle, rather than a quantity column. That is
/// deliberate: each top-up has its own billing period, its own payment
/// reference and its own cancellation, so a fleet that bought three at
/// different times can drop exactly one without disturbing the others.
model VehicleSubscriptionTopUp {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  status         TopUpStatus @default(ACTIVE)

  /// Billing window. `expiresAt` null means it renews until cancelled.
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  cancelledAt DateTime?

  /// Price paid, kept per row so a historical price change does not rewrite
  /// what an existing customer was actually charged.
  priceMonthly Decimal @db.Decimal(10, 2)

  /// Reference from the payment provider (mock locally).
  paymentReference String?
  purchasedById    String?  @db.Uuid
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, status])
  @@index([status, expiresAt])
  @@map("vehicle_subscription_topups")
}

enum ViewMode {
  TABLE
  CARDS
}

/// How one person likes one list presented.
///
/// Stored per user rather than per organization: a dispatcher working a
/// three-monitor desk and an owner checking the fleet from a phone want
/// opposite things from the same screen, and neither should be overriding the
/// other. The row is created lazily on first change, so a user who never
/// touches the toggle costs nothing.
model UserViewPreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// Stable key for the list, e.g. "fleet.vehicles". Owned by the client,
  /// because the server has no opinion about which screens exist.
  surface String

  viewMode      ViewMode @default(TABLE)
  /// Columns this user has hidden. Column keys, not indexes: a reordered table
  /// must not silently hide a different column.
  hiddenColumns String[]
  pageSize      Int?
  /// Sort column and direction, when the list supports it.
  sortKey       String?
  sortDirection String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surface])
  @@index([userId])
  @@map("user_view_preferences")
}

enum CameraPosition {
  FRONT
  CABIN
  LEFT
  RIGHT
  REAR
  CARGO
  OTHER
}

enum CameraStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  DISABLED
  FAULT
}

enum StreamSessionStatus {
  REQUESTED
  ACTIVE
  ENDED
  DENIED
  FAILED
}

/// One camera channel wired into a multi-camera device such as the YC06.
///
/// A camera belongs to the *device*, not to the vehicle. That is the whole
/// point of the split: a YC06 moved from one truck to another takes its four
/// channels with it, and last month's footage still resolves to the vehicle the
/// device was fitted to at the time rather than to wherever it is now.
model DeviceCamera {
  id             String @id @default(uuid()) @db.Uuid
  deviceId       String @db.Uuid
  organizationId String @db.Uuid

  /// Physical input on the recorder: 1-4 on a YC06.
  channel  Int
  position CameraPosition @default(OTHER)
  label    String?

  status  CameraStatus @default(UNKNOWN)
  enabled Boolean      @default(true)

  /// Whether this channel records continuously or only on an event.
  continuousRecording Boolean @default(true)
  resolution          String?
  frameRate           Int?

  lastFrameAt      DateTime?
  lastThumbnailUrl String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device   HardwareDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sessions VideoStreamSession[]

  @@unique([deviceId, channel])
  @@index([organizationId, status])
  @@map("device_cameras")
}

/// A request to watch a camera live.
///
/// The video itself never touches this database — frames go device → video
/// gateway → browser. What is recorded here is who asked to watch, which
/// camera, when, and for how long. A dashcam pointed at a driver's face is a
/// surveillance capability, and the only thing that keeps it accountable is a
/// record of every time somebody used it.
model VideoStreamSession {
  id             String  @id @default(uuid()) @db.Uuid
  cameraId       String  @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String? @db.Uuid

  requestedById String              @db.Uuid
  status        StreamSessionStatus @default(REQUESTED)

  /// Short-lived credential the gateway validates. Hashed, never stored raw.
  tokenHash String
  expiresAt DateTime

  startedAt DateTime?
  endedAt   DateTime?
  /// Why a session was refused or cut short.
  reason    String?

  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  camera DeviceCamera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([cameraId, createdAt])
  @@index([requestedById, createdAt])
  @@map("video_stream_sessions")
}

// ===========================================================================
// Enums — FASTag & toll
// ===========================================================================

/// State of a FASTag as the issuer reports it.
///
/// `LOW_BALANCE` and `BLACKLISTED` are the two that stop a truck at a plaza,
/// and they are different problems: one is topped up in a minute, the other
/// needs a call to the issuing bank.
enum FastagStatus {
  ACTIVE
  LOW_BALANCE
  BLACKLISTED
  EXCEPTION
  HOTLISTED
  CLOSED
  UNKNOWN
}

enum TollDirection {
  INBOUND
  OUTBOUND
  UNKNOWN
}

/// How a toll crossing came to be recorded.
enum TollDataSource {
  /// Typed in by the fleet, usually from a paper receipt.
  MANUAL
  /// Bulk-loaded from a bank or NETC statement.
  IMPORT
  /// Pulled from an integrated tag issuer.
  PROVIDER_SYNC
  /// Read off a receipt image by AI. A draft until a person confirms it.
  DOCUMENT_EXTRACTION
  SIMULATED
}

enum TollPaymentMode {
  FASTAG
  CASH
  UPI
  CARD
  EXEMPT
  UNKNOWN
}

// ===========================================================================
// FASTag & toll
// ===========================================================================

/// A FASTag issued against one vehicle.
///
/// The tag id is a payment instrument identifier: enough to query a balance,
/// dispute a deduction, or impersonate the vehicle at a plaza. It is stored for
/// reconciliation, returned masked, and never disclosed by a QR scan at any
/// privacy profile.
///
/// `balance` is deliberately nullable. Saarthi knows a balance only when
/// somebody told it one; a tag with no reading is "unknown", which is a
/// different thing from a tag with zero rupees on it.
model FastagAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  vehicleId      String @db.Uuid

  /// Sensitive. Returned masked below owner level.
  tagId        String
  /// NETC bank identifier, e.g. the issuing bank's short code.
  issuerBank   String
  issuerCode   String?
  /// Vehicle class the tag was issued against (NETC VC04, VC12 and so on).
  vehicleClass String?

  status FastagStatus @default(UNKNOWN)

  /// Last known balance. Null means nobody has reported one yet.
  balance             Decimal?  @db.Decimal(12, 2)
  balanceUpdatedAt    DateTime?
  /// Balance below which the fleet is warned. Null uses the platform default.
  lowBalanceThreshold Decimal?  @db.Decimal(12, 2)

  /// Sensitive: the bank account the tag draws from, when recorded.
  linkedAccountRef String?

  issuedAt    DateTime?
  expiresAt   DateTime?
  closedAt    DateTime?
  closeReason String?

  source        TollDataSource @default(MANUAL)
  providerName  String?
  lastSyncedAt  DateTime?
  lastSyncError String?

  notes       String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicle      Truck             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  transactions TollTransaction[]

  /// One active tag per vehicle is the NETC rule; history is kept by closing
  /// the old row rather than deleting it, so a disputed crossing from last year
  /// still resolves to the tag that paid it.
  @@unique([organizationId, tagId])
  @@index([organizationId, status])
  @@index([vehicleId, closedAt])
  @@map("fastag_accounts")
}

/// One toll crossing.
///
/// Denormalised plaza name and code rather than a foreign key: a bank statement
/// gives a plaza name and nothing else, and refusing to record a crossing
/// because the plaza is not in a reference table would lose the only record of
/// money actually spent.
model TollTransaction {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String  @db.Uuid
  fastagId       String? @db.Uuid
  tripId         String? @db.Uuid
  driverId       String? @db.Uuid

  plazaName String
  plazaCode String?
  laneId    String?
  highway   String?
  latitude  Float?
  longitude Float?

  direction    TollDirection   @default(UNKNOWN)
  paymentMode  TollPaymentMode @default(FASTAG)
  amount       Decimal         @db.Decimal(10, 2)
  /// Balance the issuer reported immediately after the deduction, when given.
  balanceAfter Decimal?        @db.Decimal(12, 2)

  crossedAt         DateTime
  /// The issuer's own reference, used to de-duplicate across imports.
  externalReference String?

  source             TollDataSource            @default(MANUAL)
  verificationStatus FinanceVerificationStatus @default(UNVERIFIED)
  /// Set when an imported crossing disagrees with one already recorded.
  conflictNote       String?

  notes        String?
  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicle Truck          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fastag  FastagAccount? @relation(fields: [fastagId], references: [id], onDelete: SetNull)

  /// The issuer reference is unique per tenant, which is what makes a repeated
  /// statement import idempotent rather than doubling a month of spend.
  @@unique([organizationId, externalReference])
  @@index([organizationId, crossedAt])
  @@index([vehicleId, crossedAt])
  @@index([tripId])
  @@index([fastagId, crossedAt])
  @@map("toll_transactions")
}

// ===========================================================================
// Enums — Saarthi Terminal
// ===========================================================================

/// The lifecycle of one driver on one terminal.
///
/// Persisted as a single explicit state rather than as a scatter of booleans,
/// because the rules that matter — a driver is not active until somebody
/// approved them, a trip cannot start before the safety check — are statements
/// about *which* state the session is in. A boolean pair can represent
/// "rejected and approved" at the same time; this cannot.
enum TerminalSessionStatus {
  /// The driver scanned the vehicle QR from their own Saarthi account.
  DRIVER_IDENTIFIED
  /// An arrival selfie has been captured and stored.
  SELFIE_SUBMITTED
  /// Waiting on the fleet owner or mobility provider.
  PENDING_APPROVAL
  /// Authorised by a named person. The safety check is still outstanding.
  APPROVED
  /// Checklist complete. The driver may start driving.
  READY
  /// A trip is under way.
  TRIP_ACTIVE
  /// The driver signed off, or the trip finished.
  COMPLETED
  /// Explicitly refused by the owner or provider.
  REJECTED
  /// Withdrawn by the driver before a decision.
  CANCELLED
  /// Never answered inside the SLA window and closed by the sweep.
  ///
  /// Expiry closes the *request*; it never activates the driver. Section 15 of
  /// the specification is explicit that fifteen minutes is an escalation, not
  /// an approval.
  EXPIRED
}

enum TerminalSessionEventType {
  REQUESTED
  SELFIE_SUBMITTED
  SUBMITTED_FOR_APPROVAL
  REMINDER_SENT
  ESCALATED
  APPROVED
  REJECTED
  CHECKLIST_SUBMITTED
  TRIP_STARTED
  TRIP_COMPLETED
  CANCELLED
  EXPIRED
  NOTE
}

/// Where a checklist item's verdict comes from.
///
/// The distinction is the whole point of the intelligent checklist: a driver
/// looking at a tyre and a sensor reporting a coolant temperature are different
/// kinds of evidence, and presenting one as the other is how a vehicle gets
/// signed off on a reading nobody took.
enum TerminalChecklistItemKind {
  /// The driver has to look at it. Nothing on the vehicle can answer.
  MANUAL
  /// Answered from live telemetry when the metric is genuinely reported.
  TELEMETRY
  /// Answered from maintenance and service records.
  MAINTENANCE
  /// Answered from document validity.
  DOCUMENT
}

enum TerminalChecklistItemStatus {
  OK
  ATTENTION
  CRITICAL
  /// No data and no inspection — recorded as unknown rather than as a pass.
  UNAVAILABLE
  SKIPPED
}

enum TerminalChecklistOutcome {
  PASSED
  PASSED_WITH_WARNINGS
  FAILED
}

enum TerminalIssueCategory {
  ENGINE
  TYRE
  BRAKE
  ELECTRICAL
  ACCIDENT
  BODY
  OTHER
}

enum TerminalIssueStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

// ===========================================================================
// Saarthi Terminal
// ===========================================================================

/// One driver's authorisation to use one vehicle, raised from a terminal.
///
/// Deliberately one row for the whole lifecycle — request, selfie, approval,
/// safety check, trip, sign-off — rather than a request table and a session
/// table. They are one thing that happens once, in order, and splitting them
/// would mean every read of "who is on this truck right now" is a join, while
/// buying nothing: there is no state in which a session exists without the
/// request that produced it.
///
/// The terminal is `HardwareDevice`; the vehicle is `Truck`; the driver is
/// `Driver`. None of them is duplicated here.
model TerminalSession {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  /// The terminal the driver walked up to.
  terminalDeviceId String @db.Uuid
  vehicleId        String @db.Uuid
  driverId         String @db.Uuid
  /// Denormalised from the driver, so the approval queue renders without a
  /// second join and a later driver archive does not blank the history.
  driverUserId     String @db.Uuid

  status TerminalSessionStatus @default(DRIVER_IDENTIFIED)

  /// The QR code the driver actually scanned, for the audit trail.
  ///
  /// Nullable because a session may also be opened from a typed vehicle code,
  /// and because a code can be rotated after the fact.
  scannedQrCodeId String? @db.Uuid

  /// Where the driver was when they scanned. Evidence they were at the vehicle.
  scanLatitude  Float?
  scanLongitude Float?

  /// The arrival selfie, stored once in the media library.
  ///
  /// A reference, never a second copy of the bytes: section 13 is explicit that
  /// the terminal must not create duplicate image storage.
  selfieMediaId    String?   @db.Uuid
  selfieCapturedAt DateTime?

  requestedAt DateTime  @default(now())
  submittedAt DateTime?

  /// SLA bookkeeping (section 15). None of these ever approves anything.
  remindedAt  DateTime?
  escalatedAt DateTime?
  /// When the request stops being answerable.
  expiresAt   DateTime?

  decidedAt       DateTime?
  decidedById     String?   @db.Uuid
  decisionNote    String?
  rejectionReason String?

  /// The TruckAssignment opened on approval, so the two stay reconcilable.
  truckAssignmentId String? @db.Uuid

  checklistCompletedAt DateTime?
  tripStartedAt        DateTime?
  tripCompletedAt      DateTime?
  endedAt              DateTime?
  endReason            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terminal   HardwareDevice                @relation("TerminalDeviceSessions", fields: [terminalDeviceId], references: [id], onDelete: Cascade)
  vehicle    Truck                         @relation("VehicleTerminalSessions", fields: [vehicleId], references: [id], onDelete: Cascade)
  driver     Driver                        @relation("DriverTerminalSessions", fields: [driverId], references: [id], onDelete: Cascade)
  events     TerminalSessionEvent[]
  checklists TerminalChecklistSubmission[]
  issues     TerminalIssueReport[]

  @@index([organizationId, status, requestedAt])
  @@index([terminalDeviceId, status])
  @@index([vehicleId, status])
  @@index([driverId, status])
  @@index([status, expiresAt])
  @@map("terminal_sessions")
}

/// Append-only history of one session.
///
/// Kept separate from the status column because "what state is it in" and "how
/// did it get here" are different questions, and an approval dispute needs the
/// second one.
model TerminalSessionEvent {
  id          String                   @id @default(uuid()) @db.Uuid
  sessionId   String                   @db.Uuid
  eventType   TerminalSessionEventType
  description String?
  metadata    Json?
  actorUserId String?                  @db.Uuid
  createdAt   DateTime                 @default(now())

  session TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("terminal_session_events")
}

/// A fleet's pre-trip checklist definition.
///
/// Section 17 requires the ten points be configurable from the backend rather
/// than hard-coded for ever. A fleet with no row falls back to the shared
/// default catalogue, so the feature works on day one without anybody
/// configuring anything, and a fleet that does configure it is not fighting a
/// hard-coded list.
model TerminalChecklistTemplate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @default("Pre-trip safety check")
  /// Vehicle type this template applies to. Null = every vehicle type.
  vehicleType    VehicleType?
  active         Boolean      @default(true)
  version        Int          @default(1)

  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       TerminalChecklistTemplateItem[]
  submissions TerminalChecklistSubmission[]

  @@unique([organizationId, vehicleType])
  @@index([organizationId, active])
  @@map("terminal_checklist_templates")
}

model TerminalChecklistTemplateItem {
  id         String @id @default(uuid()) @db.Uuid
  templateId String @db.Uuid

  /// Stable machine key (e.g. `TYRES`). What results are keyed on, so renaming
  /// the label does not orphan a year of submissions.
  code        String
  label       String
  description String?
  kind        TerminalChecklistItemKind @default(MANUAL)
  /// The telemetry metric that can answer this item, when `kind` is TELEMETRY.
  /// A value from the shared `TelemetryMetric` catalogue, stored as text for
  /// the same reason `telemetry_readings.metrics` is: the catalogue grows
  /// often, and a database enum would need a migration for every addition.
  metric      String?
  /// A failure here blocks the trip. A warning does not.
  blocking    Boolean                   @default(false)
  required    Boolean                   @default(true)
  sortOrder   Int                       @default(0)

  template TerminalChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
  @@index([templateId, sortOrder])
  @@map("terminal_checklist_template_items")
}

/// One completed pre-trip check.
model TerminalChecklistSubmission {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  sessionId      String  @db.Uuid
  vehicleId      String  @db.Uuid
  driverId       String  @db.Uuid
  templateId     String? @db.Uuid

  outcome TerminalChecklistOutcome @default(PASSED)

  /// Where the vehicle was when the check was signed off.
  latitude   Float?
  longitude  Float?
  odometerKm Float?

  /// True when any automated verdict in this submission came from simulated
  /// telemetry rather than a real sensor. Stored, not inferred, so a submission
  /// read a year later still says so.
  usedSimulatedData Boolean @default(false)

  notes       String?
  submittedAt DateTime @default(now())

  session  TerminalSession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  template TerminalChecklistTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  results  TerminalChecklistItemResult[]

  @@index([organizationId, submittedAt])
  @@index([vehicleId, submittedAt])
  @@index([sessionId])
  @@map("terminal_checklist_submissions")
}

model TerminalChecklistItemResult {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @db.Uuid

  code   String
  label  String
  kind   TerminalChecklistItemKind   @default(MANUAL)
  status TerminalChecklistItemStatus @default(OK)

  /// The observed figure, when one was available, and what it was.
  observedValue Float?
  unit          String?
  /// A value from the shared `TelemetryMetric` catalogue. Text, as above.
  metric        String?
  /// True when `observedValue` came from a simulator rather than a sensor.
  simulated     Boolean @default(false)
  /// Free text from the driver, and the rule's own explanation.
  note          String?
  detail        String?

  submission TerminalChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("terminal_checklist_item_results")
}

/// A problem the driver reported from the cab.
///
/// Not a MaintenanceRecord: a maintenance record is what a workshop did, and
/// this is what a driver noticed. Triage turns one into the other, and
/// conflating them would put unverified driver reports into the service history
/// a resale valuation reads.
model TerminalIssueReport {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @db.Uuid
  sessionId        String? @db.Uuid
  terminalDeviceId String? @db.Uuid
  vehicleId        String  @db.Uuid
  driverId         String? @db.Uuid
  reportedByUserId String? @db.Uuid

  category    TerminalIssueCategory @default(OTHER)
  status      TerminalIssueStatus   @default(OPEN)
  severity    AlertSeverity         @default(WARNING)
  description String

  /// Photographs, in the media library. Ids only — see TerminalSession.selfieMediaId.
  mediaIds String[]

  latitude   Float?
  longitude  Float?
  odometerKm Float?

  /// The maintenance record raised from this report, once one exists.
  maintenanceRecordId String?   @db.Uuid
  acknowledgedAt      DateTime?
  acknowledgedById    String?   @db.Uuid
  resolvedAt          DateTime?
  resolutionNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session  TerminalSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  terminal HardwareDevice?  @relation("TerminalDeviceIssues", fields: [terminalDeviceId], references: [id], onDelete: SetNull)
  vehicle  Truck            @relation("VehicleTerminalIssues", fields: [vehicleId], references: [id], onDelete: Cascade)
  driver   Driver?          @relation("DriverTerminalIssues", fields: [driverId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([vehicleId, createdAt])
  @@index([sessionId])
  @@map("terminal_issue_reports")
}

// ===========================================================================
// Saarthi Terminal — over-the-air releases
// ===========================================================================

/// How far along a build is on its way to the fleet.
enum TerminalReleaseStatus {
  /// Uploaded and inspected, offered to nobody. The state every release starts
  /// in, so uploading is never the same act as shipping.
  DRAFT
  /// Offered to every terminal running an older version code.
  PUBLISHED
  /// Withdrawn. Terminals stop being offered it; those that already installed
  /// it keep running it, because an install cannot be recalled.
  ARCHIVED
}

/// A build of the Saarthi Terminal app that vehicles can install over the air.
///
/// Platform-wide, deliberately: there is one Terminal app, and a fleet running
/// a private build of it is a support case nobody could reason about. Only a
/// platform administrator may publish.
///
/// The row records what was *found in the APK*, not what the uploader typed.
/// `versionCode`, `versionName`, `minSdk` and `applicationId` are read out of
/// the binary, so a release cannot claim to be something it is not — and
/// `versionCode` is the only field the update check compares.
model TerminalRelease {
  id String @id @default(uuid()) @db.Uuid

  /// Read from the APK. Unique because two builds sharing a code are
  /// indistinguishable to Android, which would make "is this newer?" unanswerable.
  versionCode   Int    @unique
  versionName   String
  /// Refused at upload if it does not match the installed package.
  applicationId String
  /// A terminal below this cannot install the build, and is not offered it.
  minSdk        Int

  storageKey    String
  fileName      String
  fileSize      Int
  /// Lower-case hex SHA-256 of the exact bytes stored. The terminal recomputes
  /// this after downloading and refuses to install on a mismatch, so a truncated
  /// or tampered download cannot reach the package installer.
  sha256        String
  /// The signing certificate's SHA-256, as apksigner reports it. Recorded so a
  /// release signed by the wrong key is visible here rather than as an
  /// unexplained install failure in a cab.
  signingSha256 String?

  status    TerminalReleaseStatus @default(DRAFT)
  /// Blocks the cockpit until installed. For a security or data-integrity fix
  /// only — a driver who cannot start a trip cannot earn.
  mandatory Boolean               @default(false)
  /// What changed, in the words a driver reads on the update card.
  notes     String?

  publishedAt   DateTime?
  publishedById String?   @db.Uuid
  uploadedById  String    @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedBy  User  @relation("TerminalReleaseUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  publishedBy User? @relation("TerminalReleasePublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@index([status, versionCode])
  @@index([uploadedById])
  @@map("terminal_releases")
}
