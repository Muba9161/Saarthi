  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages AiMessage[]

  @@index([userId, updatedAt])
  @@index([organizationId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  role           AiMessageRole
  content        String
  /// Records which datasets the answer was grounded in, for transparency.
  contextSummary Json?
  provider       String?
  model          String?
  tokensUsed     Int?
  latencyMs      Int?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiInsight {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  type           AiInsightType
  category       String
  title          String
  body           String
  /// Records referenced by this insight, so the UI can deep-link to them.
  references     Json?
  severity       String        @default("info")
  /// Distinguishes a recorded fact from a calculation, prediction or advice.
  basis          String        @default("calculated")
  validUntil     DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, type, dismissedAt])
  @@map("ai_insights")
}

model AiUsage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String   @db.Uuid
  provider       String
  model          String
  operation      String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  latencyMs      Int      @default(0)
  success        Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

// ===========================================================================
// GPS simulation (demo mode only — never enabled in production)
// ===========================================================================

model Simulation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  truckId         String           @db.Uuid
  tripId          String?          @db.Uuid
  status          SimulationStatus @default(IDLE)
  /// Route being driven as [{ latitude, longitude }, ...].
  route           Json
  routeDistanceKm Float            @default(0)
  /// Metres already covered along the route.
  progressMeters  Float            @default(0)
  baseSpeedKph    Float            @default(45)
  speedMultiplier Float            @default(1)
  /// Injected behaviours: random stops, delays, deviation, connectivity loss.
  behaviours      Json?
  deviationActive Boolean          @default(false)
  startedAt       DateTime?
  pausedAt        DateTime?
  stoppedAt       DateTime?
  completedAt     DateTime?
  lastTickAt      DateTime?
  createdById     String           @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([truckId, status])
  @@index([status])
  @@map("simulations")
}

