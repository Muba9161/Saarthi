/// already holds rather than claims the seller types.
model VehicleListing {
  id             String                   @id @default(uuid()) @db.Uuid
  reference      String                   @unique
  organizationId String                   @db.Uuid
  vehicleId      String                   @db.Uuid
  status         VehicleListingStatus     @default(DRAFT)
  visibility     VehicleListingVisibility @default(PLATFORM)

  title        String
  description  String?
  askingPrice  Decimal  @db.Decimal(12, 2)
  negotiable   Boolean  @default(true)
  /// The seller's walk-away figure. Never serialised to a buyer.
  minimumPrice Decimal? @db.Decimal(12, 2)

  condition            VehicleCondition @default(GOOD)
  odometerKm           Float
  ownershipCount       Int              @default(1)
  accidentHistory      Boolean          @default(false)
  accidentNote         String?
  majorRepairsNote     String?
  tyreConditionPercent Int?
  engineConditionNote  String?
  insuranceValidTill   DateTime?
  fitnessValidTill     DateTime?
  permitType           String?
  permitValidTill      DateTime?
  loanOutstanding      Boolean          @default(false)
  hypothecationNote    String?

  city      String?
  state     String?
  latitude  Float?
  longitude Float?

  /// Evidence blocks the seller has chosen to share, as EvidenceBlock values.
  sharedEvidence String[]

  availableFrom DateTime?
  expiresAt     DateTime?
  viewCount     Int       @default(0)
  offerCount    Int       @default(0)

  submittedAt     DateTime?
  publishedAt     DateTime?
  reviewedById    String?   @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?

  reservedForOrganizationId String?   @db.Uuid
  soldToOrganizationId      String?   @db.Uuid
  soldPrice                 Decimal?  @db.Decimal(12, 2)
  soldAt                    DateTime?
  withdrawnAt               DateTime?
  withdrawalReason          String?

  createdById String    @db.Uuid
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vehicle     Truck                      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  offers      VehicleListingOffer[]
  inspections VehicleInspectionRequest[]
  events      VehicleListingEvent[]
  watches     VehicleListingWatch[]
  transfer    VehicleTransfer?

  @@index([status, visibility, publishedAt])
  @@index([organizationId, status])
  @@index([vehicleId])
  @@index([city, state])
  @@map("vehicle_listings")
}

model VehicleListingOffer {
  id                  String             @id @default(uuid()) @db.Uuid
  listingId           String             @db.Uuid
  buyerOrganizationId String             @db.Uuid
  buyerUserId         String             @db.Uuid
  amount              Decimal            @db.Decimal(12, 2)
  message             String?
  status              VehicleOfferStatus @default(OFFERED)
  counterAmount       Decimal?           @db.Decimal(12, 2)
  counterMessage      String?
  counteredAt         DateTime?
  wantsInspection     Boolean            @default(false)
  expiresAt           DateTime?
  respondedAt         DateTime?
  rejectionReason     String?
  withdrawnAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([buyerOrganizationId, status])
  @@map("vehicle_listing_offers")
}

model VehicleInspectionRequest {
  id                      String                  @id @default(uuid()) @db.Uuid
  listingId               String                  @db.Uuid
  requesterOrganizationId String                  @db.Uuid
  requesterUserId         String                  @db.Uuid
  status                  VehicleInspectionStatus @default(REQUESTED)
  preferredAt             DateTime
  alternateAt             DateTime?
  scheduledAt             DateTime?
  location                String?
  contactPhone            String?
  note                    String?
  reportSummary           String?
  inspectorUserId         String?                 @db.Uuid
  completedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([requesterOrganizationId, status])
  @@map("vehicle_inspection_requests")
}

model VehicleListingEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  listingId   String                  @db.Uuid
  type        VehicleListingEventType
  description String
  metadata    Json?
  actorUserId String?                 @db.Uuid
  createdAt   DateTime                @default(now())

  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@map("vehicle_listing_events")
}

/// A listing saved by a buyer organization.
model VehicleListingWatch {
  id             String   @id @default(uuid()) @db.Uuid
  listingId      String   @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  createdAt      DateTime @default(now())

  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([organizationId])
  @@map("vehicle_listing_watches")
}

/// Ownership handover of a sold vehicle.
///
/// Completing this is the only path by which a `trucks` row changes tenant, and
/// it happens in one transaction alongside ending assignments, unassigning
/// devices and re-pointing vehicle-owned documents.
model VehicleTransfer {
  id                  String                @id @default(uuid()) @db.Uuid
  listingId           String                @unique @db.Uuid
  vehicleId           String                @db.Uuid
  fromOrganizationId  String                @db.Uuid
  toOrganizationId    String                @db.Uuid
  status              VehicleTransferStatus @default(PENDING)
  salePrice           Decimal               @db.Decimal(12, 2)
  rcTransferReference String?
  paymentId           String?               @db.Uuid
  paymentReference    String?
  documentsCompleteAt DateTime?
  paymentCompleteAt   DateTime?
  transferredAt       DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  notes               String?
  createdById         String                @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  listing VehicleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([fromOrganizationId, status])
  @@index([toOrganizationId, status])
  @@index([vehicleId])
  @@map("vehicle_transfers")
}

// ===========================================================================
// Profile builder
// ===========================================================================

/// The parts of a person's profile that had no home in `users` or `drivers`.
///
/// Created lazily on first read, so no backfill migration is needed.
model UserProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  headline    String?
  bio         String?
  /// Spoken languages, used when matching drivers to passengers.
  languages   String[]
  skills      String[]
  dateOfBirth DateTime?
  gender      String?
  socialLinks Json?

  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  latitude    Float?
  longitude   Float?

  emergencyContactName  String?
  emergencyContactPhone String?

  /// locale, timezone, theme, distanceUnit, mapStyle, voiceAlerts.
  preferences Json?

  visibility      ProfileVisibility @default(PLATFORM)
  fieldVisibility Json?
  publicSlug      String?           @unique

  completionPercent Int       @default(0)
  completedSections String[]
  lastBuiltAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, state])
  @@index([completionPercent])
