// Saarthi database schema.
//
// Conventions:
//  * UUID primary keys (non-sequential, safe to expose in URLs).
//  * Every table carries createdAt/updatedAt.
//  * Tenant-owned tables carry organizationId and index it.
//  * Deletion is soft (archivedAt/deletedAt) wherever the record must remain
//    auditable; hard deletes are reserved for genuinely disposable rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums — identity & access
// ===========================================================================

enum RoleName {
  PLATFORM_ADMIN
  FLEET_OWNER
  FLEET_MANAGER
  DISPATCHER
  DRIVER
  SUPPLIER
  CUSTOMER
  SUPPORT_AGENT
  ASSOCIATION_ADMIN
  ASSOCIATION_RESPONDER
  MOBILITY_PROVIDER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DISABLED
}

enum OrganizationType {
  PLATFORM
  FLEET_OWNER
  SUPPLIER
  CUSTOMER
  ENTERPRISE
  TRUCK_ASSOCIATION
  /// Taxi / travel / tour business. A FLEET_OWNER can also sell mobility by
  /// adding service types to its provider profile; this type is for operators
  /// whose only business is passenger transport.
  MOBILITY_PROVIDER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum VerificationStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  SUSPENDED
}

// ===========================================================================
// Identity & access
// ===========================================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles           UserRole[]
  memberships     Membership[]
  sessions        Session[]
  passwordResets  PasswordResetToken[]
  auditLogs       AuditLog[]           @relation("AuditActor")
  driverProfile   Driver?              @relation("DriverUser")
  profile         UserProfile?
  viewPreferences UserViewPreference[]

  uploadedTerminalReleases  TerminalRelease[] @relation("TerminalReleaseUploader")
  publishedTerminalReleases TerminalRelease[] @relation("TerminalReleasePublisher")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String
  createdAt   DateTime @default(now())

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  type               OrganizationType
  registrationNumber String?
  taxNumber          String?
  email              String?
  phone              String?
  addressLine        String?
  city               String?
  state              String?
  postalCode         String?
  latitude           Float?
  longitude          Float?
  /// Short human-friendly code drivers use to join this fleet.
  inviteCode         String             @unique
  verificationStatus VerificationStatus @default(PENDING)
  logoUrl            String?
  description        String?
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  memberships        Membership[]
  auditLogs          AuditLog[]
  associationProfile AssociationProfile?
  providerProfile    ServiceProviderProfile?
  profile            OrganizationProfile?

  @@index([type])
  @@index([verificationStatus])
  @@index([createdAt])
  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           RoleName
  status         MembershipStatus @default(ACTIVE)
  /// The member's default organization when they belong to several.
  isPrimary      Boolean          @default(false)
  invitedById    String?          @db.Uuid
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("memberships")
}

/// A refresh-token bearing session. Revoking a row invalidates the device.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  /// SHA-256 of the refresh token — the raw token is never stored.
  refreshTokenHash String    @unique
  organizationId   String?   @db.Uuid
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ===========================================================================
// Audit
// ===========================================================================

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @db.Uuid
  organizationId String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  beforeData     Json?
  afterData      Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ===========================================================================
// Enums — subscriptions & notifications
// ===========================================================================

enum PlanTier {
  BASIC
  PRO
  INTELLIGENCE
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationType {
  DOCUMENT_EXPIRING
  DOCUMENT_EXPIRED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  VERIFICATION_RESULT
  ORDER_CREATED
  ORDER_QUOTED
  ORDER_UPDATED
  REQUIREMENT_POSTED
  REQUIREMENT_BID_RECEIVED
  REQUIREMENT_BID_ACCEPTED
  REQUIREMENT_BID_REJECTED
  REQUIREMENT_AWARDED
  REQUIREMENT_CANCELLED
  ORDER_DELIVERED
  TRIP_ASSIGNED
  TRIP_STARTED
  TRIP_DELAYED
  TRIP_COMPLETED
  ROUTE_DEVIATION
  SOS_TRIGGERED
  SOS_RESPONDER_REQUEST
  SOS_UPDATE
  SOS_RESOLVED
  MAINTENANCE_DUE
  MAINTENANCE_OVERDUE
  DRIVER_SCORE_CHANGED
  ACHIEVEMENT_UNLOCKED
  SUBSCRIPTION_UPDATED
  SECURITY_ALERT
  SYSTEM
  ASSOCIATION_ALERT
  ASSOCIATION_ALERT_ESCALATED
  ASSOCIATION_ALERT_RESOLVED
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  BOOKING_COMPLETED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  DEVICE_ASSIGNED
  DEVICE_OFFLINE
  DEVICE_ONLINE
  TELEMETRY_ALERT
  DIAGNOSTIC_FAULT

  // Added to match the shared catalogue, which is the source of truth
  // for enum values across the schema, the API and the client.
  STOCK_LOW
  STOCK_OUT
  STOCK_RESTOCKED
  STOCK_RESERVATION_EXPIRING
  LISTING_PUBLISHED
  LISTING_REJECTED
  LISTING_OFFER_RECEIVED
  LISTING_OFFER_COUNTERED
  LISTING_OFFER_ACCEPTED
  LISTING_OFFER_REJECTED
  LISTING_SOLD
  LISTING_INSPECTION_REQUESTED
  LISTING_EXPIRING
  VEHICLE_TRANSFER_UPDATED
  RETURN_LOAD_MATCH_FOUND
  RETURN_LOAD_BOOKED
  RETURN_LOAD_EXPIRING
  EMPTY_RETURN_RISK
  CITY_ACCESS_BLOCKED
  RELAY_REQUESTED
  RELAY_OFFER_RECEIVED
  RELAY_ASSIGNED
  RELAY_HANDOVER_READY
  RELAY_DELIVERED
  ROUTE_HAZARD_AHEAD
  ROUTE_HAZARD_VERIFIED
  PROFILE_INCOMPLETE
  QR_CODE_ROTATED
  MEDIA_MODERATION_REQUIRED

  // FASTag & toll
  FASTAG_LOW_BALANCE
  FASTAG_BLACKLISTED
  TOLL_SYNC_CONFLICT

  // Vehicle finance
  LOAN_EMI_DUE_SOON
  LOAN_EMI_DUE_TODAY
  LOAN_EMI_OVERDUE
  LOAN_PAYMENT_RECORDED
  LOAN_CLOSED
  LOAN_SYNC_CONFLICT

  // Saarthi Terminal
  TERMINAL_DRIVER_REQUEST
  TERMINAL_DRIVER_REQUEST_REMINDER
  TERMINAL_DRIVER_REQUEST_ESCALATED
  TERMINAL_DRIVER_APPROVED
  TERMINAL_DRIVER_REJECTED
  TERMINAL_DRIVER_REQUEST_EXPIRED
  TERMINAL_CHECKLIST_FAILED
  TERMINAL_ISSUE_REPORTED
}

// ===========================================================================
// Subscriptions & entitlements
// ===========================================================================

model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  tier         PlanTier @unique
  name         String
  description  String
  /// Monthly price in INR. Null means custom/negotiated pricing.
  priceMonthly Decimal? @db.Decimal(12, 2)
  priceYearly  Decimal? @db.Decimal(12, 2)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  planFeatures  PlanFeature[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model FeatureDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())

  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  planId    String   @db.Uuid
  featureId String   @db.Uuid
  /// Optional numeric/structural limits for this feature on this plan.
  limits    Json?
  createdAt DateTime @default(now())

  plan    SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  planId         String             @db.Uuid
  status         SubscriptionStatus @default(TRIALING)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  cancelledAt    DateTime?
  /// Populated by the payment provider abstraction (mock locally).
  externalRef    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@unique([organizationId])
  @@index([status])
  @@index([planId])
  @@map("subscriptions")
}

// ===========================================================================
// Notifications
// ===========================================================================

model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @db.Uuid
  organizationId String?              @db.Uuid
  type           NotificationType
  title          String
  body           String
  priority       NotificationPriority @default(NORMAL)
  data           Json?
  /// Deep link the client opens when the notification is clicked.
  actionUrl      String?
  readAt         DateTime?
  createdAt      DateTime             @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel
  eventType NotificationType
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel, eventType])
  @@index([userId])
  @@map("notification_preferences")
}

/// Outbound delivery attempts made by the notification provider abstraction.
/// Locally this is the "inbox" that proves email/SMS would have been sent.
model NotificationDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  notificationId String?             @db.Uuid
  userId         String              @db.Uuid
  channel        NotificationChannel
  destination    String
  subject        String?
  body           String
  provider       String
  success        Boolean             @default(true)
  error          String?
  createdAt      DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([channel, createdAt])
  @@map("notification_deliveries")
}

// ===========================================================================
// Enums — verification, documents & fleet
// ===========================================================================

enum VerificationSubjectType {
  USER
  DRIVER
  TRUCK
  ORGANIZATION
}

enum DocumentOwnerType {
  USER
  DRIVER
  TRUCK
  ORGANIZATION
  ORDER
  TRIP
}

enum DocumentVerificationStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum TruckStatus {
  AVAILABLE
  ASSIGNED
  ON_TRIP
  LOADING
  UNLOADING
  IDLE
  MAINTENANCE
  OFFLINE
  EMERGENCY
  SUSPENDED
}

enum TruckType {
  OPEN_BODY
  CLOSED_CONTAINER
  TIPPER
  TRAILER
  TANKER
  FLATBED
  REFRIGERATED
  MINI_TRUCK
  MULTI_AXLE
  OTHER
}

enum FuelType {
  DIESEL
  PETROL
  CNG
  LNG
  ELECTRIC
  HYBRID
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum DriverAvailability {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  ON_LEAVE
  SUSPENDED
}

enum TrackingSource {
  MOCK
  DEVICE
  PROVIDER
  MANUAL
}

enum ScoreCategory {
  SAFETY
  RELIABILITY
  TIMELINESS
  COMPLIANCE
  VEHICLE_CARE
}

enum ScoreEventType {
  TRIP_COMPLETED_ON_TIME
  TRIP_COMPLETED_LATE
  TRIP_CANCELLED_BY_DRIVER
  SPEED_VIOLATION
  HARSH_BRAKING
  HARSH_ACCELERATION
  ROUTE_DEVIATION
  DOCUMENT_EXPIRED
  DOCUMENT_RENEWED
  CUSTOMER_POSITIVE_RATING
  CUSTOMER_NEGATIVE_RATING
  INCIDENT
  MAINTENANCE_REPORTED
  MAINTENANCE_NEGLECTED
  SOS_ASSISTANCE_PROVIDED
  MANUAL_ADJUSTMENT
  EXCESSIVE_IDLING
  TELEMETRY_SAFE_DRIVING
}

enum AchievementCode {
  SAFE_DRIVER
  ON_TIME_CHAMPION
  CENTURY_TRIPS
  ZERO_INCIDENT_STREAK
  DOCUMENT_PERFECT
  FUEL_EFFICIENT
  CUSTOMER_FAVOURITE
  EMERGENCY_HELPER
  FIRST_TRIP
  LONG_HAULER
}

enum ServiceCategory {
  ROUTINE
  ENGINE
  TRANSMISSION
  BRAKES
  SUSPENSION
  STEERING
  TYRES
  ELECTRICAL
  BODY
  HVAC
  FUEL_SYSTEM
  COOLING
  EXHAUST
  CHASSIS
  ACCIDENT_REPAIR
  OTHER
}

/// Where a service record came from.
enum ServiceDataSource {
  /// Entered by the fleet.
  MANUAL
  /// Bulk-loaded from a spreadsheet or a workshop export.
  IMPORT
  /// Pulled from a connected workshop or OEM service network.
  PROVIDER_SYNC
  /// Extracted from an invoice by AI. A draft until a human confirms it.
  DOCUMENT_EXTRACTION
  /// Derived from telemetry, e.g. a fault code cleared after a workshop visit.
  TELEMETRY_DERIVED
  SIMULATED
}

/// How far a service record has been checked.
///
/// Kept separate from FinanceVerificationStatus even though the members line
/// up: a service record and a loan statement are verified by different people
/// against different evidence, and merging them would couple two lifecycles
/// that have no reason to change together.
enum ServiceVerificationStatus {
  UNVERIFIED
  PROVIDER_REPORTED
  PENDING_REVIEW
  VERIFIED
  CONFLICT
  REJECTED
}

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  INSPECTION
  TYRE
  OIL_CHANGE
  BRAKE
  ENGINE
  ELECTRICAL
  BODYWORK
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ===========================================================================
// Verification workflow
// ===========================================================================

model VerificationCase {
  id              String                  @id @default(uuid()) @db.Uuid
  subjectType     VerificationSubjectType
  subjectId       String                  @db.Uuid
  organizationId  String?                 @db.Uuid
  status          VerificationStatus      @default(PENDING)
  submittedById   String?                 @db.Uuid
  submittedAt     DateTime?
  reviewedById    String?                 @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?
  reviewerNotes   String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  documents VerificationDocument[]
  events    VerificationEvent[]

  @@unique([subjectType, subjectId])
  @@index([status, createdAt])
  @@index([organizationId, status])
  @@map("verification_cases")
}

model VerificationDocument {
  id                 String   @id @default(uuid()) @db.Uuid
  verificationCaseId String   @db.Uuid
  documentId         String   @db.Uuid
  createdAt          DateTime @default(now())

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)
  document         Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([verificationCaseId, documentId])
  @@index([documentId])
  @@map("verification_documents")
}

model VerificationEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  verificationCaseId String             @db.Uuid
  status             VerificationStatus
  actorUserId        String?            @db.Uuid
  note               String?
  createdAt          DateTime           @default(now())

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)

  @@index([verificationCaseId, createdAt])
  @@map("verification_events")
}

// ===========================================================================
// Documents
// ===========================================================================

model Document {
  id                 String                     @id @default(uuid()) @db.Uuid
  ownerType          DocumentOwnerType
  ownerId            String                     @db.Uuid
  /// Tenant that owns the record — every read is scoped by this.
  organizationId     String?                    @db.Uuid
  documentType       String
  documentNumber     String?
  title              String?
  issueDate          DateTime?
  expiryDate         DateTime?
  storageKey         String
  fileName           String
  mimeType           String
  fileSize           Int
  checksum           String?
  verificationStatus DocumentVerificationStatus @default(PENDING_VERIFICATION)
  rejectionReason    String?
  verifiedById       String?                    @db.Uuid
  verifiedAt         DateTime?
  uploadedById       String                     @db.Uuid
  currentVersion     Int                        @default(1)
  deletedAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  versions              DocumentVersion[]
  verificationDocuments VerificationDocument[]

  @@index([ownerType, ownerId, deletedAt])
  @@index([organizationId, verificationStatus])
  @@index([expiryDate])
  @@index([documentType])
  @@map("documents")
}

model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  documentId    String   @db.Uuid
  versionNumber Int
  storageKey    String
  fileName      String
  mimeType      String
  fileSize      Int
  checksum      String?
  uploadedById  String   @db.Uuid
  note          String?
  createdAt     DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@map("document_versions")
}

// ===========================================================================
// Drivers
// ===========================================================================

model Driver {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @unique @db.Uuid
  organizationId        String             @db.Uuid
  licenseNumber         String
  licenseExpiryDate     DateTime?
  licenseClass          String?
  experienceYears       Int                @default(0)
  dateOfBirth           DateTime?
  bloodGroup            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  addressLine           String?
  city                  String?
  state                 String?
  postalCode            String?
  verificationStatus    VerificationStatus @default(PENDING)
  availability          DriverAvailability @default(AVAILABLE)
  currentTruckId        String?            @db.Uuid
  /// Denormalised for fast fleet listings; recomputed by the scoring service.
  overallScore          Int?
  totalTrips            Int                @default(0)
  totalDistanceKm       Float              @default(0)
  archivedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user             User                  @relation("DriverUser", fields: [userId], references: [id], onDelete: Cascade)
  assignments      TruckAssignment[]
  scores           DriverScore[]
  scoreEvents      DriverScoreEvent[]
  achievements     DriverAchievement[]
  terminalSessions TerminalSession[]     @relation("DriverTerminalSessions")
  terminalIssues   TerminalIssueReport[] @relation("DriverTerminalIssues")

  @@unique([organizationId, licenseNumber])
  @@index([organizationId, availability])
  @@index([organizationId, verificationStatus])
  @@index([currentTruckId])
  @@map("drivers")
}

model DriverScore {
  id               String   @id @default(uuid()) @db.Uuid
  driverId         String   @db.Uuid
  overallScore     Int
  safetyScore      Int
  reliabilityScore Int
  timelinessScore  Int
  complianceScore  Int
  vehicleCareScore Int
  calculatedAt     DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, calculatedAt])
  @@map("driver_scores")
}

model DriverScoreEvent {
  id          String         @id @default(uuid()) @db.Uuid
  driverId    String         @db.Uuid
  eventType   ScoreEventType
  category    ScoreCategory
  points      Int
  reason      String
  sourceType  String?
  sourceId    String?        @db.Uuid
  actorUserId String?        @db.Uuid
  createdAt   DateTime       @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@index([eventType])
  @@map("driver_score_events")
}

model DriverAchievement {
  id       String          @id @default(uuid()) @db.Uuid
  driverId String          @db.Uuid
  code     AchievementCode
  earnedAt DateTime        @default(now())
  /// Progress in the 0-1 range captured at evaluation time.
  progress Float           @default(1)
  metadata Json?

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, code])
  @@index([driverId])
  @@map("driver_achievements")
}

// ===========================================================================
// Trucks & tracking
// ===========================================================================

model Truck {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  registrationNumber String             @unique
  /// What kind of vehicle this row describes.
  ///
  /// The table is named `trucks` for history: Saarthi was truck-only, and
  /// renaming it would have been a destructive migration across ~120
  /// endpoints. Every pre-existing row is a TRUCK, and the generalized vehicle
  /// API reads and writes these same rows.
  vehicleType        VehicleType        @default(TRUCK)
  /// Goods-vehicle body type. Defaulted so passenger vehicles, which have no
  /// meaningful body type, can be created without inventing one.
  truckType          TruckType          @default(OTHER)
  manufacturer       String?
  model              String?
  year               Int?
  colour             String?
  /// Payload capacity in tonnes. Zero for vehicles that carry no freight.
  capacityTons       Float              @default(0)
  /// Seats, for vehicles that carry people. Null for goods vehicles.
  passengerCapacity  Int?
  airConditioned     Boolean?
  fuelType           FuelType           @default(DIESEL)
  /// Average consumption in litres per 100 km, used for cost estimates.
  fuelEfficiency     Float?
  odometerKm         Float              @default(0)
  /// The chassis number the vehicle's own ECU reports.
  ///
  /// Recorded the first time a terminal reads it, and compared on every
  /// connection afterwards. A mismatch means the adapter has been moved to a
  /// different vehicle — at which point every reading since is filed against
  /// the wrong truck, and nobody would otherwise notice.
  vin                String?
  status             TruckStatus        @default(AVAILABLE)
  verificationStatus VerificationStatus @default(PENDING)
  currentDriverId    String?            @db.Uuid
  currentTripId      String?            @db.Uuid
  /// Last known position, denormalised for fast fleet map loads.
  lastLatitude       Float?
  lastLongitude      Float?
  lastSpeedKph       Float?
  lastHeading        Float?
  lastLocationAt     DateTime?
  /// Owner-controlled: may this truck appear in nearby and SOS discovery?
  shareLocation      Boolean            @default(true)
  notes              String?

  // --- Physical dimensions, for city access rules -------------------------
  //
  // Nullable on purpose. A height rule against an unrecorded height cannot be
  // evaluated, and the access check says so rather than assuming a figure that
  // would either block a legal trip or wave through an illegal one.
  heightMetres Float?
  axleCount    Int?

  // --- Return loads -------------------------------------------------------
  /// Owner opt-out from backhaul matching.
  acceptsReturnLoads Boolean @default(true)
  /// Where this truck should end up when it is free.
  homeBaseAddress    String?
  homeBaseLatitude   Float?
  homeBaseLongitude  Float?

  // --- Last-mile relay ----------------------------------------------------
  /// This vehicle can take city relay legs from other fleets.
  lastMileCapable Boolean @default(false)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assignments         TruckAssignment[]
  locations           TruckLocation[]
  events              TruckEvent[]
  maintenance         MaintenanceRecord[]
  fuelRecords         FuelRecord[]
  deviceAssignments   DeviceAssignment[]    @relation("VehicleDeviceAssignments")
  devicePairingTokens DevicePairingToken[]  @relation("VehiclePairingTokens")
  telemetryReadings   TelemetryReading[]    @relation("VehicleTelemetry")
  telemetryAlerts     TelemetryAlert[]      @relation("VehicleTelemetryAlerts")
  travelPackages      TravelPackage[]       @relation("PackageVehicle")
  travelBookings      TravelBooking[]       @relation("BookingVehicle")
  /// Bids that offered this vehicle against a customer requirement.
  requirementBids     RequirementBid[]      @relation("BidVehicle")
  resaleListings      VehicleListing[]
  returnLoadRequests  ReturnLoadRequest[]
  loans               VehicleLoan[]
  fastagAccounts      FastagAccount[]
  tollTransactions    TollTransaction[]
  terminalSessions    TerminalSession[]     @relation("VehicleTerminalSessions")
  terminalIssues      TerminalIssueReport[] @relation("VehicleTerminalIssues")

  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([organizationId, vehicleType])
  @@index([currentDriverId])
  @@index([lastLocationAt])
  @@index([lastLatitude, lastLongitude])
  @@map("trucks")
}

model TruckAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  truckId        String           @db.Uuid
  driverId       String           @db.Uuid
  organizationId String           @db.Uuid
  status         AssignmentStatus @default(ACTIVE)
  assignedById   String?          @db.Uuid
  assignedAt     DateTime         @default(now())
  unassignedAt   DateTime?
  note           String?

  truck  Truck  @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([truckId, status])
  @@index([driverId, status])
  @@index([organizationId, assignedAt])
  @@map("truck_assignments")
}

/// High-volume append-only tracking table. Indexed for latest-position and
/// time-range replay queries.
model TruckLocation {
  id             String         @id @default(uuid()) @db.Uuid
  truckId        String         @db.Uuid
  organizationId String         @db.Uuid
  tripId         String?        @db.Uuid
  driverId       String?        @db.Uuid
  latitude       Float
  longitude      Float
  speedKph       Float          @default(0)
  heading        Float          @default(0)
  accuracy       Float?
  altitude       Float?
  source         TrackingSource @default(MOCK)
  /// True when produced by the local simulator — never conflated with real GPS.
  simulated      Boolean        @default(false)
  recordedAt     DateTime
  createdAt      DateTime       @default(now())

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId, recordedAt])
  @@index([tripId, recordedAt])
  @@index([organizationId, recordedAt])
  @@map("truck_locations")
}

model TruckEvent {
  id             String   @id @default(uuid()) @db.Uuid
  truckId        String   @db.Uuid
  organizationId String   @db.Uuid
  type           String
  description    String?
  metadata       Json?
  actorUserId    String?  @db.Uuid
  createdAt      DateTime @default(now())

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId, createdAt])
  @@index([organizationId, createdAt])
  @@map("truck_events")
}

// ===========================================================================
// Maintenance & fuel
// ===========================================================================

model MaintenanceRecord {
  id                String            @id @default(uuid()) @db.Uuid
  truckId           String            @db.Uuid
  organizationId    String            @db.Uuid
  type              MaintenanceType
  title             String
  description       String?
  odometerKm        Float?
  cost              Decimal?          @db.Decimal(12, 2)
  status            MaintenanceStatus @default(SCHEDULED)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  serviceProvider   String?
  /// Odometer reading at which the next service of this type falls due.
  nextDueOdometerKm Float?
  nextDueAt         DateTime?
  createdById       String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // --- Service history ----------------------------------------------------
  //
  // A completed job is a permanent part of the vehicle's history: it is what a
  // buyer, an insurer or a workshop asks for two years later. These columns are
  // all nullable because a record entered in ten seconds at the roadside is
  // still worth keeping — the alternative is an operator who records nothing.

  /// Engine hours at the time of service. The meaningful wear measure for a
  /// vehicle that idles more than it drives.
  engineHours     Float?
  category        ServiceCategory?
  /// Where the work was done, when it is not the named provider above.
  workshopName    String?
  workshopAddress String?
  workshopPhone   String?
  mechanicName    String?

  /// Cost split. `cost` above remains the total, so nothing that reads it today
  /// changes behaviour; these break it down when the invoice does.
  labourCost Decimal? @db.Decimal(12, 2)
  partsCost  Decimal? @db.Decimal(12, 2)
  taxAmount  Decimal? @db.Decimal(12, 2)

  invoiceNumber      String?
  /// Line items: name, part number, quantity, unit cost, warranty.
  parts              Json?
  /// Normalised component keys, for spotting a component replaced repeatedly.
  replacedComponents String[]
  /// Diagnostic trouble codes read or cleared during the visit.
  diagnosticCodes    String[]
  warrantyUntil      DateTime?

  source             ServiceDataSource         @default(MANUAL)
  verificationStatus ServiceVerificationStatus @default(UNVERIFIED)
  /// Which external network supplied the record, when it was not entered here.
  providerName       String?
  providerReference  String?
  retrievedAt        DateTime?
  /// Set when an external record disagrees with what the fleet recorded.
  conflictNote       String?

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId, status])
  @@index([organizationId, status, scheduledAt])
  @@index([nextDueAt])
  /// The service-history timeline reads by vehicle, newest completed first.
  @@index([truckId, completedAt])
  @@index([organizationId, verificationStatus])
  @@map("maintenance_records")
}

model FuelRecord {
  id             String   @id @default(uuid()) @db.Uuid
  truckId        String   @db.Uuid
  organizationId String   @db.Uuid
  tripId         String?  @db.Uuid
  driverId       String?  @db.Uuid
  quantityLitres Float
  pricePerUnit   Decimal  @db.Decimal(10, 2)
  totalCost      Decimal  @db.Decimal(12, 2)
  odometerKm     Float?
  stationName    String?
  latitude       Float?
  longitude      Float?
  recordedAt     DateTime @default(now())
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId, recordedAt])
  @@index([organizationId, recordedAt])
  @@index([tripId])
  @@map("fuel_records")
}

