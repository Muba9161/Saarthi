enum DeviceProvider {
  FREEMATICS
  /// YC06 four-channel mobile recorder. Video only — see the note on
  /// DeviceType.MULTI_CAMERA about why it is not treated as a GPS source.
  YC06
  /// An Android phone running the Saarthi Device app. Real GPS, camera and
  /// motion sensors; its engine block comes from an on-device simulator and is
  /// always stored with `simulated = true`.
  MOBILE
  MOCK
  GENERIC_GPS
  GENERIC_OBD
  GENERIC_CAN
}

enum DeviceType {
  OBD_TELEMATICS
  GPS_TRACKER
  CAN_LOGGER
  J1939_LOGGER
  DASHCAM
  /// A recorder with several camera channels, such as the YC06.
  ///
  /// Saarthi does not take position from one of these even when the unit has a
  /// GPS receiver. A vehicle with both a Freematics and a YC06 fitted has one
  /// designated telemetry source, and two devices reporting slightly different
  /// positions for the same truck is a support call nobody can resolve.
  MULTI_CAMERA
  /// A phone standing in for fitted hardware during testing.
  MOBILE_TEST_DEVICE
  /// A vehicle-mounted tablet or phone running Saarthi Terminal.
  ///
  /// Distinct from MOBILE_TEST_DEVICE because the two are different products
  /// with different lifecycles: a test phone is carried in and out of a cab by
  /// an engineer, while a terminal is fitted to one vehicle and stays there.
  /// The type is what lets a fleet see which is which, and what stops a
  /// pairing code issued for one being redeemed by the other.
  VEHICLE_TERMINAL
  OTHER
}

/// What a device *does* on a vehicle, as distinct from what it is.
///
/// One vehicle may carry a Freematics, a YC06 and a phone at once, but only one
/// of them may be the position source — two units reporting slightly different
/// positions for the same truck is a support call nobody can resolve. The role
/// is what reconciles those two requirements.
enum DeviceRole {
  /// The designated position and engine-data source. One per vehicle.
  TELEMETRY
  /// Video only. Contributes no position.
  CAMERA
  /// Sensors or diagnostics; neither position nor video.
  AUXILIARY
}

enum DeviceStatus {
  REGISTERED
  ACTIVE
  OFFLINE
  INACTIVE
  MAINTENANCE
  RETIRED
  SUSPENDED
}

enum DeviceAssignmentStatus {
