  RECOMMENDATION
  WARNING
  FORECAST
  EXPLANATION
  ACTION_SUGGESTION
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SimulationStatus {
  IDLE
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
}

// ===========================================================================
// SOS / emergency network
// ===========================================================================

model SosIncident {
  id             String    @id @default(uuid()) @db.Uuid
  reference      String    @unique
  organizationId String    @db.Uuid
  driverId       String?   @db.Uuid
  truckId        String?   @db.Uuid
  tripId         String?   @db.Uuid
  triggeredByUserId String @db.Uuid

  type        SosType
  status      SosStatus @default(TRIGGERED)
  latitude    Float
  longitude   Float
  address     String?
  description String?
  /// Current broadcast radius in metres; expands when nobody responds.
  searchRadiusMeters Int @default(5000)
  contactPhone String?

  acknowledgedAt DateTime?
  assignedAt     DateTime?
  arrivedAt      DateTime?
  resolvedAt     DateTime?
  resolvedByUserId String? @db.Uuid
  resolutionNote String?

  triggeredAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responders SosResponder[]
  events     SosEvent[]

  @@index([organizationId, status, triggeredAt])
  @@index([status, triggeredAt])
  @@index([driverId])
  @@index([tripId])
  @@map("sos_incidents")
}

model SosResponder {
  id             String             @id @default(uuid()) @db.Uuid
  incidentId     String             @db.Uuid
  truckId        String             @db.Uuid
  driverId       String             @db.Uuid
  organizationId String             @db.Uuid
  distanceKm     Float
  status         SosResponderStatus @default(NOTIFIED)
  notifiedAt     DateTime           @default(now())
  acknowledgedAt DateTime?
  declinedAt     DateTime?
  arrivedAt      DateTime?
  completedAt    DateTime?
  note           String?

  incident SosIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, truckId])
  @@index([incidentId, status])
  @@index([driverId, status])
  @@map("sos_responders")
}

model SosEvent {
  id          String       @id @default(uuid()) @db.Uuid
  incidentId  String       @db.Uuid
  eventType   SosEventType
  description String?
  actorUserId String?      @db.Uuid
  metadata    Json?
  createdAt   DateTime     @default(now())

  incident SosIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("sos_events")
}

// ===========================================================================
// Nearby services (local POI dataset; replaced by a map provider in production)
// ===========================================================================

model NearbyPlace {
  id          String         @id @default(uuid()) @db.Uuid
  /// Stable id from the source provider, used for idempotent imports.
  externalId  String?
  category    NearbyCategory
  name        String
  address     String?
  city        String?
  state       String?
  latitude    Float
  longitude   Float
  phone       String?
  /// Free-form provider attributes: opening hours, amenities, fuel brands.
  attributes  Json?
  rating      Float?
  open24Hours Boolean        @default(false)
  source      String         @default("local")
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([source, externalId])
  @@index([category, active])
  @@index([latitude, longitude])
  @@map("nearby_places")
}

// ===========================================================================
// AI
// ===========================================================================

model AiConversation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String?  @db.Uuid
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages AiMessage[]

  @@index([userId, updatedAt])
  @@index([organizationId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  role           AiMessageRole
  content        String
  /// Records which datasets the answer was grounded in, for transparency.
  contextSummary Json?
  provider       String?
  model          String?
  tokensUsed     Int?
  latencyMs      Int?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiInsight {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  type           AiInsightType
  category       String
  title          String
  body           String
  /// Records referenced by this insight, so the UI can deep-link to them.
  references     Json?
  severity       String        @default("info")
  /// Distinguishes a recorded fact from a calculation, prediction or advice.
  basis          String        @default("calculated")
  validUntil     DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, type, dismissedAt])
  @@map("ai_insights")
}

model AiUsage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String   @db.Uuid
  provider       String
  model          String
  operation      String
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  latencyMs      Int      @default(0)
  success        Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

// ===========================================================================
// GPS simulation (demo mode only — never enabled in production)
// ===========================================================================

model Simulation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  truckId        String           @db.Uuid
  tripId         String?          @db.Uuid
  status         SimulationStatus @default(IDLE)
  /// Route being driven as [{ latitude, longitude }, ...].
  route          Json
  routeDistanceKm Float           @default(0)
  /// Metres already covered along the route.
  progressMeters Float            @default(0)
  baseSpeedKph   Float            @default(45)
  speedMultiplier Float           @default(1)
  /// Injected behaviours: random stops, delays, deviation, connectivity loss.
  behaviours     Json?
  deviationActive Boolean         @default(false)
  startedAt      DateTime?
  pausedAt       DateTime?
  stoppedAt      DateTime?
  completedAt    DateTime?
  lastTickAt     DateTime?
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([truckId, status])
  @@index([status])
  @@map("simulations")
}
