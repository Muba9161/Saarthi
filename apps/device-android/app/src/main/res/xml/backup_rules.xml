<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up.

  The device secret and the buffered event queue are the two things this app
  stores, and neither should survive into a cloud backup: a restored secret
  would be a second phone authenticating as the same device, and a restored
  queue would replay somebody else's positions.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
