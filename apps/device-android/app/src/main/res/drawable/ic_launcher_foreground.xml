<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon foreground: the Saarthi brand mark.

  This replaces a steering wheel drawn for this app. The wheel read well, but it
  was the only place in the product that did not use the official mark, so the
  device app now shows the same VX monogram as the terminal app, the web
  sidebar and the favicon — `saarthi_mark.png`, the shared asset.

  Inset by 22dp on every side. An adaptive icon's 108dp canvas is masked down to
  a 66dp safe zone, and a mark drawn to the edges is a mark the launcher crops.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/saarthi_mark"
    android:insetLeft="22dp"
    android:insetTop="22dp"
    android:insetRight="22dp"
    android:insetBottom="22dp" />
