<?xml version="1.0" encoding="utf-8"?>
<!--
  Saarthi for drivers.

  Permissions, features and the reporting service all come from `:core`. What is
  declared here is only what makes this a driver's own phone rather than a
  fitted tablet — an ordinary launcher entry, and nothing else.

  Note what is absent. There is no HOME category, so this app can never become a
  launcher; and no device-admin receiver, so it can never be made a device owner.
  A driver's personal handset must not be capable of being locked into kiosk
  mode by an app they installed themselves, and the surest guarantee of that is
  for the declarations not to exist in this build at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SaarthiDriverApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaarthiTerminal"
        tools:targetApi="35">

        <!--
          Android Auto.

          A second interface to the running app, never a second app: the car
          screens read the same repositories, telemetry and session the phone
          uses. The phone keeps the Bluetooth link to the OBD adapter, the
          foreground service and the outbox — a head unit cannot pair to an
          ELM327, and telemetry must not stop when the car screen closes.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".car.SaarthiCarAppService"
            android:exported="true"
            android:foregroundServiceType="location">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!--
                  Navigation, because that is what a driver opens Saarthi for.
                  The category decides which templates the host will render and
                  is reviewed by Google before an app can be distributed — see
                  the note in the implementation report about what that means
                  for release.
                -->
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <activity
            android:name=".DriverActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SaarthiTerminal"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
