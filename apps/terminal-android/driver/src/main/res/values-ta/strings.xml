    <string name="register_account_title">இமெயில் மற்றும் பாஸ்வேர்டு</string>
    <string name="register_account_lead">இவற்றைக் கொண்டு ஒருமுறை உள்நுழைவீர்கள். அதன் பிறகு குயிக் லாகின் பார்த்துக்கொள்ளும்.</string>
    <string name="register_fleet_title">ஃப்ளீட்டில் சேருகிறீர்களா?</string>
    <string name="register_fleet_lead">உங்கள் ஃப்ளீட்டின் சேரும் குறியீட்டை உள்ளிடுங்கள், அதன் வண்டிகள் உடனே உங்களுக்குத் திறக்கும்.</string>
    <string name="field_joining_code">சேரும் குறியீடு</string>
    <string name="register_fleet_note">உங்கள் ஃப்ளீட் உரிமையாளர் Saarthi-இல் உள்ள டிரைவர்கள் பக்கத்தில் குறியீட்டைக் காணலாம். இன்னும் குறியீடு இல்லையா? இதைத் தவிர்க்கவும் - பிறகு வண்டி திரையிலிருந்து சேரலாம்.</string>
