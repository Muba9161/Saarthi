    <string name="trip_under_way">ट्रिप चल रही है</string>
    <string name="trip_under_way_blurb">सारथी इस गाड़ी की रिपोर्ट भेज रहा है। नक़्शा और इंजन देखने के लिए लाइव व्यू खोलें।</string>
    <string name="before_you_drive">चलने से पहले</string>
    <string name="before_you_drive_blurb">गाड़ी की छोटी सेफ़्टी जाँच। ट्रिप शुरू होने से पहले आपके फ़्लीट को इसका रिकॉर्ड चाहिए।</string>
