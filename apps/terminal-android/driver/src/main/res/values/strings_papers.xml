    <string name="papers_no_expiry">No expiry recorded</string>
    <string name="papers_expires_today">Expires today</string>
    <plurals name="papers_days_left">
        <item quantity="one">%d day left</item>
        <item quantity="other">%d days left</item>
    </plurals>
    <plurals name="papers_years_left">
        <item quantity="one">%d year left</item>
        <item quantity="other">%d years left</item>
    </plurals>
    <plurals name="papers_expired_ago">
        <item quantity="one">Expired %d day ago</item>
        <item quantity="other">Expired %d days ago</item>
