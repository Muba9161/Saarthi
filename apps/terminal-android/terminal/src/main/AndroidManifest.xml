<?xml version="1.0" encoding="utf-8"?>
<!--
  The Saarthi Terminal: a tablet fitted to a vehicle.

  Shared permissions, features and the reporting service come from `:core`.
  What is declared here is only what makes this a fitted terminal rather than a
  driver's phone — a launcher that can also be the home screen, and the
  device-owner receiver that a provisioned dedicated device needs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SaarthiTerminalApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaarthiTerminal"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SaarthiTerminal"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              HOME, so a dedicated-device deployment can make Saarthi the
              launcher (section 45). This is only *offered*: on an ordinary
              tablet Android asks the user which launcher to use and they can
              say no, and on a provisioned dedicated device the device-owner
              policy sets it without a prompt. Nothing here seizes the home
              button — that would be the kind of unsafe hack section 45 rules
              out.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>



        <!--
          Device-owner policy, for a provisioned dedicated device.

          Declaring the receiver is what lets an EMM or `dpm set-device-owner`
          make Saarthi the device owner; without it, lock-task mode and the
          restrictions in section 45 are simply unavailable and the app runs as
          an ordinary application. It grants nothing on its own.
        -->
        <receiver
            android:name=".kiosk.TerminalDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
