<!--
  The vehicle on the map: a car.

  A puck, not a plan view. The previous markers drew the vehicle from above in
  flat blue, which at the size a marker actually occupies read as a blue
  lozenge — a shape with no clear front, sitting on the map like a smudge. Three
  things fixed that, and all three are the reason this shape is standard in
  every navigation app:

    * **A white ring.** The one detail that keeps a marker legible on any
      basemap. Saarthi draws a light map on the fitted tablet and a dark one on
      a driver's phone, and a marker that works on one and vanishes on the other
      is half a marker.
    * **A nose.** Heading is the whole point of rotating the icon, and a
      pointed end states it in a glance where a symmetrical rectangle could not.
    * **One accent.** Ember, the colour every action in the driver app already
      uses, so the vehicle reads as *yours* against the traffic and labels of a
      basemap nobody controls.

  The silhouette inside still says which vehicle it is — a lorry for a lorry —
  because a fleet with mixed vehicles on one map needs to tell them apart.

  Nose towards the top of the viewport, so a rotation of 0° means "facing north"
  with no offset to remember.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="44dp"
    android:height="44dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- The glow, so the marker holds its own over a busy basemap. -->
    <path
        android:fillColor="#F26522"
        android:fillAlpha="0.16"
        android:pathData="M2,26 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 z" />
    <!-- The nose, drawn under the ring so the two read as one shape. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,2 L33,18 L15,18 Z" />
    <!-- The ring. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M8,26 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 z" />
    <!-- The body. -->
    <path
        android:fillColor="#F26522"
        android:pathData="M11.5,26 a12.5,12.5 0 1,0 25,0 a12.5,12.5 0 1,0 -25,0 z" />
    <!-- Tapered at the nose, which is what separates a car from a van here. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,18 c3.2,0 5.5,1.6 5.5,4 v9 a2.5,2.5 0 0 1 -2.5,2.5 h-6 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 c0,-2.4 2.3,-4 5.5,-4 z" />
    <path
        android:fillColor="#F26522"
        android:pathData="M20.5,22.5 h7 v3.5 h-7 z" />
</vector>
