<!--
  The vehicle marker for a lorry, seen from above.

  Drawn plan-view rather than in profile because it is rotated to the vehicle's
  heading on a map: a side-on lorry pointing north would be a lorry lying on its
  side. Nose towards the top of the viewport, so a rotation of 0° means "facing
  north" with no offset to remember.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="44dp"
    android:height="44dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- Trailer -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15,20 h18 a2,2 0 0 1 2,2 v18 a2,2 0 0 1 -2,2 h-18 a2,2 0 0 1 -2,-2 v-18 a2,2 0 0 1 2,-2 z" />
    <path
        android:fillColor="#2B41B8"
        android:pathData="M16.5,21.5 h15 a1,1 0 0 1 1,1 v17 a1,1 0 0 1 -1,1 h-15 a1,1 0 0 1 -1,-1 v-17 a1,1 0 0 1 1,-1 z" />
    <!-- Cab -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M16,6 h16 a3,3 0 0 1 3,3 v10 a2,2 0 0 1 -2,2 h-18 a2,2 0 0 1 -2,-2 v-10 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#2B41B8"
        android:pathData="M17.5,7.5 h13 a2,2 0 0 1 2,2 v9 h-17 v-9 a2,2 0 0 1 2,-2 z" />
    <!-- Windscreen, so the nose is unmistakable -->
    <path
        android:fillColor="#7A93FA"
        android:pathData="M19,9.5 h10 a1,1 0 0 1 1,1 v3 h-12 v-3 a1,1 0 0 1 1,-1 z" />
</vector>
