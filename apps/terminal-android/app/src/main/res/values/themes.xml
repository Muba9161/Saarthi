<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A dark splash, because the app itself is dark by default.
      A tablet in a cab at night flashing a white screen on launch is
      genuinely dazzling, and the whole point of the splash is to be brief.
    -->
    <style name="Theme.SaarthiTerminal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
